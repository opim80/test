local CacheDisplay = nil

-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function updateCacheUI(msg)
    if CacheDisplay then
        local pCount = 0
        local qCount = 0
        for _ in pairs(GlobalCache.Portals) do pCount = pCount + 1 end
        for _ in pairs(GlobalCache.Quests) do qCount = qCount + 1 end
        
        CacheDisplay:SetDesc(
            "📍 Portals Mapped: " .. pCount .. " / " .. #IslandsList .. "\n" ..
            "📜 Quests Mapped: " .. qCount .. "\n\n" ..
            "🔄 Current Action: " .. msg
        )
    end
end

local function TweenTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local dist = (hrp.Position - targetPos).Magnitude
    if dist < 3 then return end -- Already there
    
    local tweenTime = dist / backupTweenSpeed
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    getgenv().ActiveTween = tween
    
    -- PHYSICS FIX: Stepped runs directly before the physics calculation step. 
    -- Forcing velocity to 0 here perfectly neutralizes gravity and flinging without anchoring.
    getgenv().VelConn = RunService.Stepped:Connect(function()
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    
    tween:Play()
    tween.Completed:Wait()
    
    if getgenv().VelConn then
        getgenv().VelConn:Disconnect()
        getgenv().VelConn = nil
    end
    
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    
    getgenv().ActiveTween = nil
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    
    if tool and humanoid and tool.Parent ~= char then 
        humanoid:EquipTool(tool) 
    end
end

local function ParseShortenedNumber(str)
    str = string.lower(tostring(str))
    local num = tonumber(string.match(str, "[%d%.]+")) or 0
    if string.find(str, "k") then num = num * 1000
    elseif string.find(str, "m") then num = num * 1000000
    elseif string.find(str, "b") then num = num * 1000000000 end
    return num
end

-- Used ONLY during the initial reset to find the spawn portal safely
local function FindNearestPortalSafe(maxDist)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local closestPortal = nil
    local closestDist = maxDist or 2000

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            if string.find(string.lower(obj.Name), "portal_") then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (hrp.Position - pos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPortal = obj
                end
            end
        end
    end
    return closestPortal
end

-- SMART ROUTING FIX: 100% Logic based, no arbitrary distance math
local function SmartTravelTo(targetPos, targetIsland)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 1. Find the portal we are physically closest to right now
    local closestPortalToPlayer = nil
    local closestDist = math.huge
    for islandName, portalPos in pairs(GlobalCache.Portals) do
        local dist = (hrp.Position - portalPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closestPortalToPlayer = islandName
        end
    end

    -- 2. If we are closest to Dooky, but the NPC is on Stinky, we tween to Dooky and teleport to Stinky.
    if targetIsland and closestPortalToPlayer ~= targetIsland then
        updateStatus("SmartTravel: Taking Portal -> " .. targetIsland)
        
        -- Tween to our local closest portal
        TweenTo(GlobalCache.Portals[closestPortalToPlayer])
        
        -- Teleport
        local args = { targetIsland }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        task.wait(3.5)
    else
        updateStatus("SmartTravel: Target is on current island. Tweening.")
    end

    -- 3. Finish the journey
    TweenTo(targetPos)
end

-- [[ CORE KAITUN & CACHE LOGIC ]]
local function InitializeWorldCache()
    if GlobalCache.Initialized then return end
    updateStatus("Starting World Cache Initialization...")

    -- The Initial Failsafe Reset
    updateCacheUI("Resetting to clear render distance locks...")
    LocalPlayer.Character:BreakJoints()
    LocalPlayer.CharacterAdded:Wait()
    task.wait(2.5) -- Wait for world to stream in
    
    -- Get safely onto the initial spawn portal
    local initPortal = FindNearestPortalSafe(1500)
    if initPortal then 
        local pos = initPortal:IsA("Model") and initPortal:GetPivot().Position or initPortal.Position
        TweenTo(pos) 
    end

    -- Strict Portal-To-Portal Harvesting Loop
    for _, island in ipairs(IslandsList) do
        updateCacheUI("Teleporting to Island: " .. island)

        -- Teleport
        local args = { island }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        task.wait(3.5)

        -- LOGIC FIX: We just arrived. Our current position IS the exact portal. No need to search workspace!
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        GlobalCache.Portals[island] = hrp.Position

        -- Scan for Quests ON THIS ISLAND
        local serviceNPCs = workspace:FindFirstChild("ServiceNPCs")
        if serviceNPCs then
            local localQuests = {}

            -- Gather all valid quests near this portal (< 8k studs)
            for _, npc in ipairs(serviceNPCs:GetChildren()) do
                local numStr = string.match(npc.Name, "^QuestNPC(%d+)$")
                if numStr and not GlobalCache.Quests[npc.Name] then
                    local dist = (hrp.Position - npc:GetPivot().Position).Magnitude
                    if dist < 8000 then 
                        table.insert(localQuests, { Instance = npc, Number = tonumber(numStr) })
                    end
                end
            end

            -- Sort numerically
            table.sort(localQuests, function(a, b) return a.Number < b.Number end)

            for _, qData in ipairs(localQuests) do
                local npc = qData.Instance
                local questPos = npc:GetPivot().Position
                
                updateCacheUI("Harvesting Data from: " .. npc.Name)
                TweenTo(questPos)
                task.wait(0.5)
                
                -- Accept
                ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npc.Name)
                task.wait(1) 

                -- Extract Data exactly as requested
                local expText = "0"
                local reqText = ""
                local qPrompt = nil
                
                pcall(function()
                    expText = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Reward.RewardExp.CurrencyIndicator.Text
                    reqText = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text
                    local targHrp = npc:FindFirstChild("HumanoidRootPart")
                    if targHrp then qPrompt = targHrp:FindFirstChild("QuestPrompt") end
                end)

                local targetName = string.match(reqText, "Defeat%s+(.*)s?%!") or reqText
                local requiredAmount = tonumber(string.match(reqText, "(%d+)")) or 1

                GlobalCache.Quests[npc.Name] = {
                    Island = island,
                    Target = targetName,
                    Amount = requiredAmount,
                    Exp = ParseShortenedNumber(expText),
                    Position = questPos,
                    Prompt = qPrompt
                }

                -- Abandon
                local abandonArgs = { "repeatable" }
                game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(abandonArgs))
                task.wait(0.5)
            end
        end
        
        -- LOGIC FIX: Tween BACK to this island's portal before looping to the next teleport
        updateCacheUI("Returning to portal to prepare for next island...")
        TweenTo(GlobalCache.Portals[island])
        task.wait(0.5)
    end

    -- DPS Test
    updateCacheUI("Calculating M1 Damage Baseline...")
    pcall(function()
        GlobalCache.M1Damage = tonumber(game:GetService("Players")[LocalPlayer.Name].PlayerGui.DamageCounterUI.DamageFrame.Holder.StatFrame.DamageLabel.Text) or 1
    end)
    
    if GlobalCache.M1Damage <= 1 then GlobalCache.M1Damage = 500 end 

    GlobalCache.Initialized = true
    updateCacheUI("Cache Complete! Ready for Kaitun.")
    updateStatus("Initialization Finished.")
end

local function GetMostEfficientQuest()
    local bestQuest = nil
    local highestExpPerSec = 0

    for npcName, data in pairs(GlobalCache.Quests) do
        local mobHP = 5000 -- Placeholder, scales roughly
        local timeToKillOne = (mobHP / GlobalCache.M1Damage) * 0.4
        local totalTTK = timeToKillOne * data.Amount
        
        local expPerSec = data.Exp / (totalTTK + 1)

        if expPerSec > highestExpPerSec then
            highestExpPerSec = expPerSec
            bestQuest = npcName
        end
    end
    return bestQuest
end

-- [[ KILLAURA / KAITUN LOOP ]]
local function startMasterLoop()
    if getgenv().auraTask then task.cancel(getgenv().auraTask); getgenv().auraTask = nil end

    getgenv().auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")

        while killAuraActive or kaitunActive do
            if kaitunActive and not GlobalCache.Initialized then
                InitializeWorldCache()
            end

            equipWeapon(selectedWeapon)
            local currentTarget = nil
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero
            local npcFolder = workspace:FindFirstChild("NPCs")

            -- 1. Priority: Boss Check
            if killAllTimedBosses and npcFolder then
                local closestBoss = nil
                local closestDist = math.huge
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    if string.find(string.lower(npc.Name), "boss_") then
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            local dist = (charPos - npc:GetPivot().Position).Magnitude
                            if dist < closestDist then
                                closestBoss = npc
                                closestDist = dist
                            end
                        end
                    end
                end
                currentTarget = closestBoss
            end

            -- 2. Kaitun / Normal Targeting
            if not currentTarget and npcFolder then
                if kaitunActive then
                    local bestQuestId = GetMostEfficientQuest()
                    if bestQuestId then
                        local questData = GlobalCache.Quests[bestQuestId]
                        
                        local hasQuest = false
                        pcall(function()
                            hasQuest = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Visible
                        end)

                        if not hasQuest then
                            updateStatus("Kaitun: Traveling to " .. bestQuestId)
                            
                            -- Use the logical Smart Travel system
                            SmartTravelTo(questData.Position, questData.Island)
                            
                            ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(bestQuestId)
                            task.wait(1.5)
                        end

                        -- Find the required mob
                        local closestMobDist = math.huge
                        for _, npc in ipairs(npcFolder:GetChildren()) do
                            local hum = npc:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 and string.find(string.lower(npc.Name), string.lower(questData.Target)) then
                                local dist = (charPos - npc:GetPivot().Position).Magnitude
                                if dist < closestMobDist then
                                    closestMobDist = dist
                                    currentTarget = npc
                                end
                            end
                        end
                    end
                else
                    -- Standard KillAura fallback
                    for _, npc in ipairs(npcFolder:GetChildren()) do
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            currentTarget = npc
                            break
                        end
                    end
                end
            end

            -- Combat Execution
            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                local targetPart = getTargetPart(currentTarget)

                if targetPart and hum and hum.Health > 0 then
                    updateStatus("Engaging: " .. currentTarget.Name)
                    
                    local targetIsland = GlobalCache.Quests[GetMostEfficientQuest()] and GlobalCache.Quests[GetMostEfficientQuest()].Island
                    SmartTravelTo(targetPart.Position + Vector3.new(0, 0, 3), kaitunActive and targetIsland or nil) 

                    while currentTarget and currentTarget.Parent and hum.Health > 0 and (killAuraActive or kaitunActive) do
                        if killAllTimedBosses and not string.find(string.lower(currentTarget.Name), "boss_") then
                            local newBossFound = false
                            for _, n in ipairs(npcFolder:GetChildren()) do
                                if string.find(string.lower(n.Name), "boss_") and n:FindFirstChild("Humanoid") and n.Humanoid.Health > 0 then
                                    newBossFound = true
                                    break
                                end
                            end
                            if newBossFound then break end 
                        end

                        local tPos = targetPart.Position
                        local success, err = pcall(function() 
                            local args = {}
                            if vectorMethod == "vector.create(X, Y, Z)" then
                                args = { vector.create(tPos.X, tPos.Y, tPos.Z) }
                            elseif vectorMethod == "Vector3.new" then
                                args = { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
                            else
                                args = { tPos }
                            end
                            remote:FireServer(unpack(args)) 
                        end)

                        task.wait(0.35)
                    end
                end
            else
                task.wait(0.5) 
            end
        end
    end)
end

local function stopMasterLoop()
    killAuraActive = false
    kaitunActive = false
    updateStatus("Farming Stopped.")
    if getgenv().auraTask then task.cancel(getgenv().auraTask); getgenv().auraTask = nil end
    if getgenv().ActiveTween then getgenv().ActiveTween:Cancel() end
end

