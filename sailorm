-- [[ STATE & CACHE VARIABLES ]]
local killAuraActive = false
local kaitunActive = false
local killAllTimedBosses = true
local selectedWeapon = ""
local vectorMethod = "vector.create(X, Y, Z)" 
local backupTweenSpeed = 65 

local GlobalCache = {
    Initialized = false,
    Portals = {}, -- [IslandName] = Vector3
    Quests = {},  -- [QuestName] = { Island = string, Target = string, Amount = number, Exp = number, Position = Vector3, Prompt = Instance }
    M1Damage = 1
}

