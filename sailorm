    "Starter", "Jungle", "Desert", "Snow", "Sailor", "Shibuya", 
    "Hollow", "Boss", "Dungeon", "Shinjuku", "Slime", "Academy", 
    "Judgement", "Ninja", "Lawless", "Tower"
}

