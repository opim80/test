getgenv().CSMDH_Cleanup = function()
    if getgenv().auraTask then task.cancel(getgenv().auraTask) end
    if getgenv().ActiveTween then 
        getgenv().ActiveTween:Cancel() 
        getgenv().ActiveTween = nil 
    end
    if getgenv().VelConn then
        getgenv().VelConn:Disconnect()
        getgenv().VelConn = nil
    end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    
    if getgenv().CSMDH_Window then
        pcall(function() getgenv().CSMDH_Window:Destroy() end)
    end
end

if not game:IsLoaded() then game.Loaded:Wait() end
repeat task.wait() until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

