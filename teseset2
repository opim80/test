-- Targeted Spy Wrapper
-- Only intercepts high-value exploit functions to avoid making 11k files from obfuscator loops

local HttpService = game:GetService("HttpService")

local function write_log(name, content)
    -- Use a single file and append to it, or use unique names with a limit
    local filename = "spy_log_" .. name .. ".txt"
    if isfile(filename) then
        appendfile(filename, "\n\n--- NEW INTERCEPT ---\n\n" .. tostring(content))
    else
        writefile(filename, tostring(content))
    end
end

