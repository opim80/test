if request then
    local old_request
    old_request = hookfunction(request, function(req_tbl)
        if type(req_tbl) == "table" then
            print("[SPY] Intercepted request to: " .. tostring(req_tbl.Url))
            write_log("requests", HttpService:JSONEncode(req_tbl))
        end
        return old_request(req_tbl)
