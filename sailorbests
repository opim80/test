end

local function getBaseName(name)
    return string.gsub(name, "[_%s%d]+$", "")
end

local function ParseNumber(str)
    if not str then return 0 end
    str = string.gsub(tostring(str), ",", "")
    local mult = 1
    if string.find(str:upper(), "K") then mult = 1000 end
    if string.find(str:upper(), "M") then mult = 1000000 end
    if string.find(str:upper(), "B") then mult = 1000000000 end
    return (tonumber(string.match(str, "[%d%.]+")) or 0) * mult
end

local function FormatAbbreviation(num)
    if num >= 1e9 then return string.format("%.2fB", num / 1e9) end
    if num >= 1e6 then return string.format("%.2fM", num / 1e6) end
    if num >= 1e3 then return string.format("%.2fK", num / 1e3) end
    return tostring(math.floor(num))
end

local function GetRawPlayerDamage()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return 0 end
    local ui = gui:FindFirstChild("DamageCounterUI")
    if ui then
        local lbl = ui:FindFirstChild("DamageFrame") and 
                    ui.DamageFrame:FindFirstChild("Holder") and 
                    ui.DamageFrame.Holder:FindFirstChild("StatFrame") and 
                    ui.DamageFrame.Holder.StatFrame:FindFirstChild("DamageLabel")
        if lbl and lbl.Text then return ParseNumber(lbl.Text) end
    end
    return 0
end

local function GetPityAmount()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local pityText = gui and gui:FindFirstChild("BossUI") and gui.BossUI:FindFirstChild("MainFrame") and gui.BossUI.MainFrame:FindFirstChild("BossHPBar") and gui.BossUI.MainFrame.BossHPBar:FindFirstChild("Pity")
    if pityText and pityText.Text then
        local matched = string.match(pityText.Text, "%d+")
        return tonumber(matched) or 0
    end
    return 0
end

local function getTargetOffset()
