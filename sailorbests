-- [[ FIRE HIT REMOTE WRAPPER ]]
local function FireHitRemote(tPos)
    local args = {}
    if vectorMethod == "vector.create(X, Y, Z)" then args = { vector.create(tPos.X, tPos.Y, tPos.Z) }
    elseif vectorMethod == "Vector3.new" then args = { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
    elseif vectorMethod == "Raw Vector3" then args = { tPos }
    else args = { vector.create(tPos) } end
    pcall(function() ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit"):FireServer(unpack(args)) end)
end

