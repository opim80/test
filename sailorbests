-- [[ MOVEMENT & TWEEN LOGIC ]]
local function EnableNoclip()
    if NoclipConn then return end
    NoclipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
            end
        end
    end)
end

local function DisableNoclip()
    if NoclipConn then NoclipConn:Disconnect(); NoclipConn = nil end
end

local function GetClosestPortal(pos)
    local bestPortal = nil
    local bestDist = math.huge
    for name, p in pairs(Portals) do
        local d = (pos - p).Magnitude
        if d < bestDist then
            bestDist = d
            bestPortal = name
        end
    end
    return bestPortal
end

local function TweenToSync(targetPos)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if activeTween then activeTween:Cancel() end
    EnableNoclip()

    local dist = (hrp.Position - targetPos).Magnitude
    local ti = TweenInfo.new(dist / backupTweenSpeed, Enum.EasingStyle.Linear)
    activeTween = TweenService:Create(hrp, ti, {CFrame = CFrame.new(targetPos)})
    activeTweenTarget = targetPos
    activeTween:Play()
    activeTween.Completed:Wait()
    DisableNoclip()
end

local function TweenToAsync(targetPos)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if activeTween and activeTweenTarget and (activeTweenTarget - targetPos).Magnitude < 5 then
        return
    end

    if activeTween then activeTween:Cancel() end
    EnableNoclip()

    local dist = (hrp.Position - targetPos).Magnitude
    local ti = TweenInfo.new(dist / backupTweenSpeed, Enum.EasingStyle.Linear)
    activeTween = TweenService:Create(hrp, ti, {CFrame = CFrame.new(targetPos)})
    activeTweenTarget = targetPos
    activeTween:Play()
end

local function SmartTraverse(targetPos)
    isTraversing = true
    updateStatus("Quick Traversal: Resetting character...")
    LocalPlayer.Character:BreakJoints()

    LocalPlayer.CharacterAdded:Wait()
    local char = LocalPlayer.Character
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    task.wait(1.5)

    if hrp then
        local startPortal = GetClosestPortal(hrp.Position)
        local endPortal = GetClosestPortal(targetPos)

        updateStatus("Quick Traversal: Tweening to Start Portal (" .. startPortal .. ")")
        TweenToSync(Portals[startPortal] + Vector3.new(0, 3, 0))
        task.wait(0.5)

        updateStatus("Quick Traversal: Teleporting to " .. endPortal)
        local args = { endPortal }
        pcall(function() game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args)) end)
        task.wait(4.5)

        hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            updateStatus("Quick Traversal: Tweening to final destination...")
            TweenToSync(targetPos)
        end
    end
    isTraversing = false
end

