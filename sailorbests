-- [[ AUTO SPECIFIC QUEST ]]
local function StartSpecificQuest(questName)
    if specificQuestTask then task.cancel(specificQuestTask) end
    
    local targetQ = nil
    for _, q in ipairs(HardcodedQuests) do
        if q.NPC == questName then targetQ = q; break end
    end
    if not targetQ then return end

    specificQuestTask = task.spawn(function()
        while specificQuestActive do
            if isTraversing then task.wait(0.5); continue end
            
            updateStatus("Specific Quest: Pathing to " .. targetQ.NPC)
            FireAbandonQuest()
            task.wait(0.5)

            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local questPos = targetQ.Pos + Vector3.new(0, 5, 0)
                if (hrp.Position - questPos).Magnitude > 2500 then SmartTraverse(questPos) else TweenToSync(questPos) end
            end

            FireAcceptQuest(targetQ.Index)
            task.wait(1.5)

            while specificQuestActive and not isTraversing do
                local npcFolder = workspace:FindFirstChild("NPCs")
                local targetMob = nil
                
                if npcFolder then
                    for _, npc in ipairs(npcFolder:GetChildren()) do
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 and (string.find(string.lower(npc.Name), string.lower(targetQ.NPC))) then
                            targetMob = npc
                            break
                        end
                    end
                end

                if targetMob then
                    local targetPart = getTargetPart(targetMob)
                    if targetPart then
                        local hrp2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp2 then
                            local combatPos = targetPart.Position + getTargetOffset()
                            if (hrp2.Position - combatPos).Magnitude > 2500 then
                                task.spawn(function() SmartTraverse(combatPos) end)
                                task.wait(1)
                                break
                            elseif (hrp2.Position - combatPos).Magnitude > 15 then
                                TweenToAsync(combatPos)
                            else
                                if activeTween then activeTween:Cancel(); activeTween = nil end
                                DisableNoclip()
                                hrp2.CFrame = CFrame.new(combatPos)
                                if not autoCycleActive then equipWeapon(selectedWeapon) end
                                FireHitRemote(targetPart.Position)
                                updateStatus("Specific Quest: Farming " .. targetQ.NPC .. " | HP: " .. math.floor(targetMob.Humanoid.Health))
                            end
                        end
                    end
                else
                    break -- Mob dead or despawned, fetch quest again
                end
                task.wait(0.25)
            end
            task.wait(0.25)
        end
    end)
end

-- [[ PITY BOSS FARMING ]]
local function StartPityFarming(targetBoss, builderBoss)
    if pityFarmingTask then task.cancel(pityFarmingTask) end
    
    pityFarmingTask = task.spawn(function()
        while pityFarmingActive do
            if isTraversing then task.wait(0.5); continue end
            local currentPity = GetPityAmount()

            if currentPity < 24 then
                updateStatus("Pity Farm: Building Pity (" .. currentPity .. "/24) -> " .. builderBoss)
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local spawnerPos = Vector3.new(652, -4, -1019)
                    if (hrp.Position - spawnerPos).Magnitude > 2500 then SmartTraverse(spawnerPos) else TweenToSync(spawnerPos + Vector3.new(0,5,0)) end
                end

                pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RequestSummonBoss"):FireServer(builderBoss) end)
                task.wait(2)
                
                -- Farm the builder boss until dead
                while pityFarmingActive and not isTraversing and GetPityAmount() == currentPity do
                    local targetMob = nil
                    for _, npc in ipairs(workspace:FindFirstChild("NPCs"):GetChildren()) do
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 and string.find(string.lower(npc.Name), string.lower(builderBoss)) then
                            targetMob = npc; break
                        end
                    end

                    if targetMob then
                        local targetPart = getTargetPart(targetMob)
                        if targetPart then
                            local combatPos = targetPart.Position + getTargetOffset()
                            local hrp2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hrp2 then
                                if (hrp2.Position - combatPos).Magnitude > 2500 then SmartTraverse(combatPos); break
                                elseif (hrp2.Position - combatPos).Magnitude > 15 then TweenToAsync(combatPos)
                                else
                                    if activeTween then activeTween:Cancel(); activeTween = nil end
                                    DisableNoclip()
                                    hrp2.CFrame = CFrame.new(combatPos)
                                    if not autoCycleActive then equipWeapon(selectedWeapon) end
                                    FireHitRemote(targetPart.Position)
                                end
                            end
                        end
                    else
                        break -- Dead, loop restarts to check pity
                    end
                    task.wait(0.25)
                end

