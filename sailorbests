                end
                task.wait(2)

                while pityFarmingActive and not isTraversing and GetPityAmount() == 24 do
                    local targetMob = nil
                    for _, npc in ipairs(workspace:FindFirstChild("NPCs"):GetChildren()) do
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 and string.find(string.lower(npc.Name), string.lower(targetBoss)) then
                            targetMob = npc; break
