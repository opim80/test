                                    if activeTween then activeTween:Cancel(); activeTween = nil end
                                    DisableNoclip()
                                    hrp2.CFrame = CFrame.new(combatPos)
                                    if not autoCycleActive then equipWeapon(selectedWeapon) end
                                    FireHitRemote(targetPart.Position)
                                end
                            end
                        end
                    else
                        updateStatus("Pity Farm: Waiting for " .. targetBoss .. " to exist in Workspace...")
                    end
                    task.wait(0.25)
                end
            end
            task.wait(0.5)
        end
    end)
end

-- [[ KAITUN (AUTO LEVELING) LOGIC ]]
local function CalcOptimalQuest(damage)
    local bestQuest = nil
    local maxXpPer10m = -1
    for i, q in ipairs(HardcodedQuests) do
        local maxHealth = q.MaxHealth or 30000 
        local hitsToKill = math.ceil(maxHealth / damage)
        local timeToKill = (hitsToKill * 0.4) + 2 
        local totalTime = timeToKill * q.Amount
        local questsPer10m = 600 / totalTime
        local xpPer10m = q.XP * questsPer10m

        if xpPer10m > maxXpPer10m then maxXpPer10m = xpPer10m; bestQuest = q end
    end
    return bestQuest, maxXpPer10m
end

local function GetKaitunCenterAndMobs(questName)
    local npcFolder = workspace:FindFirstChild("NPCs")
    if not npcFolder then return nil, {} end
    local sumPos, count, validMobs = Vector3.zero, 0, {}
    
    for _, npc in ipairs(npcFolder:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then
            local base = getBaseName(npc.Name)
            if string.find(string.lower(base), string.lower(questName)) or string.find(string.lower(npc.Name), string.lower(questName)) then
                sumPos = sumPos + npc:GetPivot().Position
                count = count + 1
                table.insert(validMobs, npc)
            end
        end
    end
    if count > 0 then return sumPos / count, validMobs end
    return nil, {}
end

local function StartKaitun()
    if kaitunTask then task.cancel(kaitunTask) end
    if kaitunStatTask then task.cancel(kaitunStatTask) end

    kaitunTask = task.spawn(function()
        updateStatus("Kaitun: Performing Base Stat Wipe...")
        pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("ResetStats"):FireServer() end)
        task.wait(1.5)
        pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("AllocateStat"):FireServer("Defense", 40) end)
        task.wait(0.3)
        pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("AllocateStat"):FireServer("Sword", 25000) end)
        task.wait(0.3)
        pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("AllocateStat"):FireServer("Defense", 25000) end)
        task.wait(0.5)

        kaitunStatTask = task.spawn(function()
            while autoKaitunActive do
                task.wait(120)
                if autoKaitunActive then
                    pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("AllocateStat"):FireServer("Sword", 25000) end)
                end
            end
        end)

        local nextCheckTick = tick()
        local bestQuest = nil
        local maxXpPer10m = 0

        while autoKaitunActive do
            if isTraversing then task.wait(0.5); continue end
            
            if CurrentHitDamage <= 0 then
                updateStatus("Kaitun: Gauging Damage... Finding closest mob.")
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local closestMob, dist = nil, math.huge
                
                if hrp and workspace:FindFirstChild("NPCs") then
                    for _, npc in ipairs(workspace.NPCs:GetChildren()) do
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            local d = (hrp.Position - npc:GetPivot().Position).Magnitude
                            if d < dist then dist = d; closestMob = npc end
                        end
                    end
                end
                
                if closestMob then
                    local targetPart = getTargetPart(closestMob)
                    if targetPart then
                        local combatPos = targetPart.Position + getTargetOffset()
                        if (hrp.Position - combatPos).Magnitude > 2500 then SmartTraverse(combatPos) else TweenToSync(combatPos) end
                        if not autoCycleActive then equipWeapon(selectedWeapon) end
                        FireHitRemote(targetPart.Position)
                        
                        local timeout = tick() + 2
                        while CurrentHitDamage <= 0 and tick() < timeout do task.wait(0.1) end
                    end
                end
                continue
            end

            if tick() >= nextCheckTick or not bestQuest then
                bestQuest, maxXpPer10m = CalcOptimalQuest(CurrentHitDamage)
                nextCheckTick = tick() + 60 
            end

            if bestQuest then
                local timeRemaining = math.max(0, math.ceil(nextCheckTick - tick()))
                updateStatus(string.format("Delta Dmg: %s | Best: %s (%s XP/10m) | Check in: %ds", FormatAbbreviation(CurrentHitDamage), bestQuest.NPC, FormatAbbreviation(maxXpPer10m), timeRemaining))

                if currentKaitunQuest ~= bestQuest then
                    isTraversing = true
                    FireAbandonQuest(); task.wait(0.5)

                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local questPos = bestQuest.Pos + Vector3.new(0, 5, 0)
                        if (hrp.Position - questPos).Magnitude > 2500 then SmartTraverse(questPos) else TweenToSync(questPos) end
                    end

                    FireAcceptQuest(bestQuest.Index); task.wait(1.5)
                    currentKaitunQuest = bestQuest
                    isTraversing = false
                    continue
                end

                local centerPos, validMobs = GetKaitunCenterAndMobs(bestQuest.NPC)
                if centerPos then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local combatPos = centerPos + getTargetOffset()
                        if (hrp.Position - combatPos).Magnitude > 2500 then
                            task.spawn(function() SmartTraverse(combatPos) end); task.wait(1)
                        elseif (hrp.Position - combatPos).Magnitude > 15 then
                            TweenToAsync(combatPos)
                        else
                            if activeTween then activeTween:Cancel(); activeTween = nil end
                            DisableNoclip()
                            hrp.CFrame = CFrame.new(combatPos)
                            if not autoCycleActive then equipWeapon(selectedWeapon) end
                            
                            for _, npc in ipairs(validMobs) do
                                local targetPart = getTargetPart(npc)
                                if targetPart then FireHitRemote(targetPart.Position) end
                            end
                        end
                    end
                else
                    updateStatus(string.format("Waiting for %s | Check in: %ds", bestQuest.NPC, timeRemaining))
                end
            end
            task.wait(0.25)
        end
    end)
end

-- [[ KILLAURA ATTACK LOOP (MANUAL) ]]
local function startKillAura()
    if not killAuraActive then return end
    updateStatus("Initializing KillAura & Traversal...")

    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        while killAuraActive do
            if isTraversing then task.wait(0.5); continue end
            if not workspace:FindFirstChild("NPCs") then task.wait(0.5); continue end

            local currentTarget, bestTarget, bossTarget = nil, nil, nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero
            local validMobFound = false

            for _, npc in ipairs(workspace.NPCs:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    if isMobSelected(npc.Name) then
                        validMobFound = true
                        local isBoss = string.find(string.lower(npc.Name), "boss_") ~= nil
                        local dist = (charPos - npc:GetPivot().Position).Magnitude
                        
                        if isBoss then
                            if not bossTarget or dist < closestDist then bossTarget = npc; closestDist = dist end
                        elseif not bossTarget then
                            if dist < closestDist then bestTarget = npc; closestDist = dist end
                        end
                    end
                end
            end

            currentTarget = bossTarget or bestTarget

            if not validMobFound then
                if not killAllActive and not killTimedBossesActive and type(selectedMobs) == "table" and next(selectedMobs) == nil then updateStatus("No mobs selected.") else updateStatus("No selected mobs alive.") end
                task.wait(0.5); continue
            end

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                while killAuraActive and not isTraversing and currentTarget and currentTarget.Parent and hum and hum.Health > 0 do
                    local targetPart = getTargetPart(currentTarget)
                    if targetPart then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local combatPos = targetPart.Position + getTargetOffset()
                            if (hrp.Position - combatPos).Magnitude > 2500 then
                                task.spawn(function() SmartTraverse(combatPos) end); task.wait(1); break 
                            elseif (hrp.Position - combatPos).Magnitude > 15 then
                                TweenToAsync(combatPos)
                            else
                                if activeTween then activeTween:Cancel(); activeTween = nil end
                                DisableNoclip()
                                hrp.CFrame = CFrame.new(combatPos)
                                if not autoCycleActive then equipWeapon(selectedWeapon) end
                                FireHitRemote(targetPart.Position)
                                updateStatus("Target: " .. currentTarget.Name .. " | HP: " .. tostring(math.floor(hum.Health)))
                            end
                        end
                    end
                    task.wait(0.25)
                end
            end
            task.wait(0.1)
        end
    end)
end

