                sunkenStroke(row, 1)

                local topHeader = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, dDesc and 44 or 34),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 6,
                }, row)
                mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, topHeader)

                local info = buildControlHeader(topHeader, dTitle, dDesc)
                info.AnchorPoint = Vector2.new(0, 0.5)
                info.Position = UDim2.new(0, 0, 0.5, 0)

                local selectedPill = mk("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(110, 20),
                    BackgroundColor3 = Color3.fromRGB(8, 10, 14),
                    ZIndex = 7,
                }, topHeader)
                corner(selectedPill, 4)
                sunkenStroke(selectedPill, 1)

                local pillText = mk("TextLabel", {
                    Position = UDim2.fromOffset(6, 0),
                    Size = UDim2.new(1, -24, 1, 0),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamMedium,
                    Text = "...",
                    TextColor3 = Color3.fromRGB(200, 215, 240),
                    TextSize = 10,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                }, selectedPill)

                local chevron = mk("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -6, 0.5, 0),
                    Size = UDim2.fromOffset(12, 12),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamBold,
                    Text = "▼",
                    TextColor3 = Color3.fromRGB(148, 163, 184),
                    TextSize = 8,
                    ZIndex = 8,
                }, selectedPill)

                local itemsHolder = mk("Frame", {
                    Position = UDim2.new(0, 10, 0, dDesc and 44 or 34),
                    Size = UDim2.new(1, -20, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Visible = false,
                    ZIndex = 7,
                }, row)
                mk("UIListLayout", { Padding = UDim.new(0, 4) }, itemsHolder)
                mk("UIPadding", { PaddingBottom = UDim.new(0, 8), PaddingTop = UDim.new(0, 4) }, itemsHolder)

                local DropdownControl = {
                    Value = isMulti and {} or "",
                    Items = dItems,
                    Open = false,
                }

                if isMulti then
                    if type(dDefault) == "table" then
                        for _, itm in ipairs(dDefault) do DropdownControl.Value[itm] = true end
                    end
                else
                    DropdownControl.Value = tostring(dDefault)
                end

                local function getDisplayText()
                    if isMulti then
                        local selected = {}
                        for _, itm in ipairs(DropdownControl.Items) do
                            if DropdownControl.Value[itm] then table.insert(selected, itm) end
                        end
                        if #selected == 0 then return "None" end
                        return table.concat(selected, ", ")
                    else
                        return tostring(DropdownControl.Value)
                    end
                end

                local function refreshVisual()
                    pillText.Text = getDisplayText()
                    for _, optBtn in ipairs(itemsHolder:GetChildren()) do
                        if optBtn:IsA("TextButton") then
                            local itemName = optBtn.Name
                            local isSelected = isMulti and (DropdownControl.Value[itemName] == true) or (DropdownControl.Value == itemName)
                            optBtn.BackgroundColor3 = isSelected and Color3.fromRGB(24, 30, 44) or Color3.fromRGB(14, 17, 23)
                            optBtn.TextLabel.TextColor3 = isSelected and Color3.fromRGB(245, 248, 255) or Color3.fromRGB(130, 145, 170)
                            optBtn.Indicator.Visible = isSelected
                        end
                    end
                end

                local function buildList()
                    for _, child in ipairs(itemsHolder:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    for _, itm in ipairs(DropdownControl.Items) do
                        local opt = mk("TextButton", {
                            Name = tostring(itm),
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = Color3.fromRGB(14, 17, 23),
                            Text = "",
                            AutoButtonColor = false,
                            ZIndex = 8,
                        }, itemsHolder)
                        corner(opt, 4)
                        sunkenStroke(opt, 1)

                        local lbl = mk("TextLabel", {
                            Position = UDim2.fromOffset(8, 0),
                            Size = UDim2.new(1, -30, 1, 0),
                            BackgroundTransparency = 1,
                            Font = Enum.Font.GothamMedium,
                            Text = tostring(itm),
                            TextColor3 = Color3.fromRGB(130, 145, 170),
                            TextSize = 10,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 9,
                        }, opt)

                        local ind = mk("Frame", {
                            Name = "Indicator",
                            AnchorPoint = Vector2.new(1, 0.5),
                            Position = UDim2.new(1, -8, 0.5, 0),
                            Size = UDim2.fromOffset(6, 6),
                            BackgroundColor3 = accentCol,
                            Visible = false,
                            ZIndex = 9,
                        }, opt)
                        corner(ind, 3)

                        opt.MouseButton1Click:Connect(function()
                            if isMulti then
                                DropdownControl.Value[itm] = not DropdownControl.Value[itm]
                            else
                                DropdownControl.Value = itm
                                DropdownControl.Open = false
                                itemsHolder.Visible = false
                                chevron.Text = "▼"
                            end
                            refreshVisual()
                            if dFlag then Library.Flags[dFlag] = DropdownControl.Value end
                            pcall(dCallback, DropdownControl.Value)
                        end)
                    end
                    refreshVisual()
                end

                topHeader.MouseButton1Click:Connect(function()
                    DropdownControl.Open = not DropdownControl.Open
                    itemsHolder.Visible = DropdownControl.Open
                    chevron.Text = DropdownControl.Open and "▲" or "▼"
                end)

                function DropdownControl:Set(val, fireCb)
                    if isMulti and type(val) == "table" then
                        self.Value = {}
                        for _, v in ipairs(val) do self.Value[v] = true end
                    else
                        self.Value = tostring(val)
                    end
                    refreshVisual()
                    if dFlag then Library.Flags[dFlag] = self.Value end
                    if fireCb ~= false then pcall(dCallback, self.Value) end
                end

                function DropdownControl:SetOptions(newList, newDefault)
                    self.Items = newList or {}
                    if newDefault ~= nil then
                        self:Set(newDefault, true)
                    else
                        buildList()
                    end
                end

                function DropdownControl:Get()
                    return self.Value
                end

                buildList()
                if dFlag then
                    Library.Flags[dFlag] = DropdownControl.Value
                    Library.RegisteredControls[dFlag] = DropdownControl
                end
                return DropdownControl
            end

            -- ------------------------------------------------------------------
            -- KEYBIND (INTERACTIVE BINDING BUTTON)
            -- ------------------------------------------------------------------
            function SectionObj:CreateKeybind(kConfig)
                kConfig = kConfig or {}
                local kTitle = kConfig.Title or kConfig.Name or "Keybind"
                local kDesc = kConfig.Description
                local kDefault = kConfig.Default or Enum.KeyCode.Unknown
                local kMode = kConfig.Mode or "Toggle" -- "Toggle", "Hold", "Press"
                local kFlag = kConfig.Flag
                local kCallback = kConfig.Callback or function() end

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, kDesc and 44 or 34),
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                    ZIndex = 5,
                }, card)
                corner(row, 6)
                sunkenStroke(row, 1)

                mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, row)
                local info = buildControlHeader(row, kTitle, kDesc)
                info.AnchorPoint = Vector2.new(0, 0.5)
                info.Position = UDim2.new(0, 0, 0.5, 0)

                local bindBtn = mk("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(68, 20),
                    BackgroundColor3 = Color3.fromRGB(8, 10, 14),
                    Font = Enum.Font.GothamBold,
                    Text = kDefault.Name or "None",
                    TextColor3 = Color3.fromRGB(165, 180, 252),
                    TextSize = 10,
                    AutoButtonColor = false,
                    ZIndex = 6,
                }, row)
                corner(bindBtn, 4)
                sunkenStroke(bindBtn, 1)

                local KeybindControl = {
                    Value = kDefault,
                    Binding = false,
                    State = false,
                }

                bindBtn.MouseButton1Click:Connect(function()
                    KeybindControl.Binding = true
                    bindBtn.Text = "..."
                    bindBtn.TextColor3 = Color3.fromRGB(245, 158, 11)
                end)

                UserInputService.InputBegan:Connect(function(input, gpe)
                    if KeybindControl.Binding then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            local chosen = input.KeyCode
                            if chosen == Enum.KeyCode.Escape or chosen == Enum.KeyCode.Backspace then
                                chosen = Enum.KeyCode.Unknown
                            end
                            KeybindControl.Value = chosen
                            KeybindControl.Binding = false
                            bindBtn.Text = chosen ~= Enum.KeyCode.Unknown and chosen.Name or "None"
                            bindBtn.TextColor3 = Color3.fromRGB(165, 180, 252)
                            if kFlag then Library.Flags[kFlag] = chosen end
                        end
                        return
                    end

                    if not gpe and KeybindControl.Value ~= Enum.KeyCode.Unknown and input.KeyCode == KeybindControl.Value then
                        if kMode == "Toggle" then
                            KeybindControl.State = not KeybindControl.State
                            pcall(kCallback, KeybindControl.State)
                        elseif kMode == "Press" then
                            pcall(kCallback, true)
                        elseif kMode == "Hold" then
                            KeybindControl.State = true
                            pcall(kCallback, true)
                        end
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if KeybindControl.Value ~= Enum.KeyCode.Unknown and input.KeyCode == KeybindControl.Value and kMode == "Hold" then
                        KeybindControl.State = false
                        pcall(kCallback, false)
                    end
                end)

                function KeybindControl:Set(keyCode)
                    self.Value = keyCode or Enum.KeyCode.Unknown
                    bindBtn.Text = self.Value.Name or "None"
                    if kFlag then Library.Flags[kFlag] = self.Value end
                end
                function KeybindControl:Get()
                    return self.Value
                end

                if kFlag then
                    Library.Flags[kFlag] = kDefault
                    Library.RegisteredControls[kFlag] = KeybindControl
                end
                return KeybindControl
            end

            -- ------------------------------------------------------------------
            -- COLOR PICKER (RGB SLIDERS + INSTANT PRESETS)
            -- ------------------------------------------------------------------
            function SectionObj:CreateColorPicker(cConfig)
                cConfig = cConfig or {}
                local cTitle = cConfig.Title or cConfig.Name or "Color Picker"
                local cDesc = cConfig.Description
                local cDefault = cConfig.Default or Color3.fromRGB(255, 255, 255)
                local cFlag = cConfig.Flag
                local cCallback = cConfig.Callback or function() end

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                    ClipsDescendants = true,
                    ZIndex = 5,
                }, card)
                corner(row, 6)
                sunkenStroke(row, 1)

                local topHeader = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, cDesc and 44 or 34),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 6,
                }, row)
                mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, topHeader)

                local info = buildControlHeader(topHeader, cTitle, cDesc)
                info.AnchorPoint = Vector2.new(0, 0.5)
                info.Position = UDim2.new(0, 0, 0.5, 0)

                local preview = mk("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(36, 18),
                    BackgroundColor3 = cDefault,
                    ZIndex = 7,
                }, topHeader)
                corner(preview, 4)
                beveledStroke(preview, Color3.fromRGB(255, 255, 255), Color3.fromRGB(60, 70, 90), 1)

                local paletteHolder = mk("Frame", {
                    Position = UDim2.new(0, 10, 0, cDesc and 44 or 34),
                    Size = UDim2.new(1, -20, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Visible = false,
                    ZIndex = 7,
                }, row)
                mk("UIListLayout", { Padding = UDim.new(0, 6) }, paletteHolder)
                mk("UIPadding", { PaddingBottom = UDim.new(0, 8), PaddingTop = UDim.new(0, 4) }, paletteHolder)

                local ColorControl = {
                    Value = cDefault,
                    R = math.round(cDefault.R * 255),
                    G = math.round(cDefault.G * 255),
                    B = math.round(cDefault.B * 255),
                    Open = false,
                }

                local function applyColor(fireCb)
                    local col = Color3.fromRGB(ColorControl.R, ColorControl.G, ColorControl.B)
                    ColorControl.Value = col
                    preview.BackgroundColor3 = col
                    if cFlag then Library.Flags[cFlag] = col end
                    if fireCb then pcall(cCallback, col) end
                end

                local function buildChannelSlider(channelName, startVal, onChg)
                    local cRow = mk("Frame", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, ZIndex = 8 }, paletteHolder)
                    mk("TextLabel", {
                        Size = UDim2.fromOffset(12, 16),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        Text = channelName,
                        TextColor3 = Color3.fromRGB(148, 163, 184),
                        TextSize = 10,
                        ZIndex = 9,
                    }, cRow)
                    local track = mk("Frame", {
                        Position = UDim2.fromOffset(18, 5),
                        Size = UDim2.new(1, -18, 0, 6),
                        BackgroundColor3 = Color3.fromRGB(7, 9, 12),
                        ZIndex = 8,
                    }, cRow)
                    corner(track, 3)
                    local fill = mk("Frame", {
                        Size = UDim2.new(startVal / 255, 0, 1, 0),
                        BackgroundColor3 = channelName == "R" and Color3.fromRGB(239, 68, 68) or (channelName == "G" and Color3.fromRGB(34, 197, 94) or Color3.fromRGB(59, 130, 246)),
                        BorderSizePixel = 0,
                        ZIndex = 9,
                    }, track)
                    corner(fill, 3)

                    local isDrag = false
                    local function update(input)
                        local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        fill.Size = UDim2.new(pct, 0, 1, 0)
                        onChg(math.round(pct * 255))
                    end
                    track.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            isDrag = true
                            update(input)
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDrag = false end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if isDrag and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
                    end)
                    return function(newVal)
                        fill.Size = UDim2.new(newVal / 255, 0, 1, 0)
                    end
                end

                local setR = buildChannelSlider("R", ColorControl.R, function(v) ColorControl.R = v; applyColor(true) end)
                local setG = buildChannelSlider("G", ColorControl.G, function(v) ColorControl.G = v; applyColor(true) end)
                local setB = buildChannelSlider("B", ColorControl.B, function(v) ColorControl.B = v; applyColor(true) end)

                local presetsRow = mk("Frame", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, ZIndex = 8 }, paletteHolder)
                mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, presetsRow)
                local presetCols = {
                    Color3.fromRGB(255, 255, 255), Color3.fromRGB(239, 68, 68), Color3.fromRGB(249, 115, 22),
                    Color3.fromRGB(234, 179, 8), Color3.fromRGB(34, 197, 94), Color3.fromRGB(6, 182, 212),
                    Color3.fromRGB(99, 102, 241), Color3.fromRGB(168, 85, 247)
                }
                for _, col in ipairs(presetCols) do
                    local pDot = mk("TextButton", {
                        Size = UDim2.fromOffset(14, 14),
                        BackgroundColor3 = col,
                        Text = "",
                        AutoButtonColor = false,
                        ZIndex = 9,
                    }, presetsRow)
                    corner(pDot, 7)
                    pDot.MouseButton1Click:Connect(function()
                        ColorControl.R = math.round(col.R * 255)
                        ColorControl.G = math.round(col.G * 255)
                        ColorControl.B = math.round(col.B * 255)
                        setR(ColorControl.R)
                        setG(ColorControl.G)
                        setB(ColorControl.B)
                        applyColor(true)
                    end)
                end

                topHeader.MouseButton1Click:Connect(function()
                    ColorControl.Open = not ColorControl.Open
                    paletteHolder.Visible = ColorControl.Open
                end)

                function ColorControl:Set(col, fireCb)
                    self.R = math.round(col.R * 255)
                    self.G = math.round(col.G * 255)
                    self.B = math.round(col.B * 255)
                    setR(self.R)
                    setG(self.G)
                    setB(self.B)
                    applyColor(fireCb ~= false)
                end
                function ColorControl:Get()
                    return self.Value
                end

                if cFlag then
                    Library.Flags[cFlag] = cDefault
                    Library.RegisteredControls[cFlag] = ColorControl
                end
                return ColorControl
            end

            -- ------------------------------------------------------------------
            -- TEXT INPUT
            -- ------------------------------------------------------------------
            function SectionObj:CreateInput(iConfig)
                iConfig = iConfig or {}
                local iTitle = iConfig.Title or iConfig.Name or "Input"
                local iDesc = iConfig.Description
                local iPlaceholder = iConfig.Placeholder or "Type here..."
                local iDefault = iConfig.Default or ""
                local isNumeric = iConfig.Numeric == true
                local isFinished = iConfig.Finished ~= false
                local iFlag = iConfig.Flag
                local iCallback = iConfig.Callback or function() end

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, iDesc and 44 or 34),
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                    ZIndex = 5,
                }, card)
                corner(row, 6)
                sunkenStroke(row, 1)

                mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, row)
                local info = buildControlHeader(row, iTitle, iDesc)
                info.AnchorPoint = Vector2.new(0, 0.5)
                info.Position = UDim2.new(0, 0, 0.5, 0)

                local inputWell = mk("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(110, 22),
                    BackgroundColor3 = Color3.fromRGB(8, 10, 14),
                    ZIndex = 6,
                }, row)
                corner(inputWell, 4)
                local inStroke = sunkenStroke(inputWell, 1)

                local box = mk("TextBox", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamMedium,
                    PlaceholderText = iPlaceholder,
                    PlaceholderColor3 = Color3.fromRGB(80, 95, 120),
                    Text = tostring(iDefault),
                    TextColor3 = Color3.fromRGB(230, 235, 245),
                    TextSize = 10,
                    ClearTextOnFocus = false,
                    ZIndex = 7,
                }, inputWell)
                mk("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, box)

                local InputControl = { Value = tostring(iDefault) }

                box.Focused:Connect(function()
                    inStroke.Color = Color3.fromRGB(99, 102, 241)
                end)

                box.FocusLost:Connect(function(enterPressed)
                    inStroke.Color = Color3.new(1, 1, 1)
                    local txt = box.Text
                    if isNumeric then
                        txt = string.gsub(txt, "[^%d%.%-]", "")
                        box.Text = txt
                    end
                    InputControl.Value = txt
                    if iFlag then Library.Flags[iFlag] = txt end
                    pcall(iCallback, txt)
                end)

                if not isFinished then
                    box:GetPropertyChangedSignal("Text"):Connect(function()
                        local txt = box.Text
                        if isNumeric then
                            txt = string.gsub(txt, "[^%d%.%-]", "")
                            box.Text = txt
                        end
                        InputControl.Value = txt
                        if iFlag then Library.Flags[iFlag] = txt end
                        pcall(iCallback, txt)
                    end)
                end

                function InputControl:Set(val)
                    self.Value = tostring(val)
                    box.Text = tostring(val)
                    if iFlag then Library.Flags[iFlag] = self.Value end
                end
                function InputControl:Get()
                    return self.Value
                end

                if iFlag then
                    Library.Flags[iFlag] = InputControl.Value
                    Library.RegisteredControls[iFlag] = InputControl
                end
                return InputControl
            end

            -- ------------------------------------------------------------------
            -- BUTTON
            -- ------------------------------------------------------------------
            function SectionObj:CreateButton(bConfig)
                bConfig = bConfig or {}
                local bTitle = bConfig.Title or bConfig.Name or "Button"
                local bDesc = bConfig.Description
                local bCallback = bConfig.Callback or function() end

                local btn = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, bDesc and 40 or 30),
                    BackgroundColor3 = Color3.fromRGB(22, 27, 38),
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 5,
                }, card)
                corner(btn, 6)
                surfaceLight(btn, Color3.fromRGB(30, 37, 52), Color3.fromRGB(16, 20, 28), 90)
                beveledStroke(btn, Color3.fromRGB(75, 90, 120), Color3.fromRGB(22, 28, 40), 1)

                mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, btn)
                local info = buildControlHeader(btn, bTitle, bDesc)
                info.AnchorPoint = Vector2.new(0, 0.5)
                info.Position = UDim2.new(0, 0, 0.5, 0)

                btn.MouseEnter:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.14), { BackgroundColor3 = Color3.fromRGB(28, 35, 50) }):Play()
                end)
                btn.MouseLeave:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.14), { BackgroundColor3 = Color3.fromRGB(22, 27, 38) }):Play()
                end)
                btn.MouseButton1Down:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.06), { Position = UDim2.fromOffset(0, 1) }):Play()
                end)
                btn.MouseButton1Up:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.1), { Position = UDim2.fromOffset(0, 0) }):Play()
                end)
                btn.MouseButton1Click:Connect(function()
                    pcall(bCallback)
                end)

                return {
                    Fire = function() pcall(bCallback) end
                }
            end

            -- ------------------------------------------------------------------
            -- PARAGRAPH
            -- ------------------------------------------------------------------
            function SectionObj:CreateParagraph(pConfig)
                pConfig = pConfig or {}
                local pTitle = pConfig.Title or "Notice"
                local pContent = pConfig.Content or ""

                local frame = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                    ZIndex = 5,
                }, card)
                corner(frame, 6)
                sunkenStroke(frame, 1)

                mk("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, frame)
                mk("UIListLayout", { Padding = UDim.new(0, 3) }, frame)

                local titleLbl = mk("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 14),
                    Font = Enum.Font.GothamBold,
                    Text = pTitle,
                    TextColor3 = Color3.fromRGB(241, 245, 249),
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, frame)

                local bodyLbl = mk("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Font = Enum.Font.GothamMedium,
                    Text = pContent,
                    TextColor3 = Color3.fromRGB(148, 163, 184),
                    TextSize = 9,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, frame)

                return {
                    Set = function(_, info)
                        if info.Title then titleLbl.Text = info.Title end
                        if info.Content then bodyLbl.Text = info.Content end
                    end
                }
            end

            -- ------------------------------------------------------------------
            -- DIVIDER
            -- ------------------------------------------------------------------
            function SectionObj:CreateDivider()
                local div = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Color3.fromRGB(30, 36, 48),
                    BorderSizePixel = 0,
                    ZIndex = 5,
                }, card)
                return div
            end

            return SectionObj
        end

        table.insert(WindowObj.Tabs, TabObj)
        if #WindowObj.Tabs == 1 then
            activateTab()
        end
        return TabObj
    end

    table.insert(self.Windows, WindowObj)
    self.ActiveWindow = WindowObj
    return WindowObj
end

-- ==============================================================================
-- CONFIGURATION / PERSISTENCE SYSTEM
-- ==============================================================================
function Library:SaveConfig(filename)
    if not writefile then return false, "writefile unavailable" end
    local payload = {}
    for flag, val in pairs(self.Flags) do
        if typeof(val) == "Color3" then
            payload[flag] = { __type = "Color3", r = val.R, g = val.G, b = val.B }
        elseif typeof(val) == "EnumItem" then
            payload[flag] = { __type = "EnumItem", enum = tostring(val) }
        else
            payload[flag] = val
        end
    end
    local ok, res = pcall(function()
        writefile(filename .. ".json", HttpService:JSONEncode(payload))
    end)
    return ok, res
end

function Library:LoadConfig(filename)
    if not readfile or not isfile then return false, "file funcs unavailable" end
    if not isfile(filename .. ".json") then return false, "file not found" end
    local ok, res = pcall(function()
        local data = HttpService:JSONDecode(readfile(filename .. ".json"))
        for flag, val in pairs(data) do
            local ctrl = self.RegisteredControls[flag]
            if ctrl then
                if type(val) == "table" and val.__type == "Color3" then
                    ctrl:Set(Color3.new(val.r, val.g, val.b), true)
                elseif type(val) == "table" and val.__type == "EnumItem" then
                    local name = string.match(val.enum, "Enum%.KeyCode%.(.*)")
                    if name and Enum.KeyCode[name] then
                        ctrl:Set(Enum.KeyCode[name])
                    end
                else
                    ctrl:Set(val, true)
                end
            end
        end
    end)
    return ok, res
end

return Library
