                    Size = UDim2.fromScale(1, 1),
                    BackgroundColor3 = accentCol,
                    BackgroundTransparency = tDefault and 0 or 1,
                    ZIndex = 6,
                }, track)
                corner(trackActive, 10)

                local knob = mk("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = tDefault and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                    Size = UDim2.fromOffset(14, 14),
                    BackgroundColor3 = Color3.fromRGB(245, 248, 255),
                    ZIndex = 7,
                }, track)
                corner(knob, 7)
                beveledStroke(knob, Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 155, 180), 1)

