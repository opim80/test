                    }):Play()
                    TweenService:Create(trackActive, TweenInfo.new(0.18), { BackgroundTransparency = val and 0 or 1 }):Play()
                    if fireCb then pcall(tCallback, val) end
                end

                trigger.MouseButton1Click:Connect(function()
