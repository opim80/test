function Library:InitNotificationStack()
    if self.NotifyStack and self.NotifyStack.Parent then return end

    local mount = getMountTarget()
    local notifGui = mk("ScreenGui", {
        Name = "BW_Notifications",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100,
    }, mount)

    self.NotifyStack = mk("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -20, 1, -20),
        Size = UDim2.fromOffset(280, 400),
        BackgroundTransparency = 1,
    }, notifGui)

    mk("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.NotifyStack)
end

function Library:Notify(props)
    props = props or {}
    local title = props.Title or "NOTIFICATION"
    local content = props.Content or ""
    local duration = props.Duration or 3

    self:InitNotificationStack()

    local item = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 52),
        Position = UDim2.fromOffset(50, 0),
        BackgroundColor3 = Color3.fromRGB(16, 19, 26),
        ClipsDescendants = true,
    }, self.NotifyStack)
    corner(item, 6)
    surfaceLight(item, Color3.fromRGB(24, 29, 40), Color3.fromRGB(14, 16, 22), 90)
    beveledStroke(item, Color3.fromRGB(75, 90, 120), Color3.fromRGB(20, 24, 32), 1)

    addUIShadow(item, {
        BlurRadius = UDim.new(0, 8),
        Offset = UDim2.fromOffset(0, 3),
        Transparency = 0.5,
    })

    -- Specular top line
    local topGleam = mk("Frame", {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
    }, item)
    movingGradient(topGleam, {
        Rotation = 0,
        Speed = 2.5,
        PingPong = true,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, Color3.fromRGB(22, 26, 36)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(129, 140, 248)),
            ColorSequenceKeypoint.new(1.0, Color3.fromRGB(22, 26, 36)),
        }),
    })

    mk("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 8),
        Size = UDim2.new(1, -20, 0, 14),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = Color3.fromRGB(241, 245, 249),
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, item)

    mk("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 24),
        Size = UDim2.new(1, -20, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = content,
        TextColor3 = Color3.fromRGB(148, 163, 184),
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, item)

    -- Bottom countdown bar
    local countBar = mk("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Color3.fromRGB(99, 102, 241),
        BorderSizePixel = 0,
    }, item)

    -- Entrance tween
    TweenService:Create(item, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.fromOffset(0, 0)
    }):Play()

    -- Countdown shrink
    TweenService:Create(countBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    task.delay(duration, function()
        if not item or not item.Parent then return end
        local fadeOut = TweenService:Create(item, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.fromOffset(60, 0),
            BackgroundTransparency = 1
        })
        fadeOut:Play()
        fadeOut.Completed:Connect(function()
            item:Destroy()
        end)
    end)
end

