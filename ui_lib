                }, trackWell)
                corner(knob, 7)
                surfaceLight(knob, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 210, 230), 90)
                beveledStroke(knob, Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 155, 180), 1)

                addUIShadow(knob, {
                    BlurRadius = UDim.new(0, 3),
                    Offset = UDim2.fromOffset(0, 1),
                    Transparency = 0.35,
