                    BlurRadius = UDim.new(0, 4),
                    Offset = UDim2.fromOffset(0, 1),
                    Transparency = 0.5,
                })

                local selLbl = mk("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(8, 0),
                    Size = UDim2.new(1, -28, 1, 0),
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(dDefault),
                    TextColor3 = Color3.fromRGB(199, 210, 254),
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }, dropBtn)

                local chevron = mk("TextLabel", {
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -6, 0.5, 0),
                    Size = UDim2.fromOffset(14, 14),
                    Font = Enum.Font.GothamBold,
                    Text = "▼",
                    TextColor3 = Color3.fromRGB(148, 163, 184),
                    TextSize = 8,
                }, dropBtn)

                dropBtn.MouseEnter:Connect(function()
                    TweenService:Create(dropBtn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(28, 34, 48) }):Play()
                end)
                dropBtn.MouseLeave:Connect(function()
                    TweenService:Create(dropBtn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(22, 27, 38) }):Play()
                end)

                -- Divider line between header and options
                local listDivider = mk("Frame", {
                    Position = UDim2.new(0, 8, 0, 36),
                    Size = UDim2.new(1, -16, 0, 1),
                    BackgroundColor3 = Color3.fromRGB(24, 28, 38),
                    BorderSizePixel = 0,
                    Visible = false,
                }, row)

                -- Dropdown List Holder
                local listHolder = mk("Frame", {
                    Position = UDim2.new(0, 8, 0, 42),
                    Size = UDim2.new(1, -16, 0, 0),
                    BackgroundTransparency = 1,
                    ClipsDescendants = true,
                }, row)

                local listLayout = mk("UIListLayout", {
                    Padding = UDim.new(0, 3),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }, listHolder)

                local DropdownControl = {
                    Value = dDefault,
                    Options = dOptions,
                    IsOpen = false,
                }

                local optionButtons = {}

                local function setDropdownOpen(openState)
                    DropdownControl.IsOpen = openState
                    local count = #DropdownControl.Options
                    local totalH = count * 26 + math.max(0, count - 1) * 3
                    local targetRowHeight = openState and (42 + totalH + 8) or 36

                    listDivider.Visible = openState
                    listHolder.Size = UDim2.new(1, -16, 0, totalH)

                    TweenService:Create(row, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        Size = UDim2.new(1, 0, 0, targetRowHeight)
                    }):Play()

                    TweenService:Create(chevron, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        Rotation = openState and 180 or 0,
                        TextColor3 = openState and Color3.fromRGB(241, 245, 249) or Color3.fromRGB(148, 163, 184),
                    }):Play()
                end

                dropBtn.MouseButton1Click:Connect(function()
                    setDropdownOpen(not DropdownControl.IsOpen)
                end)

                local function updateOptionVisuals()
                    for optVal, btnInfo in pairs(optionButtons) do
                        local isSelected = (optVal == DropdownControl.Value)
                        local b = btnInfo.Button
                        local acc = btnInfo.Accent
                        local lbl = btnInfo.Label

                        if isSelected then
                            b.BackgroundColor3 = Color3.fromRGB(26, 32, 48)
                            b.BackgroundTransparency = 0
                            acc.BackgroundTransparency = 0
                            lbl.TextColor3 = Color3.fromRGB(241, 245, 249)
                        else
                            b.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
                            b.BackgroundTransparency = 1
                            acc.BackgroundTransparency = 1
                            lbl.TextColor3 = Color3.fromRGB(148, 163, 184)
                        end
                    end
                end

                local function selectOption(val, fireCallback)
                    DropdownControl.Value = val
                    selLbl.Text = tostring(val)
                    updateOptionVisuals()
                    setDropdownOpen(false)

                    if fireCallback then
                        pcall(dCallback, val)
                    end
                end

                local function rebuildOptions()
                    for _, child in ipairs(listHolder:GetChildren()) do
                        if child:IsA("GuiObject") and not child:IsA("UIListLayout") then
                            child:Destroy()
                        end
                    end
                    optionButtons = {}

                    for idx, opt in ipairs(DropdownControl.Options) do
                        local isSelected = (opt == DropdownControl.Value)
                        local optBtn = mk("TextButton", {
                            Size = UDim2.new(1, 0, 0, 26),
                            BackgroundColor3 = isSelected and Color3.fromRGB(26, 32, 48) or Color3.fromRGB(16, 20, 28),
                            BackgroundTransparency = isSelected and 0 or 1,
                            AutoButtonColor = false,
                            Text = "",
                            LayoutOrder = idx,
                        }, listHolder)
                        corner(optBtn, 4)

                        local leftAccent = mk("Frame", {
                            AnchorPoint = Vector2.new(0, 0.5),
                            Position = UDim2.new(0, 4, 0.5, 0),
                            Size = UDim2.fromOffset(3, 14),
                            BackgroundColor3 = accentCol,
                            BackgroundTransparency = isSelected and 0 or 1,
                            BorderSizePixel = 0,
                        }, optBtn)
                        corner(leftAccent, 2)

                        local optLbl = mk("TextLabel", {
                            BackgroundTransparency = 1,
                            Position = UDim2.fromOffset(14, 0),
                            Size = UDim2.new(1, -20, 1, 0),
                            Font = Enum.Font.GothamMedium,
                            Text = tostring(opt),
                            TextColor3 = isSelected and Color3.fromRGB(241, 245, 249) or Color3.fromRGB(148, 163, 184),
                            TextSize = 10,
                            TextXAlignment = Enum.TextXAlignment.Left,
                        }, optBtn)

                        optBtn.MouseEnter:Connect(function()
                            if opt ~= DropdownControl.Value then
                                TweenService:Create(optBtn, TweenInfo.new(0.12), {
                                    BackgroundTransparency = 0,
                                    BackgroundColor3 = Color3.fromRGB(20, 25, 36),
                                }):Play()
                                TweenService:Create(optLbl, TweenInfo.new(0.12), {
                                    TextColor3 = Color3.fromRGB(210, 220, 240),
                                }):Play()
                            end
                        end)

                        optBtn.MouseLeave:Connect(function()
                            if opt ~= DropdownControl.Value then
                                TweenService:Create(optBtn, TweenInfo.new(0.12), {
                                    BackgroundTransparency = 1,
                                    BackgroundColor3 = Color3.fromRGB(16, 20, 28),
                                }):Play()
                                TweenService:Create(optLbl, TweenInfo.new(0.12), {
                                    TextColor3 = Color3.fromRGB(148, 163, 184),
                                }):Play()
                            end
                        end)

                        optBtn.MouseButton1Click:Connect(function()
                            selectOption(opt, true)
                        end)

                        optionButtons[opt] = {
                            Button = optBtn,
                            Accent = leftAccent,
                            Label = optLbl,
                        }
                    end
                end

                rebuildOptions()

                function DropdownControl:Set(val)
                    for _, opt in ipairs(self.Options) do
                        if opt == val then
                            selectOption(val, true)
                            return
                        end
                    end
                end

                function DropdownControl:Get()
                    return self.Value
                end

                function DropdownControl:SetOptions(newOpts)
                    self.Options = newOpts or {}
                    if not table.find(self.Options, self.Value) then
                        self.Value = self.Options[1] or "None"
                        selLbl.Text = tostring(self.Value)
                    end
                    rebuildOptions()
                    if self.IsOpen then
                        setDropdownOpen(true)
                    end
                end

                return DropdownControl
            end

            -- ========================================================
            -- COMPONENT: TACTILE ACTION BUTTON
            -- ========================================================
            function SectionObj:CreateButton(bConfig)
                bConfig = bConfig or {}
                local bName = bConfig.Name or "Action Button"
                local bCallback = bConfig.Callback or function() end

                local btn = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(30, 36, 52),
                    Font = Enum.Font.GothamBold,
                    Text = bName,
                    TextColor3 = Color3.fromRGB(241, 245, 249),
                    TextSize = 11,
                    AutoButtonColor = false,
                }, card)
                corner(btn, 5)
                surfaceLight(btn, Color3.fromRGB(42, 52, 75), Color3.fromRGB(25, 30, 44), 90)
                beveledStroke(btn, Color3.fromRGB(90, 110, 150), Color3.fromRGB(28, 34, 48), 1)

                -- Top-Bevel Traveling Light Reflection along Button
                local topBevel = mk("Frame", {
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                    ZIndex = 2,
                }, btn)
                movingGradient(topBevel, {
                    Rotation = 0,
                    Speed = 3.0,
                    PingPong = true,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(35, 45, 68)),
                        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(70, 90, 130)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 190, 255)),
                        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 90, 130)),
                        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(35, 45, 68)),
                    }),
                })

                local btnShadow = addUIShadow(btn, {
                    BlurRadius = UDim.new(0, 8),
                    Offset = UDim2.fromOffset(0, 3),
                    Transparency = 0.5,
                })

                btn.MouseEnter:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.15), {
                        BackgroundColor3 = Color3.fromRGB(38, 46, 66)
                    }):Play()
                end)
                btn.MouseLeave:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.15), {
                        BackgroundColor3 = Color3.fromRGB(30, 36, 52)
                    }):Play()
                end)

                -- Dynamic click compression and spring pop release
                btn.MouseButton1Down:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.08), {
                        Position = UDim2.fromOffset(0, 1),
                        BackgroundColor3 = Color3.fromRGB(20, 24, 34),
                    }):Play()
                    if btnShadow and btnShadow:IsA("UIShadow") then
                        TweenService:Create(btnShadow, TweenInfo.new(0.08), {
                            Offset = UDim2.fromOffset(0, 1),
                            BlurRadius = UDim.new(0, 3),
                            Transparency = 0.65,
                        }):Play()
                    end
                end)

                btn.MouseButton1Up:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Position = UDim2.fromOffset(0, 0),
                        BackgroundColor3 = Color3.fromRGB(38, 46, 66),
                    }):Play()
                    if btnShadow and btnShadow:IsA("UIShadow") then
                        TweenService:Create(btnShadow, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                            Offset = UDim2.fromOffset(0, 3),
                            BlurRadius = UDim.new(0, 8),
                            Transparency = 0.5,
                        }):Play()
                    end
                end)

                btn.MouseButton1Click:Connect(function()
                    pcall(bCallback)
                end)

                local ButtonControl = {}
                function ButtonControl:Fire()
                    pcall(bCallback)
                end
                return ButtonControl
            end

            -- ========================================================
            -- COMPONENT: RECESSED KEYBIND PICKER
            -- ========================================================
            function SectionObj:CreateKeybind(kConfig)
                kConfig = kConfig or {}
                local kName = kConfig.Name or "Keybind"
                local kDefault = kConfig.Default or Enum.KeyCode.E
                local kCallback = kConfig.Callback or function() end

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                }, card)
                corner(row, 6)
                sunkenStroke(row, 1)

                row.MouseEnter:Connect(function()
                    TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(15, 18, 25) }):Play()
                end)
                row.MouseLeave:Connect(function()
                    TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(12, 14, 19) }):Play()
                end)

                mk("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(10, 0),
                    Size = UDim2.new(1, -90, 1, 0),
                    Font = Enum.Font.GothamMedium,
                    Text = kName,
                    TextColor3 = Color3.fromRGB(226, 232, 240),
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, row)

                local keyBtn = mk("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(68, 22),
                    BackgroundColor3 = Color3.fromRGB(22, 27, 38),
                    Font = Enum.Font.GothamBold,
                    Text = kDefault.Name,
                    TextColor3 = Color3.fromRGB(199, 210, 254),
                    TextSize = 10,
                    AutoButtonColor = false,
                }, row)
                corner(keyBtn, 4)
                surfaceLight(keyBtn, Color3.fromRGB(30, 36, 52), Color3.fromRGB(18, 22, 32), 90)
                beveledStroke(keyBtn, Color3.fromRGB(75, 90, 125), Color3.fromRGB(25, 30, 42), 1)

                addUIShadow(keyBtn, {
                    BlurRadius = UDim.new(0, 3),
                    Offset = UDim2.fromOffset(0, 1),
                    Transparency = 0.5,
                })

                local KeybindControl = {
                    Value = kDefault,
                    Binding = false,
                }

                keyBtn.MouseButton1Click:Connect(function()
                    if KeybindControl.Binding then return end
                    KeybindControl.Binding = true
                    keyBtn.Text = "..."
                    keyBtn.TextColor3 = Color3.fromRGB(255, 215, 0)

                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input, gpe)
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            conn:Disconnect()
                            KeybindControl.Binding = false
                            KeybindControl.Value = input.KeyCode
                            keyBtn.Text = input.KeyCode.Name
                            keyBtn.TextColor3 = Color3.fromRGB(199, 210, 254)
                            pcall(kCallback, input.KeyCode)
                        end
                    end)
                end)

                function KeybindControl:Set(kc)
                    self.Value = kc
                    keyBtn.Text = kc.Name
                end

                function KeybindControl:Get()
                    return self.Value
                end

                return KeybindControl
            end

            table.insert(TabObj.Sections, SectionObj)
            return SectionObj
        end

        table.insert(WindowObj.Tabs, TabObj)

        -- Auto-select first tab
        if #WindowObj.Tabs == 1 then
            activateThisTab()
        end

        return TabObj
    end

    table.insert(self.Windows, WindowObj)
    self.ActiveWindow = WindowObj
    return WindowObj
end

return Library
