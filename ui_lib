            function SectionObj:CreateDropdown(dConfig)
                dConfig = dConfig or {}
                local dTitle = dConfig.Title or dConfig.Name or "Dropdown"
                local dDesc = dConfig.Description
                local dItems = dConfig.Items or {}
                local isMulti = dConfig.Multi == true
                local dDefault = dConfig.Default or (isMulti and {} or dItems[1] or "")
                local dFlag = dConfig.Flag
                local dCallback = dConfig.Callback or function() end

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                    ClipsDescendants = true,
                    ZIndex = 5,
                }, card)
