            -- ------------------------------------------------------------------
            -- SLIDER (DRAG + DIRECT NUMERIC INPUT)
            -- ------------------------------------------------------------------
            function SectionObj:CreateSlider(sConfig)
                sConfig = sConfig or {}
                local sTitle = sConfig.Title or sConfig.Name or "Slider"
                local sDesc = sConfig.Description
                local sMin = sConfig.Min or 0
                local sMax = sConfig.Max or 100
                local sDefault = math.clamp(sConfig.Default or sMin, sMin, sMax)
                local sDecimals = sConfig.Decimals or 0
                local sSuffix = sConfig.Suffix or ""
                local sFlag = sConfig.Flag
                local sCallback = sConfig.Callback or function() end

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, sDesc and 54 or 46),
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                    ZIndex = 5,
                }, card)
                corner(row, 6)
                sunkenStroke(row, 1)

                mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 6) }, row)

                local topRow = mk("Frame", { Size = UDim2.new(1, 0, 0, sDesc and 26 or 16), BackgroundTransparency = 1, ZIndex = 6 }, row)
                local info = buildControlHeader(topRow, sTitle, sDesc)
                info.Position = UDim2.fromOffset(0, 0)

                local valBox = mk("TextBox", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, 0, 0, 0),
                    Size = UDim2.fromOffset(58, 16),
                    BackgroundColor3 = Color3.fromRGB(8, 10, 14),
                    Font = Enum.Font.GothamBold,
                    Text = tostring(sDefault) .. sSuffix,
                    TextColor3 = Color3.fromRGB(129, 140, 248),
                    TextSize = 10,
                    ClearTextOnFocus = false,
                    ZIndex = 7,
                }, topRow)
                corner(valBox, 3)
                sunkenStroke(valBox, 1)

                local track = mk("Frame", {
                    Position = UDim2.new(0, 0, 1, -12),
                    Size = UDim2.new(1, 0, 0, 6),
                    BackgroundColor3 = Color3.fromRGB(7, 9, 12),
                    ZIndex = 6,
                }, row)
                corner(track, 3)
                sunkenStroke(track, 1)

                local initPct = (sDefault - sMin) / (sMax - sMin)
                local fill = mk("Frame", {
                    Size = UDim2.new(initPct, 0, 1, 0),
                    BackgroundColor3 = accentCol,
                    BorderSizePixel = 0,
                    ZIndex = 7,
                }, track)
                corner(fill, 3)

                local knob = mk("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(10, 10),
                    BackgroundColor3 = Color3.fromRGB(240, 245, 255),
                    ZIndex = 8,
                }, fill)
                corner(knob, 5)

                local SliderControl = { Value = sDefault }

                local function setSlider(val, fireCb)
                    val = math.clamp(val, sMin, sMax)
                    local factor = 10 ^ sDecimals
                    val = math.round(val * factor) / factor
                    SliderControl.Value = val

                    local pct = (val - sMin) / (sMax - sMin)
                    TweenService:Create(fill, TweenInfo.new(0.08, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        Size = UDim2.new(pct, 0, 1, 0)
                    }):Play()
                    valBox.Text = tostring(val) .. sSuffix

                    if sFlag then Library.Flags[sFlag] = val end
                    if fireCb then pcall(sCallback, val) end
                end

                valBox.FocusLost:Connect(function()
                    local clean = string.gsub(valBox.Text, "[^%d%.%-]", "")
                    local num = tonumber(clean)
                    if num then
                        setSlider(num, true)
                    else
                        valBox.Text = tostring(SliderControl.Value) .. sSuffix
                    end
                end)

                local isDragging = false
                local function updateFromInput(input)
                    local trackPos = track.AbsolutePosition.X
                    local trackWidth = track.AbsoluteSize.X
                    if trackWidth == 0 then return end
                    local pct = math.clamp((input.Position.X - trackPos) / trackWidth, 0, 1)
                    local rawVal = sMin + (sMax - sMin) * pct
                    setSlider(rawVal, true)
                end

                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = true
                        updateFromInput(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromInput(input)
                    end
                end)

                function SliderControl:Set(val, fireCb)
                    setSlider(val, fireCb ~= false)
                end
                function SliderControl:Get()
                    return self.Value
                end

                if sFlag then
                    Library.Flags[sFlag] = sDefault
                    Library.RegisteredControls[sFlag] = SliderControl
                end
                return SliderControl
            end

