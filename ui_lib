-- Safe Parent Mount
local function getMountTarget()
    local target = nil
    pcall(function() target = gethui and gethui() end)
    if not target then pcall(function() target = CoreGui end) end
    if not target and LP then target = LP:FindFirstChild("PlayerGui") end
    return target
end

-- ============================================================
-- PRIMITIVE BUILDERS & GRAPHICAL HELPERS
-- ============================================================
local function mk(cls, props, parent)
    local inst = Instance.new(cls)
    for k, v in pairs(props) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(p, r)
    return mk("UICorner", { CornerRadius = UDim.new(0, r or 6) }, p)
end

-- Top-down lighting gradient for surfaces (creates physical curvature)
local function surfaceLight(p, topCol, botCol, rot)
    return mk("UIGradient", {
        Rotation = rot or 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, topCol),
            ColorSequenceKeypoint.new(1.0, botCol),
        }),
    }, p)
end

-- Specular edge highlight (machined top bevel fading to dark bottom)
local function beveledStroke(p, topCol, botCol, th)
    local s = mk("UIStroke", {
        Color = Color3.new(1, 1, 1),
        Thickness = math.round(th or 1),
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
    mk("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, topCol or Color3.fromRGB(85, 98, 125)),
            ColorSequenceKeypoint.new(0.4, topCol or Color3.fromRGB(60, 70, 90)),
            ColorSequenceKeypoint.new(1.0, botCol or Color3.fromRGB(22, 26, 35)),
        }),
    }, s)
    return s
end

-- Recessed inverted stroke (for sunken wells, bottom catches light)
local function sunkenStroke(p, th)
    local s = mk("UIStroke", {
        Color = Color3.new(1, 1, 1),
        Thickness = math.round(th or 1),
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
    mk("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, Color3.fromRGB(16, 18, 24)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(25, 29, 38)),
            ColorSequenceKeypoint.new(1.0, Color3.fromRGB(50, 58, 75)),
        }),
    }, s)
    return s
end

-- Spatial Gradient Motion ("Moving colors, not changing colors")
local function movingGradient(p, props)
    props = props or {}
    local rot = props.Rotation or 0
    local rad = math.rad(rot)
    local dirX = math.cos(rad)
    local dirY = math.sin(rad)
    local startOff = props.StartOffset or Vector2.new(-dirX, -dirY)
    local endOff = props.EndOffset or Vector2.new(dirX, dirY)

    local grad = mk("UIGradient", {
        Rotation = rot,
        Color = props.Color or ColorSequence.new(Color3.new(1, 1, 1)),
        Offset = startOff,
    }, p)
    if props.Transparency then
        grad.Transparency = props.Transparency
    end

    local isPingPong = props.PingPong == true
    local tInfo = TweenInfo.new(
        props.Speed or 2.5,
        isPingPong and Enum.EasingStyle.Sine or Enum.EasingStyle.Linear,
        Enum.EasingDirection.InOut,
        -1,
        isPingPong
    )
    local tween = TweenService:Create(grad, tInfo, {
        Offset = endOff
    })
    tween:Play()
    return grad, tween
end

-- Native UIShadow with Graceful 9-Slice Fallback
local function addUIShadow(parent, props)
    props = props or {}
    local ok, shadow = pcall(Instance.new, "UIShadow")
    if ok and shadow then
        shadow.Color = props.Color or Color3.fromRGB(0, 0, 0)
        shadow.Transparency = props.Transparency or 0.45
        shadow.BlurRadius = props.BlurRadius or UDim.new(0, 10)
        shadow.Spread = props.Spread or UDim2.new(0, 0, 0, 0)
        shadow.Offset = props.Offset or UDim2.new(0, 0, 0, 4)
        if props.ZIndex then shadow.ZIndex = props.ZIndex end
        if props.Enabled ~= nil then shadow.Enabled = props.Enabled end
        shadow.Parent = parent
        return shadow
    end

    -- 9-Slice Fallback for environments where UIShadow is not enabled
    local spreadPx = (props.Spread and props.Spread.X.Offset) or 10
    local offX = (props.Offset and props.Offset.X.Offset) or 0
    local offY = (props.Offset and props.Offset.Y.Offset) or 4
    local s = mk("ImageLabel", {
        Name = "ShadowFallback",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, offX, 0.5, offY),
        Size = UDim2.new(1, spreadPx * 2 + 16, 1, spreadPx * 2 + 16),
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = props.Color or Color3.fromRGB(0, 0, 0),
        ImageTransparency = props.Transparency or 0.45,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = math.max(0, (parent.ZIndex or 1) - 1),
    }, parent.Parent or parent)
    return s
end

