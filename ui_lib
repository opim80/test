function Library:InitNotificationStack()
    if self.NotifyStack and self.NotifyStack.Parent then return end
    local mount = getMountTarget()
    local notifGui = mk("ScreenGui", {
        Name = "BW_Notifications",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
    }, mount)

    self.NotifyStack = mk("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -20, 1, -20),
        Size = UDim2.fromOffset(300, 500),
        BackgroundTransparency = 1,
    }, notifGui)

    mk("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.NotifyStack)
end

function Library:Notify(props)
    props = props or {}
    local title = props.Title or "NOTIFICATION"
    local content = props.Content or ""
    local duration = props.Duration or 3.5
    local nType = string.lower(props.Type or "info")

    local typeColors = {
        info = Color3.fromRGB(99, 102, 241),
        success = Color3.fromRGB(34, 197, 94),
        warn = Color3.fromRGB(245, 158, 11),
        warning = Color3.fromRGB(245, 158, 11),
        error = Color3.fromRGB(239, 68, 68),
    }
    local barColor = typeColors[nType] or self.Accent

    self:InitNotificationStack()

    local item = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        Position = UDim2.fromOffset(80, 0),
        BackgroundColor3 = Color3.fromRGB(16, 19, 26),
        ClipsDescendants = true,
    }, self.NotifyStack)
    corner(item, 6)
    surfaceLight(item, Color3.fromRGB(24, 29, 40), Color3.fromRGB(14, 16, 22), 90)
    beveledStroke(item, Color3.fromRGB(75, 90, 120), Color3.fromRGB(20, 24, 32), 1)
    addUIShadow(item, { BlurRadius = UDim.new(0, 10), Offset = UDim2.fromOffset(0, 4), Transparency = 0.5 })

    local pillar = mk("Frame", {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = barColor,
        BorderSizePixel = 0,
    }, item)

    mk("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 8),
        Size = UDim2.new(1, -24, 0, 14),
        Font = Enum.Font.GothamBold,
        Text = string.upper(title),
        TextColor3 = Color3.fromRGB(241, 245, 249),
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, item)

    mk("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 24),
        Size = UDim2.new(1, -24, 0, 18),
        Font = Enum.Font.GothamMedium,
        Text = content,
        TextColor3 = Color3.fromRGB(156, 163, 175),
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, item)

    local countBar = mk("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 4, 1, 0),
        Size = UDim2.new(1, -4, 0, 2),
        BackgroundColor3 = barColor,
        BorderSizePixel = 0,
    }, item)

    TweenService:Create(item, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.fromOffset(0, 0)
    }):Play()

    TweenService:Create(countBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    task.delay(duration, function()
        if not item or not item.Parent then return end
        local fadeOut = TweenService:Create(item, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.fromOffset(60, 0),
            BackgroundTransparency = 1
        })
        fadeOut:Play()
        fadeOut.Completed:Connect(function() item:Destroy() end)
    end)
end

