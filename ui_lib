            -- ========================================================
            -- COMPONENT: RECESSED DRAGGABLE SLIDER
            -- ========================================================
            function SectionObj:CreateSlider(sConfig)
                sConfig = sConfig or {}
                local sName = sConfig.Name or "Slider"
                local sMin = sConfig.Min or 0
                local sMax = sConfig.Max or 100
                local sDefault = sConfig.Default or sMin
                local sSuffix = sConfig.Suffix or ""
                local sCallback = sConfig.Callback or function() end

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 50),
                    BackgroundColor3 = Color3.fromRGB(12, 14, 19),
                }, card)
                corner(row, 6)
                sunkenStroke(row, 1)

                row.MouseEnter:Connect(function()
                    TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(15, 18, 25) }):Play()
                end)
                row.MouseLeave:Connect(function()
                    TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(12, 14, 19) }):Play()
                end)

                mk("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(10, 8),
                    Size = UDim2.new(0.6, 0, 0, 16),
                    Font = Enum.Font.GothamMedium,
                    Text = sName,
                    TextColor3 = Color3.fromRGB(226, 232, 240),
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, row)

                local valLbl = mk("TextLabel", {
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -10, 0, 8),
                    Size = UDim2.fromOffset(80, 16),
                    Font = Enum.Font.GothamBold,
                    Text = tostring(sDefault) .. sSuffix,
                    TextColor3 = Color3.fromRGB(129, 140, 248),
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, row)

                local groove = mk("Frame", {
                    Position = UDim2.new(0, 10, 0, 32),
                    Size = UDim2.new(1, -20, 0, 6),
                    BackgroundColor3 = Color3.fromRGB(8, 9, 13),
                }, row)
                corner(groove, 3)
                sunkenStroke(groove, 1)

                local initFrac = math.clamp((sDefault - sMin) / math.max(1, sMax - sMin), 0, 1)
                local fill = mk("Frame", {
                    Size = UDim2.new(initFrac, 0, 1, 0),
                    BackgroundColor3 = accentCol,
                    ClipsDescendants = false,
                }, groove)
                corner(fill, 3)

                -- Moving Energy Conduit Light through Slider Fill
                movingGradient(fill, {
                    Rotation = 0,
                    Speed = 2.4,
                    PingPong = false,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(79, 70, 229)),
                        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(129, 140, 248)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(199, 215, 255)),
                        ColorSequenceKeypoint.new(0.55, Color3.fromRGB(129, 140, 248)),
                        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(79, 70, 229)),
                    }),
                })

                local thumb = mk("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(12, 12),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    ZIndex = 2,
                }, fill)
                corner(thumb, 6)
                beveledStroke(thumb, Color3.fromRGB(255, 255, 255), Color3.fromRGB(120, 130, 160), 1)

                local thumbShadow = addUIShadow(thumb, {
                    BlurRadius = UDim.new(0, 3),
                    Offset = UDim2.fromOffset(0, 1),
                    Transparency = 0.4,
                })

                local trigger = mk("TextButton", {
                    BackgroundTransparency = 1,
                    Size = UDim2.fromScale(1, 1),
                    Text = "",
                    ZIndex = 3,
                }, groove)

                local SliderControl = {
                    Value = sDefault,
                }

                local isDragging = false

                local function updateFrac(frac, animate, fire)
                    frac = math.clamp(frac, 0, 1)
                    local calculated = math.round(sMin + frac * (sMax - sMin))
                    SliderControl.Value = calculated
                    valLbl.Text = tostring(calculated) .. sSuffix

                    if animate then
                        TweenService:Create(fill, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.new(frac, 0, 1, 0)
                        }):Play()
                    else
                        fill.Size = UDim2.new(frac, 0, 1, 0)
                    end

                    if fire then
                        pcall(sCallback, calculated)
                    end
                end

                local function processInput(input)
                    local groovePos = groove.AbsolutePosition.X
                    local grooveSize = groove.AbsoluteSize.X
                    if grooveSize <= 0 then return end
                    local frac = (input.Position.X - groovePos) / grooveSize
                    updateFrac(frac, true, true)
                end

                trigger.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = true
                        processInput(input)
                        TweenService:Create(thumb, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(15, 15)
                        }):Play()
                        if thumbShadow and thumbShadow:IsA("UIShadow") then
                            TweenService:Create(thumbShadow, TweenInfo.new(0.12), {
                                BlurRadius = UDim.new(0, 6),
                                Transparency = 0.25,
                            }):Play()
                        end
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        processInput(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if isDragging then
                            isDragging = false
                            TweenService:Create(thumb, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                                Size = UDim2.fromOffset(12, 12)
                            }):Play()
                            if thumbShadow and thumbShadow:IsA("UIShadow") then
                                TweenService:Create(thumbShadow, TweenInfo.new(0.16), {
                                    BlurRadius = UDim.new(0, 3),
                                    Transparency = 0.4,
                                }):Play()
                            end
                        end
                    end
                end)

                function SliderControl:Set(val)
                    local frac = math.clamp((val - sMin) / math.max(1, sMax - sMin), 0, 1)
                    updateFrac(frac, true, true)
                end

                function SliderControl:Get()
                    return self.Value
                end

                return SliderControl
            end

