                    BackgroundTransparency = 1,
                    Size = UDim2.fromScale(1, 1),
                    Text = "",
                    ZIndex = 8,
                }, track)

                local ToggleControl = { Value = tDefault }

                local function applyState(val, fireCb)
                    ToggleControl.Value = val
                    if tFlag then Library.Flags[tFlag] = val end
                    TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
