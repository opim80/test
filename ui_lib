                    if triggerCallback then
                        pcall(tCallback, val)
                    end
                end

                trigger.MouseButton1Click:Connect(function()
                    applyState(not ToggleControl.Value, true)
                end)

                function ToggleControl:Set(val)
                    applyState(val == true, true)
                end

                function ToggleControl:Get()
                    return self.Value
