local function initParry()
    local lp = game:GetService("Players").LocalPlayer
    local VirtualInputManager = game:GetService("VirtualInputManager")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local oldNamecall
    
    local function fireParryEvent()
        -- Ensure the UI is loaded and the toggle is enabled
        if not Fluent or not Fluent.Options or not Fluent.Options.AutoParryToggle then return end
        if not Fluent.Options.AutoParryToggle.Value then return end
        
        pcall(function()
            local method = Fluent.Options.ParryMethod and Fluent.Options.ParryMethod.Value or "Keypress"
            
            if method == "Remote Event" then
                local args = { "unfair" }
                local eventsFolder = ReplicatedStorage:WaitForChild("events", 3)
                if eventsFolder then
                    local remote = eventsFolder:WaitForChild("remote", 3)
                    if remote then
                        remote:FireServer(unpack(args))
                    end
                end
            else
                local rawKey = Fluent.Options.ParryKeyBind and Fluent.Options.ParryKeyBind.Value or "J"
                local keyStr = string.upper(string.sub(rawKey, 1, 1)) -- Get the first char and uppercase it
                if keyStr == "" then keyStr = "J" end
                
                local vKeyCode = string.byte(keyStr)
                local enumKey = Enum.KeyCode[keyStr]
                
                if keypress then
                    keypress(vKeyCode)
                    task.wait(0.05)
                    keyrelease(vKeyCode)
                elseif enumKey then
                    VirtualInputManager:SendKeyEvent(true, enumKey, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, enumKey, false, game)
                end
            end
        end)
    end

    if not getgenv().OriginalNamecall then
        getgenv().OriginalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            if getgenv().CSMDH_Unloaded then return getgenv().OriginalNamecall(self, ...) end
            if getgenv().NamecallHandler then return getgenv().NamecallHandler(self, ...) end
            return getgenv().OriginalNamecall(self, ...)
        end)
    end

    getgenv().NamecallHandler = function(self, ...)
        local method = getnamecallmethod()
        local result = getgenv().OriginalNamecall(self, ...)
        
        local useRaycast = Fluent and Fluent.Options and Fluent.Options.AutoParryToggle and Fluent.Options.AutoParryToggle.Value
        if useRaycast and not checkcaller() then
            if method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                local hitPart = method == "Raycast" and (result and result.Instance) or result
                if typeof(hitPart) == "Instance" and lp.Character and hitPart:IsDescendantOf(lp.Character) then
                    
                    -- Adaptive Learning Logic (TimePosition version)
                    if Fluent and Fluent.Options and Fluent.Options.AdaptiveParryToggle and Fluent.Options.AdaptiveParryToggle.Value then
                        getgenv().PendingAnimations = getgenv().PendingAnimations or {}
                        for i = #getgenv().PendingAnimations, 1, -1 do
                            local data = getgenv().PendingAnimations[i]
                            if data.npc and data.npc:FindFirstChild("HumanoidRootPart") and lp.Character:FindFirstChild("HumanoidRootPart") then
                                local dist = (data.npc.HumanoidRootPart.Position - lp.Character.HumanoidRootPart.Position).Magnitude
                                if dist <= 15 then
                                    if data.track and not getgenv().LearnedTimings[data.animId] then
                                        local hitTime = data.track.TimePosition
                                        if hitTime > 0.05 then
                                            getgenv().LearnedTimings[data.animId] = hitTime
                                            if Fluent then
                                                Fluent:Notify({Title = "Learned Attack!", Content = "Mapped hit at TimePosition: " .. string.format("%.2f", hitTime) .. "s", Duration = 5})
                                            end
                                            customWarn("Learned Timing for " .. tostring(data.animId) .. " -> " .. hitTime .. "s")
                                        end
                                    end
                                    break
                                end
                            end
                        end
                    end
                    
                    fireParryEvent()
                end
            end
        end
        return result
    end
    
    local function setupAnimatorLogging(animator)
        if getgenv().CSMDH_HookedObjects and getgenv().CSMDH_HookedObjects[animator] then return end
        getgenv().CSMDH_HookedObjects = getgenv().CSMDH_HookedObjects or setmetatable({}, {__mode = "k"})
        getgenv().CSMDH_HookedObjects[animator] = true
        
        local character = animator
        while character and not character:IsA("Model") and character ~= workspace do
            character = character.Parent
        end
        if not character or character == workspace then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        getgenv().BlockedAnimations = getgenv().BlockedAnimations or {}
        local animateScript = character:FindFirstChild("aniamte(nolag)")
        if animateScript then
            for _, child in ipairs(animateScript:GetDescendants()) do
                if child:IsA("Animation") and child.AnimationId and child.AnimationId ~= "" then
                    getgenv().BlockedAnimations[child.AnimationId] = true
                end
            end
        end
        
        local function onAnimationPlayed(track)
            if getgenv().CSMDH_Unloaded then return end
            
            local animId = track.Animation and track.Animation.AnimationId
            if not animId or animId == "" then return end
            
            getgenv().BlockedAnimations = getgenv().BlockedAnimations or {}
            getgenv().LearnedTimings = getgenv().LearnedTimings or {}
            getgenv().PendingAnimations = getgenv().PendingAnimations or {}
            
            -- Cloud Timings Initialization
            local CLOUD_FILE = "CSMDH_CloudTimings.json"
            if not getgenv().CloudTimings then
                getgenv().CloudTimings = {}
                if isfile and readfile and isfile(CLOUD_FILE) then
                    pcall(function()
                        local data = game:GetService("HttpService"):JSONDecode(readfile(CLOUD_FILE))
                        if type(data) == "table" then getgenv().CloudTimings = data end
                    end)
                end
            end
            
            -- Cloud Scraper Logic (GetObjects)
            if not getgenv().CloudTimings[tostring(animId)] and not getgenv().BlockedAnimations[animId] and Fluent and Fluent.Options and Fluent.Options.CloudScraperToggle and Fluent.Options.CloudScraperToggle.Value then
                if not getgenv().CloudScrapeAttempts then getgenv().CloudScrapeAttempts = {} end
                if not getgenv().CloudScrapeAttempts[animId] then
                    getgenv().CloudScrapeAttempts[animId] = true
                    
                    if Fluent.Options.CloudScraperLogToggle and Fluent.Options.CloudScraperLogToggle.Value then
                        customWarn("CloudScraper: Attempting to download & scrape " .. tostring(animId))
                    end
                    
                    task.spawn(function()
                        local success, objects = pcall(function()
                            return game:GetObjects(animId)
                        end)
                        if success and objects and objects[1] and objects[1]:IsA("KeyframeSequence") then
                            local sequence = objects[1]
                            local hitTime = nil
                            
                            for _, desc in ipairs(sequence:GetDescendants()) do
                                if desc:IsA("KeyframeMarker") then
                                    local name = string.lower(desc.Name)
                                    if name == "hit" or name == "damage" or name == "attack" or name == "swing" then
                                        hitTime = desc.Parent.Time
                                        break
                                    end
                                end
                            end
                            
                            if not hitTime then
                                for _, desc in ipairs(sequence:GetChildren()) do
                                    if desc:IsA("Keyframe") then
                                        local name = string.lower(desc.Name)
                                        if name == "hit" or name == "damage" or name == "attack" then
                                            hitTime = desc.Time
                                            break
                                        end
                                    end
                                end
                            end
                            
                            if hitTime and hitTime > 0.05 then
                                getgenv().CloudTimings[tostring(animId)] = hitTime
                                if writefile then
                                    pcall(function()
                                        writefile(CLOUD_FILE, game:GetService("HttpService"):JSONEncode(getgenv().CloudTimings))
                                    end)
                                end
                                if Fluent then
                                    Fluent:Notify({Title = "Cloud Scraper", Content = "Saved Hit Frame to file: " .. string.format("%.2f", hitTime) .. "s", Duration = 5})
                                end
                                print("[CSMDH] SUCCESS! CloudScraper mapped " .. animId .. " -> " .. hitTime .. "s")
                                customWarn("✅ CloudScraper MAPPED: " .. animId .. " -> " .. hitTime .. "s")
                            else
                                if Fluent.Options.CloudScraperLogToggle and Fluent.Options.CloudScraperLogToggle.Value then
                                    customWarn("CloudScraper: Failed to find Hit frame in " .. tostring(animId))
                                end
                            end
                        end
                    end)
                end
            end
            
            local activeTiming = getgenv().LearnedTimings[animId] or getgenv().CloudTimings[tostring(animId)]
            if activeTiming and Fluent and Fluent.Options and Fluent.Options.AdaptiveParryToggle and Fluent.Options.AdaptiveParryToggle.Value then
                local hitTime = activeTiming
                local targetTime = hitTime - 0.1
                if targetTime < 0 then targetTime = 0 end
                
                local rsConn
                rsConn = game:GetService("RunService").RenderStepped:Connect(function()
                    if getgenv().CSMDH_Unloaded or not track.IsPlaying then 
                        rsConn:Disconnect() 
                        return 
                    end
                    if track.TimePosition >= targetTime then
                        fireParryEvent()
                        rsConn:Disconnect()
                    end
                end)
                table.insert(getgenv().ActiveConnections, rsConn)
            end
            
            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("HumanoidRootPart") then
                local dist = (lp.Character.HumanoidRootPart.Position - character.HumanoidRootPart.Position).Magnitude
                if dist <= 12 and not getgenv().BlockedAnimations[animId] then
                    table.insert(getgenv().PendingAnimations, {
                        npc = character,
                        animId = animId,
                        track = track,
                        startTime = os.clock()
                    })
                end
            end
            
            local folder = character:FindFirstChild("StoredAnimations")
            if not folder then
                folder = Instance.new("Folder")
                folder.Name = "StoredAnimations"
                folder.Parent = character
            end
            
            local exists = false
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("StringValue") and child.Value == tostring(animId) then
                    exists = true
                    break
                end
            end
            
            if not exists then
                local val = Instance.new("StringValue")
                val.Name = (track.Name ~= "" and track.Name) or "UnknownAnim"
                val.Value = tostring(animId)
                val.Parent = folder
            end
        end
        
        local conn = animator.AnimationPlayed:Connect(onAnimationPlayed)
        table.insert(getgenv().ActiveConnections, conn)
    end
    
    local function scanForAnimators(parent)
        local function checkObj(obj)
