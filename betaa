local function fetchServerData()
    local PlaceId = game.PlaceId
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")).data
    end)
    return success and result or {}
end

local function loadHistory()
    if isfile(SERVER_LOG_FILE) then
        return HttpService:JSONDecode(readfile(SERVER_LOG_FILE))
    end
    return {}
end

local function saveHistory(hist)
    writefile(SERVER_LOG_FILE, HttpService:JSONEncode(hist))
end

local function cleanHistory(hist, interval)
    local changed = false
    local now = os.time()
    for id, time in pairs(hist) do
        if (now - time) > (interval * 60) then 
            hist[id] = nil 
            changed = true
        end
    end
    return hist, changed
end

local function serverHop()
    cleanupMovement()
    restoreCamera()
    
    updateStatus("Hopping Server...")
    Fluent:Notify({Title = "Server Hop", Content = "Searching for new server...", Duration = 3})
    
    local JobId = game.JobId
    local PlaceId = game.PlaceId
    
    local history = loadHistory()
    history[JobId] = os.time() -- Log current
    
    local interval = Fluent.Options.ServerLogExpiry and Fluent.Options.ServerLogExpiry.Value or 30
    local _, _ = cleanHistory(history, interval)
    saveHistory(history)

    local servers = fetchServerData()
    local candidates = {}

    for _, s in ipairs(servers) do
        if s.playing < s.maxPlayers and s.id ~= JobId and not history[s.id] then
            table.insert(candidates, s)
        end
    end

    if #candidates > 0 then
        -- Randomize slightly to prevent bottle-necking 
        local target = candidates[math.random(1, math.min(3, #candidates))]
        TeleportService:TeleportToPlaceInstance(PlaceId, target.id)
    else
        -- NO SERVERS FOUND LOGIC
        updateStatus("Hop Failed: No Servers.")
        if Fluent.Options.HopperToggle.Value then
            Fluent.Options.HopperToggle:SetValue(false)
            sendWebhook("Automation Stopped", "No new servers available (List Exhausted).", 0xFF0000)
            Fluent:Notify({Title = "Stop", Content = "No valid servers remaining. Sending Webhook.", Duration = 5})
        else
             Fluent:Notify({Title = "Hop Failed", Content = "No valid servers found in list.", Duration = 3})
        end
    end
end

local function runFastMode()
    local map = workspace:FindFirstChild("map")
    if not map then return end
    
    local count = 0
    for _, desc in ipairs(map:GetDescendants()) do
        if desc:IsA("Texture") or desc:IsA("Decal") then
            desc:Destroy()
            count = count + 1
        end
    end
    Fluent:Notify({Title = "Perfomance", Content = "Deleted " .. count .. " textures.", Duration = 3})
end

local function runUltraFastMode()
    local map = workspace:FindFirstChild("map")
    local rokyo = map and map:FindFirstChild("Rokyo")
    if not rokyo then 
        Fluent:Notify({Title = "Error", Content = "Map/Rokyo folder not found.", Duration = 3})
        return 
    end

    local count = 0
    for _, child in ipairs(rokyo:GetChildren()) do
        -- Preserve Collision, Preserve Hearts (MeshId check)
        if child.Name ~= "Collision Group" then
            local isHeart = false
            if child:IsA("MeshPart") and child.MeshId == MESH_ID_TARGET then
                isHeart = true
            end
            
            if not isHeart then
                child:Destroy()
                count = count + 1
            end
        end
    end
    Fluent:Notify({Title = "ULTRA Fast", Content = "Deleted " .. count .. " map objects.", Duration = 3})
end

