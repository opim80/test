local function collectHeart(targetPart)
    if not targetPart then return end
    updateStatus("Interaction: Collecting...")
    
    local prompt = targetPart:FindFirstChildOfClass("ProximityPrompt") or targetPart.Parent:FindFirstChildOfClass("ProximityPrompt")

    if prompt then
        local t = prompt.HoldDuration
        if fireproximityprompt then
            fireproximityprompt(prompt)
            if t > 0 then task.wait(t + 0.05) end
        else
            prompt:InputHoldBegin()
            task.wait(t + 0.1)
            prompt:InputHoldEnd()
        end
        updateStatus("Collected!")
        Fluent:Notify({Title = "Automation", Content = "Heart Collected.", Duration = 3})
    else
        updateStatus("Error: No Prompt Found")
    end
end

local function performTweenSegment(targetPos)
    if stopRequested then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local dist = (root.Position - targetPos).Magnitude
    if dist < 0.5 then return end

    local speed = Fluent.Options.UseSTPS.Value and Fluent.Options.STPSValue.Value or 30
    local duration = dist / speed
    if not Fluent.Options.UseSTPS.Value then
        local spdF = tonumber(Fluent.Options.TweenSpeed.Value) or 0.5
        duration = (spdF * dist) / 100
    end
    if duration < 0.1 then duration = 0.1 end

    local info = TweenInfo.new(duration, Enum.EasingStyle[Fluent.Options.TweenEasing.Value], Enum.EasingDirection.Out)
    local tween = TweenService:Create(root, info, {CFrame = CFrame.new(targetPos)})
    
    table.insert(activeTweens, tween)
    tween:Play()
    tween.Completed:Wait()
    
    for i = #activeTweens, 1, -1 do
        if activeTweens[i] == tween then table.remove(activeTweens, i) break end
    end
end

local function startStagedTween(finalTarget, targetObject)
    cleanupMovement()
    stopRequested = false
    watchdogStart = tick() 
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then return end

    velocityConnection = RunService.Stepped:Connect(function()
        if root and root.Parent then
            root.Velocity = Vector3.new(0, 0, 0)
        end
    end)
    
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    if hum.Sit then hum.Sit = false end

    local function moveTo(goal, desc)
        updateStatus("Moving: " .. desc)
        local startTime = tick()
        local stuckPoints = 0
        local lastPos = root.Position
        
        while (root.Position - goal).Magnitude > 2 and not stopRequested do
            if (tick() - watchdogStart) > MAX_STUCK_TIME_GLOBAL then
                 updateStatus("Error: Global Timeout")
                 stopRequested = true
                 cleanupMovement()
                 serverHop() 
                 return false
            end
            
            if (tick() - startTime) > MAX_PF_TIME then
                updateStatus("Error: Segment Timeout")
                stopRequested = true
                cleanupMovement()
                return false
            end

            if (root.Position - lastPos).Magnitude < 0.2 then
                stuckPoints = stuckPoints + 1
            else
                stuckPoints = 0
                lastPos = root.Position
            end

            if stuckPoints > 15 then
                updateStatus("Stuck: Unstucking...")
                root.CFrame = root.CFrame + Vector3.new(0, 2, 0)
                stuckPoints = 0
            end

            local vecToGoal = (goal - root.Position)
            local distRemaining = vecToGoal.Magnitude
            local stepSize = tonumber(Fluent.Options.TweenDist.Value)
            local nextTarget = goal

            if Fluent.Options.SegmentToggle.Value and distRemaining > stepSize then
                nextTarget = root.Position + (vecToGoal.Unit * stepSize)
            end

            local useGround = Fluent.Options.GroundFollow.Value
            if useGround then
                local gPos = getGroundPosition(nextTarget.X, nextTarget.Z)
                if gPos then
                    nextTarget = Vector3.new(nextTarget.X, gPos.Y + ALIGNMENT_OFFSET, nextTarget.Z)
                else
                    if nextTarget.Y < MIN_Y_LIMIT then nextTarget = Vector3.new(nextTarget.X, MIN_Y_LIMIT, nextTarget.Z) end
                end
            else
                if nextTarget.Y < MIN_Y_LIMIT then nextTarget = Vector3.new(nextTarget.X, MIN_Y_LIMIT, nextTarget.Z) end
            end

            performTweenSegment(nextTarget)
            
            if Fluent.Options.SegmentToggle.Value and (root.Position - goal).Magnitude > 2 and not stopRequested then
                local pause = Fluent.Options.TweenInterval.Value
                if not Fluent.Options.SegmentDrop.Value then
                    root.Anchored = true
                end
                task.wait(pause)
                root.Anchored = false
            end
        end
        return true
    end

    local success = true

    if Fluent.Options.SplitToggle.Value then
        local flatTarget = Vector3.new(finalTarget.X, math.max(root.Position.Y, MIN_Y_LIMIT), finalTarget.Z)
        if Fluent.Options.GroundFollow.Value then
             flatTarget = Vector3.new(finalTarget.X, root.Position.Y, finalTarget.Z) 
        end
        success = moveTo(flatTarget, "XZ Align")
        if success and not stopRequested then
            success = moveTo(finalTarget, "Final Approach")
        end
    else
        success = moveTo(finalTarget, "Direct")
    end

    cleanupMovement()
    
    if not stopRequested and success then
        root.CFrame = CFrame.new(finalTarget)
        task.wait(0.1)
        collectHeart(targetObject)
    elseif not success then
        updateStatus("Movement Logic Failed")
    end
end

-- [[ CORE HOPPER LOOP ]]

local function runHopperLogic()
    if isHopperRunning then return end
    isHopperRunning = true
    updateStatus("Hopper Engine: Active")

    task.spawn(function()
        while Fluent.Options.HopperToggle.Value do
            local status, heartPos, heartObj = findDevilHeart()
            updateHeartStats(heartObj)

            local myHearts = getHeartCount()
            local limit = Fluent.Options.MaxHeartLimit.Value
            
            if status == "Valid" then
                updateStatus("Heart Validated! Target set.")
                
                if checkPathCollision(heartPos) then
                    sendWebhook("Collision", "Blocked by invisible wall", 0xFF6600)
                    serverHop() 
                elseif myHearts >= limit and not Fluent.Options.TweenOnMax.Value then
                    sendWebhook("Inventory Full", "Skipping valid heart", 0x00AAFF)
                    serverHop()
                else
                    sendWebhook("Heart Found", "Tweening to target...", 0x00FF00)
                    if Fluent.Options.AutoTweenOnFind.Value then
                        startStagedTween(heartPos, heartObj)
                    end
                    if not Fluent.Options.HopperToggle.Value then break end
                    
                    if status == "Valid" and heartObj:IsDescendantOf(workspace) then
                         updateStatus("Failed to Collect. Hopping.")
                         serverHop()
                    end
                end

            elseif status == "Floating" or status == "Buried" or status == "ACBait" then
                sendWebhook("Bait/Invalid", "Reason: " .. status, 0xFF0000)
                updateStatus("Invalid Heart ("..status.."). Hopping...")
                task.wait(1)
                serverHop()
            else
                updateStatus("No Heart Found. Hopping...")
                task.wait(1)
                serverHop()
            end

            task.wait(2)
        end
        isHopperRunning = false
    end)
end

