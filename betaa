local function populateServerList()
    Fluent:Notify({Title = "Loading", Content = "Fetching servers... Lag spike expected.", Duration = 2})
    
    local servers = fetchServerData()
    local history = loadHistory()
    local now = os.time()
    local expiryMin = Fluent.Options.ServerLogExpiry and Fluent.Options.ServerLogExpiry.Value or 30

    local validCount = 0
    local cachedCount = 0
    
    Tabs.ServerList:AddSection("Joinable Servers")
    
    for _, s in ipairs(servers) do
        if not history[s.id] and s.id ~= game.JobId and s.playing < s.maxPlayers then
            validCount = validCount + 1
            Tabs.ServerList:AddButton({
                Title = "Join: " .. s.playing .. "/" .. s.maxPlayers .. " Ping: " .. s.ping,
                Description = "ID: " .. s.id:sub(1,8).."...",
                Callback = function()
                     TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id)
                end
            })
        end
    end

    Tabs.ServerList:AddSection("Cached / Cooldown Servers")

    for id, time in pairs(history) do
        cachedCount = cachedCount + 1
        local elapsed = (now - time) / 60
        local remaining = expiryMin - elapsed
        local statusText = ""
        
        if remaining > 0 then
            statusText = "Expires in " .. math.floor(remaining*10)/10 .. " min"
        else
            statusText = "EXPIRED (Ready to join)"
        end
        
        Tabs.ServerList:AddParagraph({
            Title = "Server: " .. id:sub(1,8).."...",
            Content = statusText
        })
    end
    
    ServerCountLabel:SetTitle("Servers Loaded: " .. validCount + cachedCount)
    ServerCountLabel:SetDesc("Joinable: " .. validCount .. " | Cached: " .. cachedCount)
end

