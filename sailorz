end

-- [[ HELPER FUNCTIONS ]]
local function setStatus(currently, nextUp)
    if KaitunStatusDisplay then 
        KaitunStatusDisplay:SetDesc("**Currently:** " .. currently .. "\n**Next Up:** " .. nextUp)
    end
end

local function parseNumberSuffix(str)
    if not str then return 0 end
    str = string.lower(string.gsub(tostring(str), "[, ]", ""))
    local mult = 1
    if string.find(str, "k") then mult = 1e3 str = string.gsub(str, "k", "")
    elseif string.find(str, "m") then mult = 1e6 str = string.gsub(str, "m", "")
    elseif string.find(str, "b") then mult = 1e9 str = string.gsub(str, "b", "") end
    return (tonumber(str) or 0) * mult
end

-- [[ MOVEMENT ENGINE (NOCLIP & SAFE Y-TWEENING) ]]
local function startMovementEngine()
    if movementTask then movementTask:Disconnect(); movementTask = nil end
    local char = LocalPlayer.Character
    local hrp = char and char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    local speed = 80 -- Global tween speed

    movementTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        
        -- Break Velocity & Anti-Fling
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        
        -- Force Noclip
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end

        if targetPosition then
            local currentPos = hrp.Position
            local dist3D = (targetPosition - currentPos).Magnitude
            local dist2D = Vector3.new(targetPosition.X - currentPos.X, 0, targetPosition.Z - currentPos.Z).Magnitude
            
            local nextPos = currentPos
            
            if dist3D > 3 then
                -- The "Safe Flight" logic to prevent going under the map
                local desiredY = currentPos.Y
                
                if dist2D > 15 then
                    -- If we have to travel far, fly 50 studs above the target to clear obstacles
                    desiredY = targetPosition.Y + 50 
                else
                    -- Once directly above the target, lower down to its exact Y coordinate
                    desiredY = targetPosition.Y
                end
                
                local safeTarget3D = Vector3.new(targetPosition.X, desiredY, targetPosition.Z)
                local direction = (safeTarget3D - currentPos)
                
                if direction.Magnitude > speed * deltaTime then
                    nextPos = currentPos + direction.Unit * speed * deltaTime
                else
                    nextPos = safeTarget3D
                end
                
                hrp.CFrame = CFrame.new(nextPos)
            else
                -- Arrived at target
                hrp.CFrame = CFrame.new(targetPosition)
            end
        else
            -- If no target, hover safely slightly above ground
            local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
            local _, groundPos = workspace:FindPartOnRay(ray, char)
            local targetY = groundPos and (groundPos.Y + 15) or hrp.Position.Y
            hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15, hrp.Position.Z)
        end
    end)
end

-- [[ FAST TRAVEL SYSTEM (CACHE-BASED) ]]
local function getCurrentIslandName()
    -- Deduce current island by finding the closest cached portal
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return "Starter" end
    
    local closestIsland = "Starter"
    local closestDist = math.huge
    
    for islandName, portalPos in pairs(WorldCache.Portals) do
        local dist = (hrp.Position - portalPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closestIsland = islandName
        end
    end
    return closestIsland
end

local function executeFastTravel(destinationIsland)
    if destinationIsland == "" then return false end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local currentIsland = getCurrentIslandName()
    
    if currentIsland == destinationIsland then
        return true -- Already on the right island
    end

    setStatus("Traveling to " .. destinationIsland, "Going to " .. currentIsland .. " Portal")
    
    -- Step 1: Do we know where the local portal is?
    local localPortalPos = WorldCache.Portals[currentIsland]
    
    if not localPortalPos then
        -- Failsafe: Only reset if the cache is totally empty or broken
        setStatus("No local portal cached.", "Resetting character to bypass StreamingEnabled")
        targetPosition = nil
        char.Humanoid.Health = 0
        LocalPlayer.CharacterAdded:Wait()
        local newChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        hrp = newChar:WaitForChild("HumanoidRootPart", 10)
        task.wait(2) 
        
        -- Try to find any portal nearby to bootstrap the teleport
        local fallbackPortal = nil
        for _, obj in ipairs(workspace:GetDescendants()) do
            if string.find(string.lower(obj.Name), "portal_") then
                fallbackPortal = obj
                break
            end
        end
        if fallbackPortal then
            localPortalPos = fallbackPortal:IsA("Model") and fallbackPortal:GetPivot().Position or fallbackPortal.Position
        else
            return false -- Absolute failure
        end
    end

    -- Step 2: Tween to Local Portal
    targetPosition = localPortalPos
    while (hrp.Position - localPortalPos).Magnitude > 5 do
        task.wait(0.1) -- Wait for movement engine to get us there
    end
    
    -- Step 3: Fire Teleport Remote
    setStatus("At Portal", "Teleporting to " .. destinationIsland)
    pcall(function()
        local args = { destinationIsland }
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
    end)
    
    -- Step 4: Wait for Chunks
    targetPosition = nil -- Pause movement so we don't fly off into the void
    task.wait(3.5)
    
    return true
end

-- [[ KAITUN CACHE INITIALIZER ]]
local function buildWorldCache()
    isInitializingCache = true
    startMovementEngine()
    
    setStatus("Initializing Map Cache", "Clearing active quests")
    
    -- Abandon existing quests to ensure we can accept new ones
    pcall(function() 
        local args = {"repeatable"}
        ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(args)) 
    end)
    task.wait(0.5)

    for _, island in ipairs(WorldCache.Islands) do
        if not kaitunActive then break end
        
        setStatus("Caching: " .. island, "Fast Traveling")
        executeFastTravel(island)
        
        local serviceNPCs = workspace:WaitForChild("ServiceNPCs", 5)
        if not serviceNPCs then continue end

        -- Save the Portal position for this island
        for _, obj in ipairs(workspace:GetDescendants()) do
            if string.find(string.lower(obj.Name), "portal_") then
                WorldCache.Portals[island] = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                break
            end
        end
        
        -- Scan all Quests
        for i = 1, 19 do
            local npcName = "QuestNPC" .. i
            local npc = serviceNPCs:FindFirstChild(npcName)
            
            if npc and not WorldCache.Quests[npcName] then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                local prompt = hrp and hrp:FindFirstChild("QuestPrompt")
                
                if prompt and hrp then
                    local cachedPos = hrp.Position
                    
                    setStatus("Caching " .. npcName, "Reading Prompt")
                    -- Tween to the NPC
                    targetPosition = cachedPos
                    while (LocalPlayer.Character.HumanoidRootPart.Position - cachedPos).Magnitude > 10 do task.wait(0.1) end
                    
                    local text = prompt.ObjectText or ""
                    local minLvl, maxLvl = string.match(text, "(%d+)%s*%-%s*(%d+)")
                    if not minLvl then 
                        minLvl = string.match(text, "(%d+)%+") 
                        maxLvl = 9999999 
                    end
                    
                    minLvl = tonumber(minLvl) or 0
                    maxLvl = tonumber(maxLvl) or 9999999
                    
                    setStatus("Caching " .. npcName, "Reading Quest UI")
                    pcall(function() ReplicatedStorage.RemoteEvents.QuestAccept:FireServer(npcName) end)
                    task.wait(1.5)
                    
                    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local questUI = pGui and pGui:FindFirstChild("QuestUI")
                    local qFrame = questUI and questUI:FindFirstChild("Quest")
                    
                    if qFrame and qFrame.Visible then
                        local reqText = qFrame.Quest.Holder.Content.QuestInfo.QuestRequirement.Text 
                        local expText = qFrame.Reward.RewardExp.CurrencyIndicator.Text 
                        local targetMobRaw = qFrame.Quest.Holder.Content.QuestInfo..QuestTitle.QuestTitle.Text 
                        
                        local extractedMob = string.match(targetMobRaw, "Defeat the (.*)'s!") or string.match(targetMobRaw, "Defeat (.*)!") or "Unknown"
                        local reqKills = tonumber(string.match(reqText, "%d+/(%d+)")) or 1
                        local expReward = parseNumberSuffix(expText)
                        
                        WorldCache.Quests[npcName] = {
                            Position = cachedPos,
                            Island = island,
                            MinLvl = minLvl,
                            MaxLvl = maxLvl,
                            TargetMob = extractedMob,
                            ReqKills = reqKills,
                            ExpReward = expReward
                        }
                    end
                    
                    -- Force abandon to clear the slot
                    pcall(function() 
                        local args = {"repeatable"}
                        ReplicatedStorage.RemoteEvents.QuestAbandon:FireServer(unpack(args)) 
                    end)
                    task.wait(0.5)
                end
            end
        end
    end
    
    if kaitunActive then
        cacheIsBuilt = true
        setStatus("Cache Built Successfully!", "Ready for Calculation")
    end
    isInitializingCache = false
    targetPosition = nil
end

-- [[ KAITUN ALGORITHM ]]
local function updatePlayerDamage()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local dmgLabel = pGui:FindFirstChild("DamageCounterUI") 
            and pGui.DamageCounterUI:FindFirstChild("DamageFrame") 
            and pGui.DamageCounterUI.DamageFrame:FindFirstChild("Holder") 
            and pGui.DamageCounterUI.DamageFrame.Holder:FindFirstChild("StatFrame")
            and pGui.DamageCounterUI.DamageFrame.Holder.StatFrame:FindFirstChild("DamageLabel")
            
        if dmgLabel and dmgLabel.Text ~= "" then
            cachedDamage = parseNumberSuffix(dmgLabel.Text)
            if cachedDamage <= 0 then cachedDamage = 1 end
        end
    end
end

local function calculateOptimalQuest()
    local pLevel = tonumber(LocalPlayer.Data.Level.Value) or 0
    local bestQuest = nil
    local bestEfficiency = -1
    
    for questName, data in pairs(WorldCache.Quests) do
        if pLevel >= data.MinLvl and pLevel <= data.MaxLvl then
            -- Estimated algorithm: Assumes mob health scales roughly with its level requirement
            local estimatedMobHealth = data.MinLvl * 50 
            local hitsToKill = math.ceil(estimatedMobHealth / cachedDamage)
            local timePerKill = hitsToKill * 0.4 -- 0.4s per M1
            local totalTime = timePerKill * data.ReqKills
            
            if totalTime == 0 then totalTime = 1 end
            local efficiency = data.ExpReward / totalTime
            
            if efficiency > bestEfficiency then
                bestEfficiency = efficiency
                bestQuest = questName
            end
        end
    end
    return bestQuest
end

-- [[ THE MASTER LOOP ]]
local function executeKaitunCycle()
    if kaitunTask then task.cancel(kaitunTask) end
    startMovementEngine()

    kaitunTask = task.spawn(function()
        local hitRemote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        
        while kaitunActive do
            if not cacheIsBuilt then
                buildWorldCache()
                task.wait(1)
                continue
            end

            updatePlayerDamage()
            
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local questUI = pGui and pGui:FindFirstChild("QuestUI")
            local hasActiveQuest = questUI and questUI:FindFirstChild("Quest") and questUI.Quest.Visible
            
            if not hasActiveQuest then
                -- 1. Need a Quest
                setStatus("Calculating Best Quest...", "Finding target")
                local optQuestName = calculateOptimalQuest()
                
                if optQuestName then
                    local qData = WorldCache.Quests[optQuestName]
                    currentKaitunTargetMob = qData.TargetMob
                    
                    setStatus("Decided: " .. optQuestName, "Traveling to " .. qData.Island)
                    executeFastTravel(qData.Island)
                    
                    setStatus("On Island", "Tweening to " .. optQuestName)
                    targetPosition = qData.Position
                    
                    -- Wait until we are physically at the cached Vector3 of the NPC
                    while LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - qData.Position).Magnitude > 15 do
                        task.wait(0.1)
                    end
                    
                    setStatus("At NPC", "Accepting Quest")
                    pcall(function() ReplicatedStorage.RemoteEvents.QuestAccept:FireServer(optQuestName) end)
                    task.wait(1.5)
                else
                    setStatus("No suitable quests found for Level " .. tostring(LocalPlayer.Data.Level.Value), "Idling")
                    targetPosition = nil
                    task.wait(1)
                end
            else
                -- 2. Have Quest, Time to Farm
                if currentKaitunTargetMob == "" then
                    local qTitle = pGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestTitle.Text
                    currentKaitunTargetMob = string.match(qTitle, "Defeat the (.*)'s!") or string.match(qTitle, "Defeat (.*)!") or ""
                end
                
                setStatus("Hunting " .. currentKaitunTargetMob, "Scanning Workspace")
                
                local npcFolder = workspace:FindFirstChild("NPCs")
                if not npcFolder then task.wait(0.5) continue end
                
                local bestTarget = nil
                local closestDist = math.huge
                local charPos = LocalPlayer.Character:GetPivot().Position
                
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    local hum = npc:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        if string.find(string.lower(npc.Name), string.lower(currentKaitunTargetMob)) then
                            local dist = (charPos - npc:GetPivot().Position).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                bestTarget = npc
                            end
                        end
                    end
                end
                
                if bestTarget then
                    local hum = bestTarget:FindFirstChild("Humanoid")
                    while kaitunActive and bestTarget and bestTarget.Parent and hum and hum.Health > 0 do
                        local tPart = bestTarget:FindFirstChild("HumanoidRootPart") or bestTarget.PrimaryPart
                        if tPart then
                            targetPosition = tPart.Position -- Move engine will dynamically fly to this mob
                            setStatus("Attacking " .. bestTarget.Name, "HP: " .. tostring(math.floor(hum.Health)))
                            
                            pcall(function()
                                local args = {}
                                if vectorMethod == "Vector3.new" then args = {Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)}
                                elseif vectorMethod == "Raw Vector3" then args = {tPart.Position}
                                else args = {vector.create(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)} end
                                hitRemote:FireServer(unpack(args))
                            end)
                        end
                        task.wait(0.35)
                    end
                else
                    setStatus("No " .. currentKaitunTargetMob .. " found", "Waiting for spawns")
                    targetPosition = nil
                    task.wait(1)
                end
            end
        end
    end)
end

