-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function parseExp(str)
    str = string.lower(tostring(str))
    local num = tonumber(string.match(str, "[%d%.]+")) or 0
    if string.find(str, "k") then num = num * 1000
    elseif string.find(str, "m") then num = num * 1000000
    elseif string.find(str, "b") then num = num * 1000000000 end
    return num
end

local function getUIElements()
    local pGui = LocalPlayer:WaitForChild("PlayerGui")
    return {
        RewardExp = pGui:FindFirstChild("QuestUI") and pGui.QuestUI.Quest.Reward.RewardExp.CurrencyIndicator,
        QuestReq = pGui:FindFirstChild("QuestUI") and pGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement,
        DamageLabel = pGui:FindFirstChild("DamageCounterUI") and pGui.DamageCounterUI.DamageFrame.Holder.StatFrame.DamageLabel
    }
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    
    if tool and humanoid and tool.Parent ~= char then 
        humanoid:EquipTool(tool) 
    end
end

local function getBaseName(name)
    return string.gsub(name, "[_%s%d]+$", "")
end

local function isMobSelected(rawName)
    if killAllActive then return true end
    if killAllBossesActive and string.find(string.lower(rawName), "boss_") then return true end
    
    local baseName = getBaseName(rawName)
    if type(selectedMobs) == "table" then
        if selectedMobs[rawName] or selectedMobs[baseName] then return true end
        for selectedName, state in pairs(selectedMobs) do
            if state and (string.find(string.lower(rawName), string.lower(selectedName))) then
                return true
            end
        end
    end
    return false
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

-- [[ TRAVERSAL SYSTEM (STREAMING ENABLED) ]]
local function getClosestIsland(targetPos)
    -- Placeholder logic: In a real scenario, you'd map coordinate boundaries to islands.
    -- Defaulting to Starter if unknown to prevent nil errors.
    return "Starter" 
end

local function smartTravel(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - targetPos).Magnitude
    
    if dist > 3000 then 
        updateStatus("Target out of render bounds. Resetting for fast travel...")
        char:BreakJoints()
        LocalPlayer.CharacterAdded:Wait()
        task.wait(1)
        char = LocalPlayer.Character
        hrp = char:WaitForChild("HumanoidRootPart")
        
        local targetIsland = getClosestIsland(targetPos)
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(targetIsland)
        task.wait(3.5) -- Mandatory Portal Cooldown
    end

    -- In-Render Tweening
    local moveVector = (targetPos - hrp.Position).Unit
    hrp.CFrame = CFrame.new(hrp.Position + (moveVector * backupTweenSpeed * task.wait()))
end

-- [[ KAITUN INITIALIZATION & EFFICIENCY MATH ]]
local function evaluateDamage()
    local UIElements = getUIElements()
    if UIElements.DamageLabel then
        local dmgText = UIElements.DamageLabel.Text
        local parsed = parseExp(dmgText)
        if parsed > 0 then
            PlayerData.AverageDamage = parsed
        end
    end
end

local function calculateQuestEfficiency(questData, mobHealth)
    local hitsToKill = math.ceil(mobHealth / PlayerData.AverageDamage)
    local timeToKill = hitsToKill * PlayerData.M1Speed
    local totalTime = timeToKill * questData.Requirement
    
    if totalTime <= 0 then return 0 end
    return questData.RewardExp / totalTime -- Exp Per Second
end

local function cacheWorldData()
    task.spawn(function()
        updateStatus("Caching World Data... (This may take a moment)")
        
        -- Cache Portals
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name:match("^portal_") and obj:IsA("BasePart") then
                table.insert(Cache.Portals, obj.Position)
            end
        end

        -- Visit Quests (Simulated Traversal due to limitations in script execution time)
        local serviceNPCs = workspace:FindFirstChild("ServiceNPCs")
        if serviceNPCs then
            for i = 1, 19 do
                local npc = serviceNPCs:FindFirstChild("QuestNPC" .. i)
                if npc then
                    local prompt = npc:FindFirstChild("QuestPrompt", true)
                    if prompt then
                        -- Cache Basic Data
                        Cache.Quests[npc.Name] = {
                            NPC = npc,
                            MinLevel = 1, -- Parsed from prompt.ObjectText in full version
                            RewardExp = 0,
                            Requirement = 1,
                            TargetMob = ""
                        }
                    end
                end
            end
        end
        Cache.Initialized = true
        updateStatus("Cache Complete. Ready for Kaitun.")
    end)
end

