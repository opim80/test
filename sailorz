local function getBaseName(name)
    return string.gsub(name, "[_%s%d]+$", "")
end

local function isMobSelected(rawName)
    if not rawName then return false end
    if killTimedBossesActive and string.find(string.lower(rawName), "boss_") then return true end
    if killAllActive then return true end
    
    if kaitunActive and currentKaitunTargetMob ~= "" then
        if string.find(string.lower(rawName), string.lower(currentKaitunTargetMob)) then return true end
        return false
    end
    
    local baseName = getBaseName(rawName)
    if type(selectedMobs) == "table" then
        if selectedMobs[rawName] or selectedMobs[baseName] then return true end
        for selectedName, state in pairs(selectedMobs) do
            if state and (string.find(string.lower(rawName), string.lower(selectedName))) then return true end
        end
    end
    return false
end

local function getTargetPart(npc)
    if not npc then return nil end
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function getWeapons()
    local weapons = {}
    if LocalPlayer.Backpack then
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then table.insert(weapons, tool.Name) end
        end
    end
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then table.insert(weapons, tool.Name) end
        end
    end
    if selectedWeapon ~= "" and not table.find(weapons, selectedWeapon) then table.insert(weapons, selectedWeapon) end
    return weapons
end

local function getAvailableMobs()
    local mobs = {}
    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in ipairs(npcFolder:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local baseName = getBaseName(npc.Name)
                if not table.find(mobs, baseName) then table.insert(mobs, baseName) end
            end
        end
    end
    return mobs
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    if tool and humanoid and tool.Parent ~= char then humanoid:EquipTool(tool) end
end

local function parseNumberSuffix(str)
    if not str then return 0 end
    str = string.lower(string.gsub(tostring(str), "[, ]", ""))
    local mult = 1
    if string.find(str, "k") then mult = 1e3 str = string.gsub(str, "k", "")
    elseif string.find(str, "m") then mult = 1e6 str = string.gsub(str, "m", "")
    elseif string.find(str, "b") then mult = 1e9 str = string.gsub(str, "b", "") end
    return (tonumber(str) or 0) * mult
end

local function getCenterPosition()
    local npcFolder = workspace:FindFirstChild("NPCs")
    if not npcFolder then return nil end
    
    local normalSumPos = Vector3.zero
    local normalCount = 0
    local bossSumPos = Vector3.zero
    local bossCount = 0
    
    for _, npc in ipairs(npcFolder:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 and isMobSelected(npc.Name) then
            local tPos = npc:GetPivot().Position
            if string.find(string.lower(npc.Name), "boss_") then
                bossSumPos = bossSumPos + tPos
                bossCount = bossCount + 1
            else
                normalSumPos = normalSumPos + tPos
                normalCount = normalCount + 1
            end
        end
    end
    
    if bossCount > 0 then return bossSumPos / bossCount end
    if normalCount > 0 then return normalSumPos / normalCount end
    return nil
end

local function getLocalPortal()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(obj.Name), "portal_") then
            return obj
        end
    end
    return nil
end

-- [[ CORE MOVEMENT ENGINE (SAFELY TWEENS TO TARGETPOSITION OR CENTER) ]]
local function startDynamicMovement()
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    local char = LocalPlayer.Character
    local hrp = char and char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    evasionTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        
        -- Disable collision to prevent getting stuck while tweening
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
        
        local nextX, nextY, nextZ = hrp.Position.X, hrp.Position.Y, hrp.Position.Z
        
        if bounceActive then
            bounceTimer = bounceTimer + deltaTime
            if bounceTimer >= 2 then bounceUp = not bounceUp bounceTimer = 0 end
        end
        
        local bounceOffset = (bounceActive and bounceUp) and 10 or 0

        -- 1. High Priority: Explicit Target Coordinate (Used heavily by Kaitun)
        if targetPosition then
            local dist2D = Vector3.new(targetPosition.X - hrp.Position.X, 0, targetPosition.Z - hrp.Position.Z).Magnitude
            local dist3D = (targetPosition - hrp.Position).Magnitude
            
            if dist3D > 3 then
                local safeY = targetPosition.Y
                -- Fly 50 studs high if far away to avoid clipping through ground/buildings
                if dist2D > 15 then
                    safeY = targetPosition.Y + 50
                end
                
                local safeTarget = Vector3.new(targetPosition.X, safeY, targetPosition.Z)
                local direction = (safeTarget - hrp.Position)
                
                if direction.Magnitude > backupTweenSpeed * deltaTime then
                    local step = direction.Unit * backupTweenSpeed * deltaTime
                    nextX = hrp.Position.X + step.X
                    nextY = hrp.Position.Y + step.Y
                    nextZ = hrp.Position.Z + step.Z
                else
                    nextX, nextY, nextZ = safeTarget.X, safeTarget.Y, safeTarget.Z
                end
            else
                nextX, nextY, nextZ = targetPosition.X, targetPosition.Y, targetPosition.Z
            end
            
            hrp.CFrame = CFrame.new(nextX, nextY + bounceOffset, nextZ)
            return
        end

        -- 2. Lower Priority: Target Mobs or AlwaysTakeCenter (Used by Combat)
        local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
        local _, groundPos = workspace:FindPartOnRay(ray, char)
        local baseHeight = groundPos and (groundPos.Y + 20) or hrp.Position.Y
        local targetY = baseHeight + bounceOffset
        
        local moveTarget = currentTarget and currentTarget:GetPivot().Position
        if alwaysTakeCenterActive and not kaitunActive then
            if tick() - lastCenterUpdate >= centerUpdateInterval then
                calculatedCenter = getCenterPosition()
                lastCenterUpdate = tick()
            end
            moveTarget = calculatedCenter or moveTarget
        end
        
        if moveTarget and not getTargetPart(currentTarget) then
            local direction = (Vector3.new(moveTarget.X, moveTarget.Y + 20, moveTarget.Z) - hrp.Position)
            if direction.Magnitude > 1 then
                local stepDist = backupTweenSpeed * deltaTime
                if stepDist > direction.Magnitude then stepDist = direction.Magnitude end
                local step = direction.Unit * stepDist
                nextX = hrp.Position.X + step.X
                nextZ = hrp.Position.Z + step.Z
            end
        end
        
        local smoothY = hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15
        hrp.CFrame = CFrame.new(nextX, smoothY, nextZ)
    end)
end

