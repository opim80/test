-- [[ CORE MOVEMENT ENGINE (NOCLIP & CACHE AWARE) ]]
local function startDynamicMovement()
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    local char = LocalPlayer.Character
    local hrp = char and char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    evasionTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        
        -- STRICT NOCLIP AND VELOCITY KILLER
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
        
        local nextX, nextY, nextZ = hrp.Position.X, hrp.Position.Y, hrp.Position.Z
        
        -- Raycast to find ground safely
        local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
        local _, groundPos = workspace:FindPartOnRay(ray, char)
        
        -- Master target resolution (Blind Cache vs Live Entity)
        local activeMoveTarget = nil
        if currentQuestTargetPos then
            activeMoveTarget = currentQuestTargetPos
        elseif currentTarget and getTargetPart(currentTarget) then
            activeMoveTarget = getTargetPart(currentTarget).Position
        end

        -- Safe Y calculation
        local targetY = hrp.Position.Y
        if groundPos then
            targetY = groundPos.Y + 20
        elseif activeMoveTarget then
            -- If map is unloaded below us, use the destination's Y level so we don't sink!
            targetY = activeMoveTarget.Y + 30 
        end
        
        if bounceActive then
            bounceTimer = bounceTimer + deltaTime
            if bounceTimer >= 2 then bounceUp = not bounceUp bounceTimer = 0 end
            targetY = targetY + (bounceUp and 10 or 0)
        end

        -- Apply Movement
        if activeMoveTarget then
            local target3D = Vector3.new(activeMoveTarget.X, targetY, activeMoveTarget.Z)
            local direction = (target3D - hrp.Position)
            
            -- If we are moving to a quest NPC, stop within 10 studs. If a mob, stop within 1 stud.
            local stopDist = currentQuestTargetPos and 10 or 1
            
            if direction.Magnitude > stopDist then
                local stepDist = backupTweenSpeed * deltaTime
                if stepDist > direction.Magnitude then stepDist = direction.Magnitude end
                local step = direction.Unit * stepDist
                nextX = hrp.Position.X + step.X
                nextZ = hrp.Position.Z + step.Z
                -- Only strictly tween Y if we are far away and map is missing, otherwise smooth it
                if not groundPos and direction.Magnitude > 100 then
                    nextY = hrp.Position.Y + step.Y
                else
                    nextY = hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15
                end
            else
                nextY = hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15
            end
        else
            -- Hover in place
            nextY = hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15
        end
        
        hrp.CFrame = CFrame.new(nextX, nextY, nextZ)
    end)
end

-- [[ FAST TRAVEL SYSTEM (OPTIMIZED) ]]
local function fastTravelToIsland(islandName)
    setKaitunStatus("Traveling to " .. islandName, "Locating Portal")
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local portal = getLocalPortal()
    
    -- Only reset if literally zero portals exist in the game memory right now
    if not portal then
        setKaitunStatus("No portal found locally.", "Resetting to force chunk load")
        if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
        char.Humanoid.Health = 0
        LocalPlayer.CharacterAdded:Wait()
        local newChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        hrp = newChar:WaitForChild("HumanoidRootPart", 10)
        task.wait(2) 
        portal = getLocalPortal()
    end
    
    if portal and hrp then
        -- Tween to the local portal
        setKaitunStatus("Tweening to local portal...", "Preparing Teleport")
        local pCFrame = portal:IsA("Model") and portal:GetPivot() or portal.CFrame
        
        -- Temporarily use currentQuestTargetPos to make the movement engine fly to the portal
        currentQuestTargetPos = pCFrame.Position
        if not evasionTask then startDynamicMovement() end
        
        -- Wait until we are physically at the portal
        while (hrp.Position - pCFrame.Position).Magnitude > 15 do
            task.wait(0.1)
        end
        currentQuestTargetPos = nil -- Clear it
        
        -- Fire remote
        setKaitunStatus("Firing Portal Remote", "Waiting for chunks")
        pcall(function()
            local args = { islandName }
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        end)
        
        task.wait(3.5) 
        return true
    end
    return false
end

-- [[ KAITUN CACHE INITIALIZER ]]
local function initializeWorldCache()
    isInitializingCache = true
    setKaitunStatus("Initializing World Cache", "Scanning Islands (Do NOT move)")
    
    pcall(function() 
        local args = {"repeatable"}
        ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(args)) 
    end)
    task.wait(0.5)
    
    for _, island in ipairs(WorldCache.Islands) do
        if not kaitunActive then break end
        
        if not fastTravelToIsland(island) then continue end
        
        local serviceNPCs = workspace:WaitForChild("ServiceNPCs", 5)
        if not serviceNPCs then continue end
        
        for _, npc in ipairs(serviceNPCs:GetChildren()) do
            if string.find(npc.Name, "QuestNPC") and not WorldCache.Quests[npc.Name] then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                local prompt = hrp and hrp:FindFirstChild("QuestPrompt")
                
                if prompt then
                    setKaitunStatus("Approaching " .. npc.Name, "Reading Quest Data")
                    
                    -- Blind tween to NPC to read data
                    currentQuestTargetPos = hrp.Position
                    local charHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    while charHrp and (charHrp.Position - hrp.Position).Magnitude > 15 do
                        task.wait(0.1)
                    end
                    currentQuestTargetPos = nil
                    
                    local text = prompt.ObjectText or ""
                    local minLvl, maxLvl = string.match(text, "(%d+)%s*%-%s*(%d+)")
                    if not minLvl then 
                        minLvl = string.match(text, "(%d+)%+") 
                        maxLvl = 9999999 
                    end
                    
                    minLvl = tonumber(minLvl) or 0
                    maxLvl = tonumber(maxLvl) or 9999999
                    
                    pcall(function() ReplicatedStorage.RemoteEvents.QuestAccept:FireServer(npc.Name) end)
                    task.wait(1.5)
                    
                    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local questUI = pGui and pGui:FindFirstChild("QuestUI")
                    local qFrame = questUI and questUI:FindFirstChild("Quest")
                    
                    if qFrame and qFrame.Visible then
                        local reqText = qFrame.Quest.Holder.Content.QuestInfo.QuestRequirement.Text 
                        local expText = qFrame.Reward.RewardExp.CurrencyIndicator.Text 
                        local targetMobRaw = qFrame.Quest.Holder.Content.QuestInfo.QuestTitle.Text 
                        
                        local extractedMob = string.match(targetMobRaw, "Defeat the (.*)'s!") or string.match(targetMobRaw, "Defeat (.*)!") or "Unknown"
                        local reqKills = tonumber(string.match(reqText, "%d+/(%d+)")) or 1
                        local expReward = parseNumberSuffix(expText)
                        
                        -- CRITICAL: Cache the absolute Vector3 Position
                        WorldCache.Quests[npc.Name] = {
                            Position = hrp.Position,
                            MinLvl = minLvl,
                            MaxLvl = maxLvl,
                            TargetMob = extractedMob,
                            ReqKills = reqKills,
                            ExpReward = expReward,
                            Island = island
                        }
                    end
                    
                    pcall(function() 
                        local args = {"repeatable"}
                        ReplicatedStorage.RemoteEvents.QuestAbandon:FireServer(unpack(args)) 
                    end)
                    task.wait(0.5)
                end
            end
        end
    end
    
    if kaitunActive then
        cacheIsBuilt = true
        setKaitunStatus("World Cache Built Successfully!", "Calculating Optimal Quest")
    end
    isInitializingCache = false
end

-- [[ SMART KAITUN ENGINE ]]
local function updatePlayerDamage()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local dmgLabel = pGui:FindFirstChild("DamageCounterUI") 
            and pGui.DamageCounterUI:FindFirstChild("DamageFrame") 
            and pGui.DamageCounterUI.DamageFrame:FindFirstChild("Holder") 
            and pGui.DamageCounterUI.DamageFrame.Holder:FindFirstChild("StatFrame")
            and pGui.DamageCounterUI.DamageFrame.Holder.StatFrame:FindFirstChild("DamageLabel")
            
        if dmgLabel and dmgLabel.Text ~= "" then
            cachedDamage = parseNumberSuffix(dmgLabel.Text)
            if cachedDamage <= 0 then cachedDamage = 1 end
        end
    end
end

local function getOptimalQuest()
    local pLevel = tonumber(LocalPlayer.Data.Level.Value) or 0
    local bestQuestNPC = nil
    local bestData = nil
    local bestEfficiency = -1
    
    for questName, data in pairs(WorldCache.Quests) do
        if pLevel >= data.MinLvl and pLevel <= data.MaxLvl then
            local estimatedMobHealth = data.MinLvl * 50 
            local hitsToKill = math.ceil(estimatedMobHealth / cachedDamage)
            local timePerKill = hitsToKill * 0.4
            local totalTime = timePerKill * data.ReqKills
            
            if totalTime == 0 then totalTime = 1 end
            local efficiency = data.ExpReward / totalTime
            
            if efficiency > bestEfficiency then
                bestEfficiency = efficiency
                bestQuestNPC = questName
                bestData = data
            end
        end
    end
    return bestQuestNPC, bestData
end

-- [[ KILLAURA ATTACK LOOP ]]
local function startKillAura()
    if not killAuraActive then return end
    updateStatus("Initializing Combat Engine...")
    lastRecalibrate = tick()
    startDynamicMovement()

    if auraTask then task.cancel(auraTask) end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        while killAuraActive do
            
            if kaitunActive then
                if isInitializingCache then task.wait(1) continue end
                
                if not cacheIsBuilt then
                    task.spawn(initializeWorldCache)
                    task.wait(1)
                    continue
                end
                
                updatePlayerDamage()
                
                local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                local questUI = pGui and pGui:FindFirstChild("QuestUI")
                local questFrame = questUI and questUI:FindFirstChild("Quest")
                local hasActiveQuest = questFrame and questFrame.Visible
                
                if not hasActiveQuest then
                    setKaitunStatus("Calculating Optimal Route...", "Locating NPC")
                    local optQuestNPC, optData = getOptimalQuest()
                    
                    if optQuestNPC and optData then
                        currentKaitunTargetMob = optData.TargetMob
                        currentKaitunIsland = optData.Island
                        
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if not hrp then task.wait(0.5) continue end
                        
                        -- Check absolute distance to cached coordinate. If > 2500, we need to use a portal.
                        if (hrp.Position - optData.Position).Magnitude > 2500 then
                            fastTravelToIsland(optData.Island)
                            continue
                        end
                        
                        -- Blind Tween directly to the absolute cached Vector3
                        isQuesting = true
                        currentQuestTargetPos = optData.Position
                        setKaitunStatus("Tweening to " .. optQuestNPC, "Distance: " .. math.floor((hrp.Position - optData.Position).Magnitude))
                        
                        if (hrp.Position - optData.Position).Magnitude < 15 then
                            setKaitunStatus("Accepting Quest", "Hunting " .. optData.TargetMob)
                            pcall(function() ReplicatedStorage.RemoteEvents.QuestAccept:FireServer(optQuestNPC) end)
                            task.wait(1.5)
                        end
                        task.wait(0.1) -- Yield to prevent freezing while tweening
                        continue
                    else
                        setKaitunStatus("No suitable quests found for Level " .. tostring(LocalPlayer.Data.Level.Value), "Idling")
                        task.wait(1)
                        continue
                    end
                else
                    isQuesting = false
                    currentQuestTargetPos = nil
                    
                    if currentKaitunTargetMob == "" then
                        local qTitle = pGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestTitle.Text
                        currentKaitunTargetMob = string.match(qTitle, "Defeat the (.*)'s!") or string.match(qTitle, "Defeat (.*)!") or ""
                    end
                    
                    setKaitunStatus("Hunting " .. currentKaitunTargetMob, "Killing Target")
                end
            end

            if recalibrateActive and tick() - lastRecalibrate >= (recalibrateInterval * 60) then
                isRecalibrating = true
                updateStatus("Recalibrating... Dropping to ground.")
                if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then 
                    hrp.Velocity = Vector3.zero 
                    hrp.RotVelocity = Vector3.zero 
                    for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = true end
                    end
                end
                task.wait(recalibrateDuration)
                lastRecalibrate = tick()
                isRecalibrating = false
                if killAuraActive then startDynamicMovement() end
                continue
            end

            local npcFolder = workspace:FindFirstChild("NPCs")
            if not npcFolder then task.wait(0.5) continue end
            
            -- Optional Weapon Equip
            pcall(function() equipWeapon(selectedWeapon) end)

            local bestTarget = nil
            local timedBossTarget = nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero
            local validMobFound = false

            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 and isMobSelected(npc.Name) then
                    validMobFound = true
                    local dist = (charPos - npc:GetPivot().Position).Magnitude
                    
                    if killTimedBossesActive and string.find(string.lower(npc.Name), "boss_") then
                        if not timedBossTarget or dist < closestDist then
                            timedBossTarget = npc
                            closestDist = dist
                        end
                    elseif not timedBossTarget and dist < closestDist then
                        bestTarget = npc
                        closestDist = dist
                    end
                end
            end

            currentTarget = timedBossTarget or bestTarget

            if not validMobFound and kaitunActive and not isQuesting then
                setKaitunStatus("Target mob missing locally.", "Searching around Quest NPC")
                -- If we can't find the mob, float around the cached quest NPC to load chunks
                local optQuestNPC, optData = getOptimalQuest()
                if optData then
                    currentQuestTargetPos = optData.Position
                end
                task.wait(0.5)
                continue
            end
            
            -- We found a target, clear blind coordinates
            currentQuestTargetPos = nil

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                while killAuraActive and not isRecalibrating and not isInitializingCache and currentTarget and currentTarget.Parent and hum and hum.Health > 0 do
                    local tPart = getTargetPart(currentTarget)
                    if tPart then
                        pcall(function()
                            local args = {}
                            if vectorMethod == "Vector3.new" then 
                                args = {Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)}
                            elseif vectorMethod == "Raw Vector3" then 
                                args = {tPart.Position}
                            elseif vectorMethod == "vector.create(Vector3) [Broken]" then 
                                args = {vector.create(tPart.Position)}
                            else 
                                args = {vector.create(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)} 
                            end
                            remote:FireServer(unpack(args))
                        end)
                    end
                    task.wait(0.35)
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

local function stopKillAura()
    killAuraActive = false
    currentTarget = nil
    currentQuestTargetPos = nil
    isRecalibrating = false
    updateStatus("KillAura Stopped. Idle.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Velocity = Vector3.zero
        char.HumanoidRootPart.RotVelocity = Vector3.zero
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end
end

