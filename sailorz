-- [[ FAST TRAVEL SYSTEM ]]
local function fastTravelToIsland(islandName)
    setKaitunStatus("Traveling to " .. islandName, "Locating Portal")
    
    local portal = getLocalPortal()
    
    if not portal then
        setKaitunStatus("No portal found locally.", "Resetting to bypass Streaming")
        targetPosition = nil
        if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then char.Humanoid.Health = 0 end
        LocalPlayer.CharacterAdded:Wait()
        
        local newChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        newChar:WaitForChild("HumanoidRootPart", 10)
        task.wait(2) 
        
        portal = getLocalPortal()
        startDynamicMovement()
    end
    
    if portal then
        local pPos = portal:IsA("Model") and portal:GetPivot().Position or portal.Position
        targetPosition = pPos
        
        -- Wait until we arrive at the portal
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        while hrp and (hrp.Position - pPos).Magnitude > 5 do
            task.wait(0.1)
        end
        
        setKaitunStatus("At Portal", "Teleporting")
        
        -- Temporarily disable movement so it doesn't fight the teleport
        if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
        
        pcall(function()
            local args = { islandName }
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        end)
        
        task.wait(3.5) 
        startDynamicMovement()
        return true
    end
    
    return false
end

-- [[ KAITUN CACHE INITIALIZER ]]
local function buildWorldCache()
    isInitializingCache = true
    setKaitunStatus("Initializing World Cache", "Scanning Islands (Do NOT move)")
    
    -- Abandon existing quests to ensure we can accept new ones
    pcall(function() 
        local args = {"repeatable"}
        ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(args)) 
    end)
    task.wait(0.5)

    for _, island in ipairs(WorldCache.Islands) do
        if not kaitunActive then break end
        
        setStatus("Caching: " .. island, "Fast Traveling")
        fastTravelToIsland(island)
        
        local serviceNPCs = workspace:WaitForChild("ServiceNPCs", 5)
        if not serviceNPCs then continue end
        
        for i = 1, 19 do
            local npcName = "QuestNPC" .. i
            local npc = serviceNPCs:FindFirstChild(npcName)
            
            if npc and not WorldCache.Quests[npcName] then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                local prompt = hrp and hrp:FindFirstChild("QuestPrompt")
                
                if prompt and hrp then
                    local cachedPos = hrp.Position
                    
                    setKaitunStatus("Caching " .. npcName, "Flying to NPC")
                    
                    targetPosition = cachedPos
                    local charHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    while charHrp and (charHrp.Position - cachedPos).Magnitude > 10 do 
                        task.wait(0.1) 
                    end
                    targetPosition = nil -- Arrived
                    
                    local text = prompt.ObjectText or ""
                    local minLvl, maxLvl = string.match(text, "(%d+)%s*%-%s*(%d+)")
                    if not minLvl then 
                        minLvl = string.match(text, "(%d+)%+") 
                        maxLvl = 9999999 
                    end
                    
                    minLvl = tonumber(minLvl) or 0
                    maxLvl = tonumber(maxLvl) or 9999999
                    
                    setKaitunStatus("Caching " .. npcName, "Reading Quest UI")
                    pcall(function() ReplicatedStorage.RemoteEvents.QuestAccept:FireServer(npcName) end)
                    task.wait(1.5)
                    
                    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local questUI = pGui and pGui:FindFirstChild("QuestUI")
                    local qFrame = questUI and questUI:FindFirstChild("Quest")
                    
                    if qFrame and qFrame.Visible then
                        -- USING EXACT PATHS AS REQUESTED
                        local reqText = qFrame.Quest.Holder.Content.QuestInfo.QuestRequirement.Text 
                        local expText = qFrame.Reward.RewardExp.CurrencyIndicator.Text 
                        local targetMobRaw = qFrame.Quest.Holder.Content.QuestInfo.QuestTitle.QuestTitle.Text 
                        
                        local extractedMob = string.match(targetMobRaw, "Defeat the (.*)'s!") or string.match(targetMobRaw, "Defeat (.*)!") or "Unknown"
                        local reqKills = tonumber(string.match(reqText, "%d+/(%d+)")) or 1
                        local expReward = parseNumberSuffix(expText)
                        
                        WorldCache.Quests[npcName] = {
                            Position = cachedPos,
                            Island = island,
                            MinLvl = minLvl,
                            MaxLvl = maxLvl,
                            TargetMob = extractedMob,
                            ReqKills = reqKills,
                            ExpReward = expReward
                        }
                    end
                    
                    -- Force abandon to clear the slot
                    pcall(function() 
                        local args = {"repeatable"}
                        ReplicatedStorage.RemoteEvents.QuestAbandon:FireServer(unpack(args)) 
                    end)
                    task.wait(0.5)
                end
            end
        end
    end
    
    if kaitunActive then
        cacheIsBuilt = true
        setKaitunStatus("World Cache Built Successfully!", "Calculating Optimal Quest")
    end
    isInitializingCache = false
    targetPosition = nil
end

-- [[ SMART KAITUN ENGINE ]]
local function updatePlayerDamage()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        -- USING EXACT PATH AS REQUESTED
        local dmgLabel = pGui:FindFirstChild("DamageCounterUI") 
            and pGui.DamageCounterUI:FindFirstChild("DamageFrame") 
            and pGui.DamageCounterUI.DamageFrame:FindFirstChild("Holder") 
            and pGui.DamageCounterUI.DamageFrame.Holder:FindFirstChild("StatFrame")
            and pGui.DamageCounterUI.DamageFrame.Holder.StatFrame:FindFirstChild("DamageLabel")
            
        if dmgLabel and dmgLabel.Text ~= "" then
            cachedDamage = parseNumberSuffix(dmgLabel.Text)
            if cachedDamage <= 0 then cachedDamage = 1 end
        end
    end
end

local function calculateOptimalQuest()
    local pLevel = tonumber(LocalPlayer.Data.Level.Value) or 0
    local bestQuest = nil
    local bestEfficiency = -1
    
    for questName, data in pairs(WorldCache.Quests) do
        if pLevel >= data.MinLvl and pLevel <= data.MaxLvl then
            local estimatedMobHealth = data.MinLvl * 50 
            local hitsToKill = math.ceil(estimatedMobHealth / cachedDamage)
            local timePerKill = hitsToKill * 0.4 
            local totalTime = timePerKill * data.ReqKills
            
            if totalTime == 0 then totalTime = 1 end
            local efficiency = data.ExpReward / totalTime
            
            if efficiency > bestEfficiency then
                bestEfficiency = efficiency
                bestQuest = questName
            end
        end
    end
    return bestQuest
end

-- [[ THE KAITUN MASTER LOOP ]]
local function startKaitunEngine()
    if kaitunTask then task.cancel(kaitunTask) end
    startDynamicMovement()

    kaitunTask = task.spawn(function()
        local hitRemote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        
        while kaitunActive do
            if not cacheIsBuilt then
                buildWorldCache()
                task.wait(1)
                continue
            end

            updatePlayerDamage()
            equipWeapon(selectedWeapon)
            
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local questUI = pGui and pGui:FindFirstChild("QuestUI")
            local hasActiveQuest = questUI and questUI:FindFirstChild("Quest") and questUI.Quest.Visible
            
            if not hasActiveQuest then
                setKaitunStatus("Calculating Optimal Route...", "Finding target")
                local optQuestName = calculateOptimalQuest()
                
                if optQuestName then
                    local qData = WorldCache.Quests[optQuestName]
                    currentKaitunTargetMob = qData.TargetMob
                    
                    setKaitunStatus("Decided: " .. optQuestName, "Traveling to " .. qData.Island)
                    fastTravelToIsland(qData.Island)
                    
                    setKaitunStatus("On Island", "Tweening to " .. optQuestName)
                    targetPosition = qData.Position
                    
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    while hrp and (hrp.Position - qData.Position).Magnitude > 15 do
                        task.wait(0.1)
                    end
                    targetPosition = nil
                    
                    setKaitunStatus("At NPC", "Accepting Quest")
                    pcall(function() ReplicatedStorage.RemoteEvents.QuestAccept:FireServer(optQuestName) end)
                    task.wait(1.5)
                else
                    setKaitunStatus("No suitable quests found for Level " .. tostring(LocalPlayer.Data.Level.Value), "Idling")
                    targetPosition = nil
                    task.wait(1)
                end
            else
                -- Extract target if spawned in with a quest
                if currentKaitunTargetMob == "" then
                    local qTitle = pGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestTitle.QuestTitle.Text
                    currentKaitunTargetMob = string.match(qTitle, "Defeat the (.*)'s!") or string.match(qTitle, "Defeat (.*)!") or ""
                end
                
                setKaitunStatus("Hunting " .. currentKaitunTargetMob, "Scanning Workspace")
                
                local npcFolder = workspace:FindFirstChild("NPCs")
                if not npcFolder then task.wait(0.5) continue end
                
                local bestTarget = nil
                local closestDist = math.huge
                local charPos = LocalPlayer.Character:GetPivot().Position
                
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    local hum = npc:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 and isMobSelected(npc.Name) then
                        local dist = (charPos - npc:GetPivot().Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            bestTarget = npc
                        end
                    end
                end
                
                if bestTarget then
                    local hum = bestTarget:FindFirstChild("Humanoid")
                    while kaitunActive and bestTarget and bestTarget.Parent and hum and hum.Health > 0 do
                        -- Handle Quest Completion mid-combat
                        local currentQuestUI = pGui and pGui:FindFirstChild("QuestUI")
                        if currentQuestUI and currentQuestUI:FindFirstChild("Quest") and not currentQuestUI.Quest.Visible then
                            break
                        end
                        
                        local tPart = getTargetPart(bestTarget)
                        if tPart then
                            targetPosition = tPart.Position 
                            setKaitunStatus("Attacking " .. bestTarget.Name, "HP: " .. tostring(math.floor(hum.Health)))
                            
                            pcall(function()
                                local args = {}
                                if vectorMethod == "Vector3.new" then args = {Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)}
                                elseif vectorMethod == "Raw Vector3" then args = {tPart.Position}
                                else args = {vector.create(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)} end
                                hitRemote:FireServer(unpack(args))
                            end)
                        end
                        task.wait(0.35)
                    end
                    targetPosition = nil
                else
                    setKaitunStatus("No " .. currentKaitunTargetMob .. " found", "Waiting for spawns")
                    targetPosition = nil
                    task.wait(1)
                end
            end
        end
    end)
end

-- [[ KILLAURA ATTACK LOOP (BASE COMBAT) ]]
local function startKillAura()
    if not killAuraActive then return end
    updateStatus("Initializing Combat Engine...")
    lastRecalibrate = tick()
    startDynamicMovement()

    if auraTask then task.cancel(auraTask) end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        while killAuraActive do
            if kaitunActive then task.wait(1) continue end -- Pause base combat if Kaitun is running
            
            if recalibrateActive and tick() - lastRecalibrate >= (recalibrateInterval * 60) then
                isRecalibrating = true
                updateStatus("Recalibrating... Dropping to ground.")
                if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then 
                    hrp.Velocity = Vector3.zero 
                    hrp.RotVelocity = Vector3.zero 
                end
                task.wait(recalibrateDuration)
                lastRecalibrate = tick()
                isRecalibrating = false
                if killAuraActive then startDynamicMovement() end
                continue
            end

            local npcFolder = workspace:FindFirstChild("NPCs")
            if not npcFolder then task.wait(0.5) continue end
            equipWeapon(selectedWeapon)

            local bestTarget = nil
            local timedBossTarget = nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero
            local validMobFound = false

            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 and isMobSelected(npc.Name) then
                    validMobFound = true
                    local dist = (charPos - npc:GetPivot().Position).Magnitude
                    
                    if killTimedBossesActive and string.find(string.lower(npc.Name), "boss_") then
                        if not timedBossTarget or dist < closestDist then
                            timedBossTarget = npc
                            closestDist = dist
                        end
                    elseif not timedBossTarget and dist < closestDist then
                        bestTarget = npc
                        closestDist = dist
                    end
                end
            end

            currentTarget = timedBossTarget or bestTarget

            if not validMobFound then
                updateStatus("No targets found locally.")
                task.wait(1)
                continue
            end

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                while killAuraActive and not kaitunActive and not isRecalibrating and currentTarget and currentTarget.Parent and hum and hum.Health > 0 do
                    local tPart = getTargetPart(currentTarget)
                    if tPart then
                        pcall(function()
                            local args = {}
                            if vectorMethod == "Vector3.new" then 
                                args = {Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)}
                            elseif vectorMethod == "Raw Vector3" then 
                                args = {tPart.Position}
                            else 
                                args = {vector.create(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)} 
                            end
                            remote:FireServer(unpack(args))
                        end)
                        updateStatus("Attacking: " .. currentTarget.Name .. " | HP: " .. tostring(math.floor(hum.Health)))
                    else
                        updateStatus("Target unrendered. Tweening to pivot: " .. currentTarget.Name)
                    end
                    task.wait(0.35)
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

local function stopKillAura()
    killAuraActive = false
    currentTarget = nil
    targetPosition = nil
    isRecalibrating = false
    updateStatus("KillAura Stopped. Idle.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Velocity = Vector3.zero
        char.HumanoidRootPart.RotVelocity = Vector3.zero
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

-- [[ STATS LOGIC ]]
local function startAutoStats()
    task.spawn(function()
        while autoStatActive do
            local statPointsFolder = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("StatPoints")
            if statPointsFolder and tonumber(statPointsFolder.Value) >= statAmount then
                local args = { statTarget, statAmount }
                pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("AllocateStat"):FireServer(unpack(args)) end)
            end
            task.wait(1)
        end
    end)
end

-- [[ RAIDS LOGIC ]]
local function startAutoDungeon()
    if dungeonLoopTask then task.cancel(dungeonLoopTask); dungeonLoopTask = nil end

    dungeonLoopTask = task.spawn(function()
        while autoDungeonActive do
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local dungeonUI = playerGui and playerGui:FindFirstChild("DungeonUI")
            
            if dungeonUI then
                local replayFrame = dungeonUI:FindFirstChild("ReplayDungeonFrameVisibleOnlyWhenClearingDungeon")
                local contentFrame = dungeonUI:FindFirstChild("ContentFrame")
                
                if replayFrame and replayFrame.Visible then
                    pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DungeonWaveReplayVote"):FireServer("sponsor") end)
                elseif contentFrame and contentFrame.Visible then
                    pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DungeonWaveVote"):FireServer(selectedDifficulty) end)
                    if not killAuraActive and not kaitunActive then
                        killAllActive = true 
                        killAuraActive = true
                        startKillAura()
                    end
                elseif autoRequestActive then
                    pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RequestDungeonPortal"):FireServer(selectedDungeon) end)
                end
            end
            task.wait(2)
        end
    end)
end

