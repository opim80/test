Tabs.Combat:AddDropdown("VectorMethod", {Title = "Vector Method", Values = {"vector.create(X, Y, Z)", "Vector3.new", "Raw Vector3"}, Default = "vector.create(X, Y, Z)"}):OnChanged(function(v) vectorMethod = v end)

Tabs.Combat:AddSection("Movement & Failsafes")
Tabs.Combat:AddToggle("CenterToggle", {Title = "Always Take Center", Default = false}):OnChanged(function(v) alwaysTakeCenterActive = v end)
Tabs.Combat:AddSlider("TweenSpeed", {Title = "Backup Tween Speed", Default = 65, Min = 10, Max = 200, Rounding = 1}):OnChanged(function(v) backupTweenSpeed = v end)
Tabs.Combat:AddToggle("RecalibrateToggle", {Title = "Auto Recalibrate", Default = false}):OnChanged(function(v) recalibrateActive = v lastRecalibrate = tick() end)
Tabs.Combat:AddSlider("RecalibrateInterval", {Title = "Recalibrate Interval (mins)", Default = 5, Min = 1, Max = 60, Rounding = 1}):OnChanged(function(v) recalibrateInterval = v end)

MasterAuraToggle:OnChanged(function(v)
    killAuraActive = v
    if killAuraActive then startKillAura() else stopKillAura() end
end)

-- KAITUN TAB
KaitunStatusDisplay = Tabs.Kaitun:AddParagraph({Title = "Kaitun Process Tracker", Content = "**Currently:** Idle\n**Next Up:** Awaiting Start"})

KaitunStartToggle = Tabs.Kaitun:AddToggle("KaitunStartToggle", {Title = "Start Kaitun Engine", Default = false})
KaitunStartToggle:OnChanged(function(Value)
    kaitunActive = Value
    if kaitunActive then
        setKaitunStatus("Starting Engine...", "Checking Map Cache")
        if not killAuraActive and MasterAuraToggle then MasterAuraToggle:SetValue(true) end
    else
        setKaitunStatus("Idle", "Awaiting Start")
        if killAuraActive and MasterAuraToggle then MasterAuraToggle:SetValue(false) end
    end
end)

Tabs.Kaitun:AddButton({Title = "Force Re-Cache World", Callback = function() 
    if kaitunActive then task.spawn(initializeWorldCache) else setKaitunStatus("Cannot Cache", "Start Kaitun First") end 
end})

Tabs.Kaitun:AddButton({Title = "Force Abandon Current Quest", Callback = function() 
    pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer("repeatable") end)
    updateStatus("Current Quest Abandoned.")
end})

-- STATS TAB
local StatDisplay = Tabs.Stats:AddParagraph({Title = "Available Stat Points", Content = "Calculating..."})
task.spawn(function()
    while task.wait(1) do
        local points = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("StatPoints")
        if points then StatDisplay:SetDesc("Points: " .. tostring(points.Value)) end
    end
end)

Tabs.Stats:AddDropdown("StatDropdown", {Title = "Target Stat", Values = {"Melee", "Defense", "Sword", "Power"}, Multi = false, Default = "Melee"}):OnChanged(function(v) statTarget = v end)
Tabs.Stats:AddInput("StatAmount", {Title = "Allocate Amount", Default = "1", Numeric = true}):OnChanged(function(v) statAmount = tonumber(v) or 1 end)
Tabs.Stats:AddToggle("AutoStatToggle", {Title = "Auto Allocate", Default = false}):OnChanged(function(v) autoStatActive = v if v then startAutoStats() end end)

