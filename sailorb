    updateStatus("Calculating M1 Damage...")
    pcall(function()
        GlobalCache.M1Damage = tonumber(game:GetService("Players")[LocalPlayer.Name].PlayerGui.DamageCounterUI.DamageFrame.Holder.StatFrame.DamageLabel.Text) or 1
    end)
    
    if GlobalCache.M1Damage <= 1 then GlobalCache.M1Damage = 500 end -- Fallback

    GlobalCache.Initialized = true
    updateStatus("Cache Complete. Ready for Kaitun.")
end

local function GetMostEfficientQuest()
    local bestQuest = nil
    local highestExpPerSec = 0

    for npcName, data in pairs(GlobalCache.Quests) do
        -- Find target mob health to calculate TTK
        local mobHP = 5000 -- Placeholder, ideally grab from cached NPC data
        local timeToKillOne = (mobHP / GlobalCache.M1Damage) * 0.4
        local totalTTK = timeToKillOne * data.Amount
        
        local expPerSec = data.Exp / (totalTTK + 1) -- +1 to prevent div by 0

        if expPerSec > highestExpPerSec then
            highestExpPerSec = expPerSec
            bestQuest = npcName
        end
    end
    return bestQuest
end

-- [[ KILLAURA / KAITUN LOOP ]]
local function startMasterLoop()
    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")

        while killAuraActive or kaitunActive do
            if kaitunActive and not GlobalCache.Initialized then
                InitializeWorldCache()
            end

            equipWeapon(selectedWeapon)
            local currentTarget = nil
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero
            local npcFolder = workspace:FindFirstChild("NPCs")

            -- 1. Priority: Boss Check (Replaces Aizen)
            if killAllTimedBosses and npcFolder then
                local closestBoss = nil
                local closestDist = math.huge
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    if string.find(string.lower(npc.Name), "boss_") then
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            local dist = (charPos - npc:GetPivot().Position).Magnitude
                            if dist < closestDist then
                                closestBoss = npc
                                closestDist = dist
                            end
                        end
                    end
                end
                currentTarget = closestBoss
            end

            -- 2. Kaitun / Normal Targeting
            if not currentTarget and npcFolder then
                if kaitunActive then
                    -- TODO: Add Active Quest finding, pathing, and targeting logic here based on GetMostEfficientQuest()
                    updateStatus("Kaitun Active - Seeking optimal targets...")
                else
                    -- Standard KillAura fallback (Kill everything)
                    for _, npc in ipairs(npcFolder:GetChildren()) do
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            currentTarget = npc
                            break
                        end
                    end
                end
            end

            -- Combat Execution
            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                local targetPart = getTargetPart(currentTarget)

                if targetPart and hum and hum.Health > 0 then
                    updateStatus("Engaging: " .. currentTarget.Name)
                    TweenTo(targetPart.CFrame * CFrame.new(0, 0, 3)) -- Tween to hitting distance

                    while currentTarget and currentTarget.Parent and hum.Health > 0 and (killAuraActive or kaitunActive) do
                        -- Boss interrupt check
                        if killAllTimedBosses and not string.find(string.lower(currentTarget.Name), "boss_") then
                            local newBossFound = false
                            for _, n in ipairs(npcFolder:GetChildren()) do
                                if string.find(string.lower(n.Name), "boss_") and n:FindFirstChild("Humanoid") and n.Humanoid.Health > 0 then
                                    newBossFound = true
                                    break
                                end
                            end
                            if newBossFound then break end -- Break loop to target boss
                        end

                        local tPos = targetPart.Position
                        local success, err = pcall(function() 
                            local args = {}
                            if vectorMethod == "vector.create(X, Y, Z)" then
                                args = { vector.create(tPos.X, tPos.Y, tPos.Z) }
                            elseif vectorMethod == "Vector3.new" then
                                args = { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
                            else
                                args = { tPos }
                            end
                            remote:FireServer(unpack(args)) 
                        end)

                        task.wait(0.35)
                    end
                end
            else
                task.wait(0.5) 
            end
        end
    end)
end

local function stopMasterLoop()
    killAuraActive = false
    kaitunActive = false
    updateStatus("Farming Stopped.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
end

