local function getBaseName(name)
    -- Removes trailing numbers and underscores (e.g., "Thief1" -> "Thief", "DesertBandit_2" -> "DesertBandit")
    return string.gsub(name, "[_%s%d]+$", "")
end

local function ParseNumber(str)
    if not str then return 0 end
    str = string.gsub(tostring(str), ",", "")
    local mult = 1
    if string.find(str:upper(), "K") then mult = 1000 end
    if string.find(str:upper(), "M") then mult = 1000000 end
    if string.find(str:upper(), "B") then mult = 1000000000 end
    local num = tonumber(string.match(str, "[%d%.]+")) or 0
    return num * mult
end

local function GetPlayerDamage()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local ui = gui:FindFirstChild("DamageCounterUI")
    if ui then
        local lbl = ui:FindFirstChild("DamageFrame") and 
                    ui.DamageFrame:FindFirstChild("Holder") and 
                    ui.DamageFrame.Holder:FindFirstChild("StatFrame") and 
                    ui.DamageFrame.Holder.StatFrame:FindFirstChild("DamageLabel")
        if lbl and lbl.Text then
            return ParseNumber(lbl.Text)
        end
    end
    return nil
end

local function isMobSelected(rawName)
    if killAllActive then return true end
    if killTimedBossesActive and string.find(string.lower(rawName), "boss_") then return true end
    
    local baseName = getBaseName(rawName)
    if type(selectedMobs) == "table" then
        if selectedMobs[rawName] or selectedMobs[baseName] then return true end
        for selectedName, state in pairs(selectedMobs) do
            if state and (string.find(string.lower(rawName), string.lower(selectedName))) then
                return true
            end
        end
    end
    return false
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function getWeapons()
    local weapons = {}
    if LocalPlayer.Backpack then
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then table.insert(weapons, tool.Name) end
        end
    end
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then table.insert(weapons, tool.Name) end
        end
    end
    if selectedWeapon ~= "" and not table.find(weapons, selectedWeapon) then table.insert(weapons, selectedWeapon) end
    return weapons
end

local function getAvailableMobs()
    local mobs = {}
    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in ipairs(npcFolder:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local baseName = getBaseName(npc.Name)
                if not table.find(mobs, baseName) then table.insert(mobs, baseName) end
            end
        end
    end
    return mobs
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    
    if tool and humanoid and tool.Parent ~= char then 
        humanoid:EquipTool(tool) 
    end
end

local function FireRemoteHit(tPos)
    local remote = ReplicatedStorage:FindFirstChild("CombatSystem") and ReplicatedStorage.CombatSystem:FindFirstChild("Remotes") and ReplicatedStorage.CombatSystem.Remotes:FindFirstChild("RequestHit")
    if not remote then return false, "Remote not found" end

    local success, err = pcall(function() 
        local args = {}
        if vectorMethod == "vector.create(X, Y, Z)" then
            args = { vector.create(tPos.X, tPos.Y, tPos.Z) }
        elseif vectorMethod == "Vector3.new" then
            args = { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
        elseif vectorMethod == "Raw Vector3" then
            args = { tPos }
        else
            args = { vector.create(tPos) }
        end
        remote:FireServer(unpack(args)) 
    end)
    return success, err
end

-- [[ MOVEMENT & TWEEN LOGIC ]]
local function EnableNoclip()
    if NoclipConn then return end
    NoclipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
            end
        end
    end)
end

local function DisableNoclip()
    if NoclipConn then NoclipConn:Disconnect(); NoclipConn = nil end
end

local function GetClosestPortal(pos)
    local bestPortal = nil
    local bestDist = math.huge
    for name, p in pairs(Portals) do
        local d = (pos - p).Magnitude
        if d < bestDist then
            bestDist = d
            bestPortal = name
        end
    end
    return bestPortal
end

local function TweenToSync(targetPos)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if activeTween then activeTween:Cancel() end
    EnableNoclip()

    local dist = (hrp.Position - targetPos).Magnitude
    local ti = TweenInfo.new(dist / backupTweenSpeed, Enum.EasingStyle.Linear)
    activeTween = TweenService:Create(hrp, ti, {CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))})
    activeTween:Play()
    activeTween.Completed:Wait()
    DisableNoclip()
end

local function TweenToAsync(targetPos)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if activeTween then activeTween:Cancel() end
    EnableNoclip()

    local dist = (hrp.Position - targetPos).Magnitude
    local ti = TweenInfo.new(dist / backupTweenSpeed, Enum.EasingStyle.Linear)
    activeTween = TweenService:Create(hrp, ti, {CFrame = CFrame.new(targetPos + Vector3.new(0, 7, 0))})
    activeTween:Play()
end

local function SmartTraverse(targetPos)
    isTraversing = true
    updateStatus("Quick Traversal: Resetting character...")
    LocalPlayer.Character:BreakJoints()

    LocalPlayer.CharacterAdded:Wait()
    local char = LocalPlayer.Character
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    task.wait(1.5) -- Wait for physics & rendering to catch up

    if hrp then
        local startPortal = GetClosestPortal(hrp.Position)
        local endPortal = GetClosestPortal(targetPos)

        updateStatus("Quick Traversal: Tweening to nearest portal (" .. startPortal .. ")")
        TweenToSync(Portals[startPortal])

        updateStatus("Quick Traversal: Teleporting to " .. endPortal)
        local args = { startPortal }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        task.wait(4)

        local args2 = { endPortal }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args2))
        task.wait(4)

        hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            updateStatus("Quick Traversal: Tweening to final destination...")
            TweenToSync(targetPos)
        end
    end
    isTraversing = false
end

-- [[ KAITUN (AUTO LEVELING) LOGIC ]]
local function GetClosestMobAny()
    local npcFolder = workspace:FindFirstChild("NPCs")
    if not npcFolder then return nil end

    local closestMob = nil
    local closestDist = math.huge
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    for _, npc in ipairs(npcFolder:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then
            local part = getTargetPart(npc)
            if part then
                local dist = (hrp.Position - part.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestMob = npc
                end
            end
        end
    end
    return closestMob
end

local function CalcOptimalQuest()
    local damage = GetPlayerDamage()
    if not damage or damage <= 0 then return nil end

    local bestQuest = nil
    local maxEff = -1

    for i, q in ipairs(HardcodedQuests) do
        local maxHealth = q.MaxHealth or 30000 
        local hitsToKill = math.ceil(maxHealth / damage)
        local timeToKill = (hitsToKill * 0.4) + 2 -- 0.4s per m1 + 2s overhead per mob
        local totalTime = timeToKill * q.Amount
        local efficiency = q.XP / totalTime

        if efficiency > maxEff then
            maxEff = efficiency
            bestQuest = q
        end
    end
    return bestQuest
end

local function GetKaitunTarget(baseName)
    local npcFolder = workspace:FindFirstChild("NPCs")
    if not npcFolder then return nil, nil end

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local validMobs = {}
    local centerPos = Vector3.zero
    
    for _, npc in ipairs(npcFolder:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then
            -- Match base name (ignores trailing numbers)
            if getBaseName(npc.Name) == baseName or getBaseName(npc.Name) == baseName .. "Boss" or getBaseName(npc.Name) == baseName .. " Boss" then
                local part = getTargetPart(npc)
                if part then
                    table.insert(validMobs, npc)
                    centerPos = centerPos + part.Position
                end
            end
        end
    end

    if #validMobs == 0 then return nil, nil end

    -- Centering logic: calculate the average position of all targeted mobs
    centerPos = centerPos / #validMobs

    -- Also return the closest mob to the center to actually hit
    local bestMob = nil
    local closestDist = math.huge
    for _, npc in ipairs(validMobs) do
        local part = getTargetPart(npc)
        local dist = (part.Position - centerPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            bestMob = npc
        end
    end

    return bestMob, centerPos
end

local function StartKaitun()
    if kaitunTask then task.cancel(kaitunTask) end
    kaitunTask = task.spawn(function()
        while autoKaitunActive do
            if isTraversing then
                task.wait(0.5)
                continue
            end

            local damage = GetPlayerDamage()

            -- Phase 1: Gauge Damage independently
            if not damage or damage <= 0 then
                updateStatus("Kaitun: Gauging Damage... Locating nearest mob.")
                local closestMob = GetClosestMobAny()
                if closestMob then
                    local targetPart = getTargetPart(closestMob)
                    if targetPart then
                        local tPos = targetPart.Position
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local dist = (hrp.Position - tPos).Magnitude
                            if dist > 15 then
                                TweenToAsync(tPos)
                            else
                                if activeTween then activeTween:Cancel(); activeTween = nil end
                                DisableNoclip()
                                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tPos.X, hrp.Position.Y, tPos.Z))
                                equipWeapon(selectedWeapon)
                                FireRemoteHit(tPos)
                            end
                        end
                    end
                else
                    updateStatus("Kaitun: No mobs found to gauge damage. Waiting...")
                end
                task.wait(0.5)
                continue
            end

            -- Phase 2: Compute Best Quest & Traverse
            local bestQuest = CalcOptimalQuest()
            if bestQuest then
                if currentKaitunQuest ~= bestQuest then
                    updateStatus("Kaitun: New Optimal Quest -> " .. bestQuest.NPC .. " | XP Efficiency Maxed.")
                    isTraversing = true

                    -- Abandon Current
                    pcall(function()
                        local args = { "repeatable" }
                        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(args))
                    end)
                    task.wait(0.5)

                    -- Traverse to Quest NPC
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - bestQuest.Pos).Magnitude
                        if dist > 2000 then
                            SmartTraverse(bestQuest.Pos)
                        else
                            TweenToSync(bestQuest.Pos)
                        end
                    end

                    -- Accept Quest
                    pcall(function()
                        local npcId = "QuestNPC" .. bestQuest.Index
                        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npcId)
                    end)
                    task.wait(1.5)

                    currentKaitunQuest = bestQuest
                    isTraversing = false
                else
                    -- Phase 3: Farming Combat Loop (Standalone)
                    local targetMob, centerPos = GetKaitunTarget(bestQuest.NPC)
                    
                    if targetMob and centerPos then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local distToCenter = (hrp.Position - centerPos).Magnitude
                            
                            if distToCenter > 2500 then
                                task.spawn(function() SmartTraverse(centerPos) end)
                                task.wait(1)
                            elseif distToCenter > 15 then
                                TweenToAsync(centerPos)
                            else
                                if activeTween then activeTween:Cancel(); activeTween = nil end
                                DisableNoclip()
                                
                                local tPos = getTargetPart(targetMob).Position
                                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tPos.X, hrp.Position.Y, tPos.Z))
                                equipWeapon(selectedWeapon)
                                
                                local success, err = FireRemoteHit(tPos)
                                if not success then
                                    updateStatus("⚠️ Kaitun Hit Error: " .. tostring(err))
                                else
                                    local hum = targetMob:FindFirstChild("Humanoid")
                                    updateStatus("Kaitun Farming: " .. targetMob.Name .. " | HP: " .. tostring(math.floor(hum and hum.Health or 0)))
                                end
                            end
                        end
                    else
                        updateStatus("Kaitun: Waiting for " .. bestQuest.NPC .. " to spawn...")
                    end
                end
            end
            task.wait(0.35)
        end
    end)
end

-- [[ KILLAURA ATTACK LOOP (COMBAT TAB) ]]
local function startKillAura()
    if not killAuraActive then return end
    updateStatus("Initializing KillAura & Traversal...")

    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        while killAuraActive do
            if isTraversing then
                task.wait(0.5)
                continue
            end

            local npcFolder = workspace:FindFirstChild("NPCs")
            if not npcFolder then 
                updateStatus("Waiting for workspace.NPCs...")
                task.wait(0.5)
                continue 
            end
            
            local currentTarget = nil
            local bestTarget = nil
            local bossTarget = nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero

            local validMobFound = false

            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                
                if hum and hum.Health > 0 then
                    if isMobSelected(npc.Name) then
                        validMobFound = true
                        
                        local isBoss = string.find(string.lower(npc.Name), "boss_") ~= nil
                        local dist = (charPos - npc:GetPivot().Position).Magnitude
                        
                        if isBoss then
                            if not bossTarget or dist < closestDist then
                                bossTarget = npc
                                closestDist = dist
                            end
                        elseif not bossTarget then
                            if dist < closestDist then
                                bestTarget = npc
                                closestDist = dist
                            end
                        end
                    end
                end
            end

            currentTarget = bossTarget or bestTarget

            if not validMobFound then
                if not killAllActive and not killTimedBossesActive and next(selectedMobs) == nil then
                    updateStatus("No mobs selected in Combat Tab.")
                else
                    updateStatus("No selected mobs are currently alive.")
                end
                task.wait(0.5)
                continue
            end

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")

                while killAuraActive and not isTraversing and currentTarget and currentTarget.Parent and hum and hum.Health > 0 do
                    local targetPart = getTargetPart(currentTarget)
                    
                    if targetPart then
                        local tPos = targetPart.Position
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        
                        if hrp then
                            local dist = (hrp.Position - tPos).Magnitude
                            
                            if dist > 2500 then
                                task.spawn(function() SmartTraverse(tPos) end)
                                task.wait(1)
                                break
                            elseif dist > 15 then
                                TweenToAsync(tPos)
                            else
                                if activeTween then activeTween:Cancel(); activeTween = nil end
                                DisableNoclip()
                                
                                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tPos.X, hrp.Position.Y, tPos.Z))
                                equipWeapon(selectedWeapon)

                                local success, err = FireRemoteHit(tPos)
                                if not success then
                                    updateStatus("⚠️ REMOTE ERROR: " .. tostring(err))
                                else
                                    updateStatus("Target: " .. currentTarget.Name .. " | HP: " .. tostring(math.floor(hum.Health)))
                                end
                            end
                        end
                    end
                    task.wait(0.35)
                end
            end
            task.wait(0.1)
        end
    end)
end

local function stopKillAura()
    killAuraActive = false
    updateStatus("KillAura Stopped. Idle.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
    if activeTween then activeTween:Cancel() end
    DisableNoclip()
end

