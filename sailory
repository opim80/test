-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function getLocalPortal()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local closestPortal = nil
    local shortestDistance = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.match(string.lower(obj.Name), "^portal_") then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                closestPortal = obj
            end
        end
    end
    return closestPortal
end

local function getClosestIslandTo(targetPos)
    local bestIsland = "Starter"
    local shortestDist = math.huge
    for islandName, portalPos in pairs(CachedPortals) do
        local dist = (portalPos - targetPos).Magnitude
        if dist < shortestDist then
            shortestDist = dist
            bestIsland = islandName
        end
    end
    return bestIsland
end

local function tweenTo(targetPos, customStatus)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local dist = (hrp.Position - targetPos).Magnitude
    local msg = customStatus and (customStatus .. " | Dist: " .. math.floor(dist)) or ("Tweening... Dist: " .. math.floor(dist))
    updateStatus(msg)
    
    local timeToTravel = dist / tweenSpeed
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function teleportViaPortal(islandName)
    local localPortal = getLocalPortal()
    if localPortal then
        tweenTo(localPortal.Position, "Heading to Portal for " .. islandName)
        task.wait(0.5)
        local args = { islandName }
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        task.wait(3.5) -- Wait for portal stun AND streaming load time
        return true
    end
    updateStatus("⚠️ Error: No local portal found to teleport.")
    return false
end

-- [[ KAITUN LOGIC ]]
local function abandonQuest()
    local args = { "repeatable" }
    ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(args))
end

local function calibrateDamage()
    updateStatus("Calibrating Damage... Striking Mob.")
    task.wait(1)
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local dmgLabel = pGui:FindFirstChild("DamageCounterUI") 
            and pGui.DamageCounterUI:FindFirstChild("DamageFrame")
            and pGui.DamageCounterUI.DamageFrame:FindFirstChild("Holder")
            and pGui.DamageCounterUI.DamageFrame.Holder:FindFirstChild("StatFrame")
            and pGui.DamageCounterUI.DamageFrame.Holder.StatFrame:FindFirstChild("DamageLabel")
        
        if dmgLabel and dmgLabel.Text ~= "" then
            PlayerDPS = tonumber(string.match(dmgLabel.Text, "%d+")) or 100
        else
            PlayerDPS = 100 
        end
    end
    updateStatus("Damage Calibrated: " .. tostring(PlayerDPS) .. " per M1")
end

local function getQuestData(npcName)
    updateStatus("Interacting with " .. npcName)
    ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npcName)
    task.wait(1.5)

    local pName = LocalPlayer.Name
    local questUI = game:GetService("Players")[pName].PlayerGui:FindFirstChild("QuestUI")
    if questUI then
        local expInd = questUI.Quest.Reward.RewardExp:FindFirstChild("CurrencyIndicator")
        local reqLabel = questUI.Quest.Quest.Holder.Content.QuestInfo:FindFirstChild("QuestRequirement")
        
        if expInd and reqLabel then
            CachedQuests[npcName] = {
                Exp = expInd.Text,
                Requirement = reqLabel.Text
            }
            abandonQuest()
            task.wait(0.5)
            return true
        end
    end
    abandonQuest()
    return false
end

local function cacheSingleQuest(npcCount, totalQuestNPCs)
    local npcName = "QuestNPC" .. npcCount
    local serviceNPCs = workspace:WaitForChild("ServiceNPCs")
    local npc = serviceNPCs:FindFirstChild(npcName)
    
    if not npc then return false end

    local targetPos = npc:GetPivot().Position
    local currentDist = (LocalPlayer.Character.HumanoidRootPart.Position - targetPos).Magnitude
    
    -- If we are far away, use our CachedPortals to find the fastest route instantly
    if currentDist > 450 then
        local bestIsland = getClosestIslandTo(targetPos)
        updateStatus("[Routing " .. npcCount .. "/" .. totalQuestNPCs .. "] Teleporting to closest island: " .. bestIsland)
        teleportViaPortal(bestIsland)
    end

    local statusStr = "[Caching Quests " .. npcCount .. "/" .. totalQuestNPCs .. "] Target: " .. npcName
    tweenTo(targetPos, statusStr)
    return getQuestData(npcName)
end

local function initializeKaitun()
    if IsInitialized then return end
    
    -- ==========================================
    -- PHASE 1: THE PORTAL TOUR & VERIFICATION
    -- ==========================================
    updateStatus("[Phase 1/2] Resetting to map portals...")
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.Health = 0
        LocalPlayer.CharacterAdded:Wait()
        task.wait(3) 
    end

    local firstPortal = getLocalPortal()
    if firstPortal then CachedPortals["Starter"] = firstPortal.Position end

    -- Initial Portal Pass
    for i = 2, #Islands do
        local targetIsland = Islands[i]
        updateStatus("[Phase 1/2] Mapping Portal: " .. targetIsland .. " (" .. i .. "/" .. #Islands .. ")")
        teleportViaPortal(targetIsland)
        local newPortal = getLocalPortal()
        if newPortal then CachedPortals[targetIsland] = newPortal.Position end
    end

    -- Portal Verification Sweep
    for _, targetIsland in ipairs(Islands) do
        if not CachedPortals[targetIsland] then
            updateStatus("⚠️ Double-Checking missed portal: " .. targetIsland)
            teleportViaPortal(targetIsland)
            local retryPortal = getLocalPortal()
            if retryPortal then CachedPortals[targetIsland] = retryPortal.Position end
        end
    end

    -- ==========================================
    -- PHASE 2: QUEST CACHING & VERIFICATION
    -- ==========================================
    updateStatus("[Phase 2/2] Portals mapped. Returning to Starter to begin Quests.")
    teleportViaPortal("Starter")
    
    local serviceNPCs = workspace:WaitForChild("ServiceNPCs")
    local totalQuestNPCs = 0
    for _, obj in ipairs(serviceNPCs:GetChildren()) do
        if string.match(obj.Name, "^QuestNPC%d+$") then totalQuestNPCs = totalQuestNPCs + 1 end
    end

    -- Initial Quest Pass
    for i = 1, totalQuestNPCs do
        cacheSingleQuest(i, totalQuestNPCs)
    end

    -- Quest Verification Sweep
    local missingQuests = {}
    for i = 1, totalQuestNPCs do
        if not CachedQuests["QuestNPC" .. i] then table.insert(missingQuests, i) end
    end

    local retryAttempts = 0
    while #missingQuests > 0 and retryAttempts < 3 do
        retryAttempts = retryAttempts + 1
        for _, missingNum in ipairs(missingQuests) do
            updateStatus("⚠️ Double-Checking missed quest: QuestNPC" .. missingNum .. " (Retry " .. retryAttempts .. ")")
            cacheSingleQuest(missingNum, totalQuestNPCs)
        end
        
        -- Re-evaluate missing quests
        missingQuests = {}
        for i = 1, totalQuestNPCs do
            if not CachedQuests["QuestNPC" .. i] then table.insert(missingQuests, i) end
        end
    end

    calibrateDamage()
    IsInitialized = true
    updateStatus("Initialization Complete. Ready to Farm.")
end

local function startKaitunLoop()
    task.spawn(function()
        initializeKaitun()
        while kaitunActive do
            updateStatus("Calculating most efficient quest based on cached data...")
            task.wait(2)
            -- Add efficiency algorithm here based on CachedQuests and PlayerDPS
        end
    end)
end

-- [[ BOSS FARM LOGIC ]]
local function startBossFarm()
    task.spawn(function()
        while killAllBossesActive do
            local foundBoss = false
            for _, obj in ipairs(workspace:FindFirstChild("NPCs"):GetChildren()) do
                if string.match(string.lower(obj.Name), "boss_") then
                    foundBoss = true
                    local targetHrp = obj:FindFirstChild("HumanoidRootPart")
                    local hum = obj:FindFirstChild("Humanoid")
                    
                    if targetHrp and hum and hum.Health > 0 then
                        local dist = (LocalPlayer.Character.HumanoidRootPart.Position - targetHrp.Position).Magnitude
                        if dist > 300 then
                            updateStatus("Boss > 300 studs away. Using Portals...")
                            teleportViaPortal("Boss")
                        end
                        tweenTo(targetHrp.Position, "Tweening to Boss")
                        updateStatus("Killing Boss: " .. obj.Name)
                        -- Add M1 Remote Fire Here
                    end
                end
            end
            if not foundBoss then updateStatus("Waiting for timed bosses to spawn...") end
            task.wait(1)
        end
    end)
end

