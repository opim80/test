-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function parseShortNumber(str)
    str = string.lower(tostring(str))
    local num = tonumber(string.match(str, "[%d%.]+")) or 0
    if string.find(str, "k") then num = num * 1e3
    elseif string.find(str, "m") then num = num * 1e6
    elseif string.find(str, "b") then num = num * 1e9 end
    return num
end

local function getNearestPortal()
    local nearest, minDist = nil, math.huge
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.sub(v.Name, 1, 7) == "portal_" then
            local dist = (hrp.Position - v.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = v
            end
        end
    end
    return nearest
end

local function tweenTo(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local dist = (hrp.Position - targetPos).Magnitude
    local timeToTween = dist / tweenSpeed
    
    local tweenInfo = TweenInfo.new(timeToTween, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function smartTravel(targetPos, targetIsland)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - targetPos).Magnitude
    if dist > 300 then
        updateStatus("Target > 300 studs. Pathfinding via Portal...")
        local portal = getNearestPortal()
        if portal then
            tweenTo(portal.Position)
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(targetIsland)
            task.wait(3) -- Portal stun
        end
    end
    tweenTo(targetPos)
end

-- [[ INITIALIZATION & CACHING PHASE ]]
local function InitializeKaitun()
    updateStatus("Initializing Cache: Force Resetting for clean state...")
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.Health = 0
    end
    LocalPlayer.CharacterAdded:Wait()
    repeat task.wait() until LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    task.wait(1)

    updateStatus("Beginning Island Traversal & Data Extraction...")
    
    for _, island in ipairs(Islands) do
        local portal = getNearestPortal()
        if portal then
            tweenTo(portal.Position)
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(island)
            task.wait(3) 
            
            for _, npc in ipairs(workspace:GetDescendants()) do
                if npc.Name:match("^QuestNPC%d+$") and npc:FindFirstChild("HumanoidRootPart") then
                    updateStatus("Extracting data from: " .. npc.Name .. " on " .. island)
                    smartTravel(npc.HumanoidRootPart.Position, island)
                    
                    -- Accept Quest to populate GUI
                    ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npc.Name)
                    task.wait(1)
                    
                    -- Exact GUI Paths Requested
                    local expStr = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Reward.RewardExp.CurrencyIndicator.Text
                    local reqStr = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text
                    
                    local expReward = parseShortNumber(expStr)
                    local requiredKills = tonumber(string.match(reqStr, "/(%d+)")) or 1
                    local targetMob = string.match(reqStr, "Defeat%s+(.*)") or "Unknown"
                    
                    QuestCache[npc.Name] = {
                        Island = island,
                        Exp = expReward,
                        Req = requiredKills,
                        Mob = targetMob,
                        Position = npc.HumanoidRootPart.Position
                    }
                    
                    -- Abandon Quest
                    ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer("repeatable")
                    task.wait(0.5)
                end
            end
        end
    end
    updateStatus("Cache Complete. Calculating optimal Kaitun path...")
end

-- [[ THE KAITUN ENGINE ]]
local function StartKaitunEngine()
    if auraTask then task.cancel(auraTask) end
    
    auraTask = task.spawn(function()
        InitializeKaitun()
        
        while KaitunActive do
            -- 1. Timed Boss Override
            local bossTarget = nil
            for _, mob in ipairs(workspace:GetDescendants()) do
                if string.sub(mob.Name, 1, 5):lower() == "boss_" and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                    bossTarget = mob
                    break
                end
            end

            if bossTarget then
                updateStatus("TIMED BOSS DETECTED: Eliminating " .. bossTarget.Name)
                if bossTarget:FindFirstChild("HumanoidRootPart") then
                    smartTravel(bossTarget.HumanoidRootPart.Position, "Boss")
                    -- Insert KillAura strike logic here
                    ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit"):FireServer(bossTarget.HumanoidRootPart.Position)
                    task.wait(0.35)
                end
                continue 
            end

            -- 2. Update DPS Profiling via UI
            local dmgUI = game:GetService("Players")[LocalPlayer.Name].PlayerGui:FindFirstChild("DamageCounterUI")
            if dmgUI and dmgUI.DamageFrame.Holder.StatFrame.DamageLabel.Text ~= "" then
                M1Damage = parseShortNumber(dmgUI.DamageFrame.Holder.StatFrame.DamageLabel.Text)
            end

            -- 3. Find Best Quest
            local bestRatio = 0
            local targetQuestName = nil
            
            for qName, qData in pairs(QuestCache) do
                -- Dummy calculation: Assumes all mobs have 1000 health if not scanned yet. 
                -- In reality, we'd scan the mob health here, but we default to baseline for efficiency check.
                local estimatedTTK = (1000 / M1Damage) * 0.4 
                local totalTime = estimatedTTK * qData.Req
                local ratio = qData.Exp / totalTime
                
                if ratio > bestRatio then
                    bestRatio = ratio
                    targetQuestName = qName
                end
            end

            -- 4. Execute Quest
            if targetQuestName then
                local qData = QuestCache[targetQuestName]
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - qData.Position).Magnitude
                    updateStatus("Best Quest: " .. targetQuestName .. " | Target: " .. qData.Mob .. " | Dist: " .. math.floor(dist))
                    
                    local activeQuest = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Visible
                    if not activeQuest then
                        smartTravel(qData.Position, qData.Island)
                        ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(targetQuestName)
                        task.wait(1)
                    else
                        -- Find target mob and kill
                        for _, mob in ipairs(workspace:GetDescendants()) do
                            if string.find(mob.Name, qData.Mob) and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                                if mob:FindFirstChild("HumanoidRootPart") then
                                    smartTravel(mob.HumanoidRootPart.Position, qData.Island)
                                    ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit"):FireServer(mob.HumanoidRootPart.Position)
                                end
                                break
                            end
                        end
                    end
                end
            end
            
            task.wait(0.35)
        end
    end)
end

