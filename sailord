-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
    print("[Ultimate Hub] " .. msg)
end

local function updateCacheViewer()
    if not CacheDisplay then return end
    local text = "M1 Damage Cached: " .. tostring(GlobalCache.M1Damage) .. "\n\n"
    
    -- Sort keys to display nicely
    local sortedKeys = {}
    for k in pairs(GlobalCache.Quests) do table.insert(sortedKeys, k) end
    table.sort(sortedKeys, function(a, b) 
        local numA = tonumber(string.match(a, "%d+")) or 0
        local numB = tonumber(string.match(b, "%d+")) or 0
        return numA < numB
    end)

    for _, npcName in ipairs(sortedKeys) do
        local data = GlobalCache.Quests[npcName]
        text = text .. "[" .. data.Island .. "] " .. npcName .. " -> Kill " .. data.Amount .. " " .. data.Target .. " (" .. data.Exp .. " EXP)\n"
    end
    
    if text == "M1 Damage Cached: " .. tostring(GlobalCache.M1Damage) .. "\n\n" then
        text = "Nothing cached yet. Run Kaitun to start mapping."
    end
    
    CacheDisplay:SetDesc(text)
end

local function TweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local tweenTime = dist / backupTweenSpeed
    
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    
    if tool and humanoid and tool.Parent ~= char then 
        humanoid:EquipTool(tool) 
    end
end

local function ParseShortenedNumber(str)
    str = string.lower(tostring(str))
    local num = tonumber(string.match(str, "[%d%.]+")) or 0
    if string.find(str, "k") then num = num * 1000
    elseif string.find(str, "m") then num = num * 1000000
    elseif string.find(str, "b") then num = num * 1000000000 end
    return num
end

-- [[ CORE KAITUN & CACHE LOGIC ]]
local function InitializeWorldCache()
    if GlobalCache.Initialized then return end
    updateStatus("Starting World Cache Initialization...")

    local hasResetForPortal = false
    local serviceNPCs = workspace:WaitForChild("ServiceNPCs", 10)

    for _, island in ipairs(IslandsList) do
        updateStatus("Mapping Island: " .. island)
        
        -- Travel Logic
        if not hasResetForPortal then
            updateStatus("Resetting for initial portal_tower...")
            LocalPlayer.Character:BreakJoints()
            LocalPlayer.CharacterAdded:Wait()
            task.wait(1)
            local portalTower = workspace:FindFirstChild("portal_tower", true)
            if portalTower then TweenTo(portalTower.CFrame) end
            hasResetForPortal = true
        else
            -- Find local portal on current island to tween to before TP
            local localPortal = workspace:FindFirstChild("portal_", true)
            if localPortal then TweenTo(localPortal.CFrame) end
        end

        -- Teleport
        local args = { island }
        pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args)) end)
        task.wait(3.5) -- Wait for portal movement lock

        -- Cache Island Portal
        local newPortal = workspace:FindFirstChild("portal_", true)
        if newPortal then
            GlobalCache.Portals[island] = newPortal.Position
        end

        -- Gather and Sort Quests on THIS island
        if serviceNPCs then
            local localQuests = {}
            local myPos = LocalPlayer.Character:GetPivot().Position
            
            for _, npc in ipairs(serviceNPCs:GetChildren()) do
                local numStr = string.match(npc.Name, "^Quest(%d+)$")
                if numStr then
                    local npcPos = npc:GetPivot().Position
                    local dist = (myPos - npcPos).Magnitude
                    
                    -- Only grab quests within 3500 studs (ensures they are on the current island)
                    if dist < 3500 then
                        table.insert(localQuests, { instance = npc, num = tonumber(numStr), pos = npcPos })
                    end
                end
            end
            
            -- Sort numerically (Quest1, Quest2, Quest3...)
            table.sort(localQuests, function(a, b) return a.num < b.num end)

            -- Tween and Cache in order
            for _, qData in ipairs(localQuests) do
                local npc = qData.instance
                updateStatus("Caching " .. npc.Name .. "...")
                TweenTo(CFrame.new(qData.pos))
                task.wait(0.5)
                
                -- Accept
                pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npc.Name) end)
                task.wait(1)

                -- Extract Exact Data
                local expText = "0"
                local reqText = ""
                
                pcall(function()
                    expText = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Reward.RewardExp.CurrencyIndicator.Text
                    reqText = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text
                end)

                local targetName = string.match(reqText, "Defeat%s+(.*)s?%!") or string.match(reqText, "Defeat%s+(.*)") or reqText
                local requiredAmount = tonumber(string.match(reqText, "(%d+)")) or 1

                GlobalCache.Quests[npc.Name] = {
                    Island = island,
                    Target = targetName,
                    Amount = requiredAmount,
                    Exp = ParseShortenedNumber(expText),
                    Position = qData.pos
                }
                
                updateCacheViewer()

                -- Abandon
                local abandonArgs = { "repeatable" }
                pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(abandonArgs)) end)
                task.wait(0.5)
            end
        end
    end

    -- DPS Test
    updateStatus("Calculating M1 Damage...")
    pcall(function()
        GlobalCache.M1Damage = tonumber(game:GetService("Players")[LocalPlayer.Name].PlayerGui.DamageCounterUI.DamageFrame.Holder.StatFrame.DamageLabel.Text) or 1
    end)
    
    if GlobalCache.M1Damage <= 1 then GlobalCache.M1Damage = 500 end -- Fallback
    updateCacheViewer()

    GlobalCache.Initialized = true
    updateStatus("Cache Complete. Ready for Kaitun.")
end

local function GetMostEfficientQuest()
    local bestQuestName = nil
    local bestQuestData = nil
    local highestExpPerSec = 0

    for npcName, data in pairs(GlobalCache.Quests) do
        -- Find target mob health to calculate TTK (Defaulting to a baseline if we can't read it yet)
        local mobHP = 5000 
        local timeToKillOne = (mobHP / GlobalCache.M1Damage) * 0.4
        local totalTTK = timeToKillOne * data.Amount
        
        local expPerSec = data.Exp / (totalTTK + 1) -- +1 to prevent div by 0

        if expPerSec > highestExpPerSec then
            highestExpPerSec = expPerSec
            bestQuestName = npcName
            bestQuestData = data
        end
    end
    return bestQuestName, bestQuestData
end

-- [[ KILLAURA / KAITUN LOOP ]]
local function startMasterLoop()
    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        local activeQuestTarget = nil

        while killAuraActive or kaitunActive do
            if kaitunActive and not GlobalCache.Initialized then
                InitializeWorldCache()
            end

            equipWeapon(selectedWeapon)
            local currentTarget = nil
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero
            local npcFolder = workspace:FindFirstChild("NPCs")

            -- 1. Priority: Boss Check
            if killAllTimedBosses and npcFolder then
                local closestBoss = nil
                local closestDist = math.huge
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    if string.find(string.lower(npc.Name), "boss_") then
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            local dist = (charPos - npc:GetPivot().Position).Magnitude
                            if dist < closestDist then
                                closestBoss = npc
                                closestDist = dist
                            end
                        end
                    end
                end
                currentTarget = closestBoss
            end

            -- 2. Kaitun Active Logic (Using Cached Positions)
            if not currentTarget and kaitunActive and GlobalCache.Initialized then
                local bestQuestName, bestQuestData = GetMostEfficientQuest()
                
                -- Check if we need to get the quest
                local questFrame = LocalPlayer.PlayerGui:FindFirstChild("QuestUI") and LocalPlayer.PlayerGui.QuestUI:FindFirstChild("Quest")
                local hasQuest = questFrame and questFrame.Visible
                
                if not hasQuest and bestQuestData then
                    updateStatus("Kaitun: Pathing to " .. bestQuestName .. " on " .. bestQuestData.Island)
                    
                    -- Step 1: Tween to nearest portal to TP
                    local localPortal = workspace:FindFirstChild("portal_", true) or workspace:FindFirstChild("portal_tower", true)
                    if localPortal then TweenTo(localPortal.CFrame) end
                    
                    -- Step 2: Teleport to correct Island
                    local args = { bestQuestData.Island }
                    pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args)) end)
                    task.wait(3.5)
                    
                    -- Step 3: Tween to cached NPC position
                    TweenTo(CFrame.new(bestQuestData.Position))
                    task.wait(0.5)
                    
                    -- Step 4: Accept
                    pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(bestQuestName) end)
                    task.wait(1)
                    
                    activeQuestTarget = bestQuestData.Target
                end
                
                -- Find specific mob for the quest
                if hasQuest and activeQuestTarget and npcFolder then
                    for _, npc in ipairs(npcFolder:GetChildren()) do
                        if string.find(string.lower(npc.Name), string.lower(activeQuestTarget)) then
                            local hum = npc:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 then
                                currentTarget = npc
                                break
                            end
                        end
                    end
                end
            end

            -- 3. Standard KillAura fallback (Kill everything if Kaitun isn't finding stuff)
            if not currentTarget and not kaitunActive and npcFolder then
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    local hum = npc:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        currentTarget = npc
                        break
                    end
                end
            end

            -- 4. Combat Execution
            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                local targetPart = getTargetPart(currentTarget)

                if targetPart and hum and hum.Health > 0 then
                    updateStatus("Engaging: " .. currentTarget.Name)
                    TweenTo(targetPart.CFrame * CFrame.new(0, 0, 3)) -- Tween to hitting distance

                    while currentTarget and currentTarget.Parent and hum.Health > 0 and (killAuraActive or kaitunActive) do
                        -- Boss interrupt check
                        if killAllTimedBosses and not string.find(string.lower(currentTarget.Name), "boss_") then
                            local newBossFound = false
                            for _, n in ipairs(npcFolder:GetChildren()) do
                                if string.find(string.lower(n.Name), "boss_") and n:FindFirstChild("Humanoid") and n.Humanoid.Health > 0 then
                                    newBossFound = true
                                    break
                                end
                            end
                            if newBossFound then break end 
                        end

                        local tPos = targetPart.Position
                        local success, err = pcall(function() 
                            local args = {}
                            if vectorMethod == "vector.create(X, Y, Z)" then
                                args = { vector.create(tPos.X, tPos.Y, tPos.Z) }
                            elseif vectorMethod == "Vector3.new" then
                                args = { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
                            else
                                args = { tPos }
                            end
                            remote:FireServer(unpack(args)) 
                        end)

                        task.wait(0.35)
                    end
                end
            else
                task.wait(0.5) 
            end
        end
    end)
end

local function stopMasterLoop()
    killAuraActive = false
    kaitunActive = false
    updateStatus("Farming Stopped.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
end

