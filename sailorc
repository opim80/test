-- Store new cleanup function globally for the NEXT time you execute
getgenv().CSMDH_Cleanup = function()
    if auraTask then task.cancel(auraTask) end
    if dungeonLoopTask then task.cancel(dungeonLoopTask) end
    if evasionTask then evasionTask:Disconnect() end
    if cameraTask then cameraTask:Disconnect() end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
    
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom
    cam.CameraSubject = char and char:FindFirstChild("Humanoid")
    
    if getgenv().CSMDH_Window then
        pcall(function() getgenv().CSMDH_Window:Destroy() end)
    end
end

-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then
        StatusDisplay:SetDesc(msg)
    end
end

local function getBaseName(name)
    return string.gsub(name, "[_%s%d]+$", "")
end

local function isMobSelected(rawName, baseName)
    if killAllActive then return true end
    if type(selectedMobs) == "table" then
        if selectedMobs[baseName] or selectedMobs[rawName] then return true end
        if table.find(selectedMobs, baseName) or table.find(selectedMobs, rawName) then return true end
    end
    return false
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function getWeapons()
    local weapons = {}
    if LocalPlayer.Backpack then
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") then table.insert(weapons, tool.Name) end
        end
    end
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") then table.insert(weapons, tool.Name) end
        end
    end
    return weapons
end

local function getAvailableMobs()
    local mobs = {}
    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in ipairs(npcFolder:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local baseName = getBaseName(npc.Name)
                if not table.find(mobs, baseName) then table.insert(mobs, baseName) end
            end
        end
    end
    return mobs
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName)
    if tool and humanoid then humanoid:EquipTool(tool) end
end

