-- Store new cleanup function globally
getgenv().CSMDH_Cleanup = function()
    if auraTask then task.cancel(auraTask) end
    if dungeonLoopTask then task.cancel(dungeonLoopTask) end
    if questTask then task.cancel(questTask) end
    if evasionTask then evasionTask:Disconnect() end
    if cameraTask then cameraTask:Disconnect() end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
    
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom
    cam.CameraSubject = char and char:FindFirstChild("Humanoid")
    
    if getgenv().CSMDH_Window then
        pcall(function() getgenv().CSMDH_Window:Destroy() end)
    end
end

-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function getBaseName(name)
    return string.gsub(name, "[_%s%d]+$", "")
end

local function isMobSelected(rawName)
    if killAllActive then return true end
    local baseName = getBaseName(rawName)
    
    if type(selectedMobs) == "table" then
        -- Check if the raw name or base name exists as a key in the selection dictionary
        if selectedMobs[rawName] or selectedMobs[baseName] then return true end
        
        -- Fuzzy check: Check if any of our selected strings are PART of the mob's name
        for selectedName, state in pairs(selectedMobs) do
            if state and (string.find(string.lower(rawName), string.lower(selectedName))) then
                return true
            end
        end
    end
    return false
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function getWeapons()
    local weapons = {}
    if LocalPlayer.Backpack then
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then 
                table.insert(weapons, tool.Name) 
            end
        end
    end
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then 
                table.insert(weapons, tool.Name) 
            end
        end
    end
    if selectedWeapon ~= "" and not table.find(weapons, selectedWeapon) then table.insert(weapons, selectedWeapon) end
    return weapons
end

local function getAvailableMobs()
    local mobs = {}
    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in ipairs(npcFolder:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local baseName = getBaseName(npc.Name)
                if not table.find(mobs, baseName) then table.insert(mobs, baseName) end
            end
        end
    end
    return mobs
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    if tool and humanoid and tool.Parent ~= char then humanoid:EquipTool(tool) end
end

-- [[ CORE MOVEMENT ENGINE ]]
local function startDynamicMovement()
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    evasionTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        local nextX, nextY, nextZ = hrp.Position.X, hrp.Position.Y, hrp.Position.Z
        local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
        local _, groundPos = workspace:FindPartOnRay(ray, char)
        local baseHeight = groundPos and (groundPos.Y + 20) or hrp.Position.Y
        local targetY = baseHeight
        if bounceActive then
            bounceTimer = bounceTimer + deltaTime
            if bounceTimer >= 2 then bounceUp = not bounceUp bounceTimer = 0 end
            targetY = baseHeight + (bounceUp and 10 or 0)
        end

        if isQuesting and currentQuestNPC then
            local tPos = currentQuestNPC:GetPivot().Position
            local direction = (Vector3.new(tPos.X, tPos.Y + 5, tPos.Z) - hrp.Position)
            if direction.Magnitude > 5 then
                local step = direction.Unit * backupTweenSpeed * deltaTime
                nextX, nextY, nextZ = hrp.Position.X + step.X, hrp.Position.Y + step.Y, hrp.Position.Z + step.Z
            end
        else
            -- Follow target or center
            local moveTarget = currentTarget and currentTarget:GetPivot().Position
            if not getTargetPart(currentTarget) and moveTarget then
                local direction = (Vector3.new(moveTarget.X, moveTarget.Y + 20, moveTarget.Z) - hrp.Position)
                local step = direction.Unit * backupTweenSpeed * deltaTime
                nextX, nextY, nextZ = hrp.Position.X + step.X, hrp.Position.Y + step.Y, hrp.Position.Z + step.Z
            end
        end
        local smoothY = hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15
        hrp.CFrame = CFrame.new(nextX, smoothY, nextZ)
    end)
end

-- [[ KILLAURA ATTACK LOOP ]]
local function startKillAura()
    if not killAuraActive then return end
    startDynamicMovement()
    if auraTask then task.cancel(auraTask) end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        while killAuraActive do
            -- Title & Recalibration Checks
            if untilTitleActive then
                local titlesUI = LocalPlayer.PlayerGui:FindFirstChild("TitlesUI")
                local locked = titlesUI and titlesUI.MainFrame.Frame.Content.Holder.Title_TranscendentBeing.BuffButtonsHolder.Locked
                if locked and not locked.Visible then
                    MasterAuraToggle:SetValue(false) break
                end
                if not LocalPlayer.PlayerGui.BossUI.MainFrame.Visible then
                    updateStatus("Boss dead. Auto-Spawning...")
                    ReplicatedStorage.RemoteEvents.RequestSpawnTrueAizen:FireServer("Normal")
                    task.wait(2) continue
                end
            end

            local npcFolder = workspace:FindFirstChild("NPCs")
            if not npcFolder then task.wait(0.5) continue end
            equipWeapon(selectedWeapon)

            local bestTarget = nil
            local bossTarget = nil
            local closestDist = math.huge

            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 and isMobSelected(npc.Name) then
                    local dist = (LocalPlayer.Character.PrimaryPart.Position - npc:GetPivot().Position).Magnitude
                    -- ABSOLUTE BOSS PRIORITY
                    if string.find(string.lower(npc.Name), "boss") or string.find(string.lower(npc.Name), "aizen") then
                        if not bossTarget or dist < closestDist then
                            bossTarget = npc
                            closestDist = dist
                        end
                    elseif not bossTarget and dist < closestDist then
                        bestTarget = npc
                        closestDist = dist
                    end
                end
            end

            currentTarget = bossTarget or bestTarget

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                while killAuraActive and currentTarget and currentTarget.Parent and hum and hum.Health > 0 do
                    local tPart = getTargetPart(currentTarget)
                    if tPart then
                        updateStatus("Attacking: " .. currentTarget.Name .. " | HP: " .. math.floor(hum.Health))
                        pcall(function()
                            local args = { vectorMethod == "Vector3.new" and Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z) or vector.create(tPart.Position.X, tPart.Position.Y, tPart.Position.Z) }
                            if vectorMethod == "Raw Vector3" then args = {tPart.Position} end
                            remote:FireServer(unpack(args))
                        end)
                    end
                    task.wait(0.35)
                end
                currentTarget = nil
            else
                updateStatus("No targets found. Scanning...")
                task.wait(0.5)
            end
        end
    end)
end

