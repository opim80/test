-- Store new cleanup function globally for the NEXT time you execute
getgenv().CSMDH_Cleanup = function()
    if auraTask then task.cancel(auraTask) end
    if dungeonLoopTask then task.cancel(dungeonLoopTask) end
    if evasionTask then evasionTask:Disconnect() end
    if cameraTask then cameraTask:Disconnect() end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Anchored = false
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
    
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom
    cam.CameraSubject = char and char:FindFirstChild("Humanoid")
    
    if getgenv().CSMDH_Window then
        pcall(function() getgenv().CSMDH_Window:Destroy() end)
    end
end

-- [[ UPDATED HELPER FUNCTIONS ]]
local function getBaseName(name)
    return string.gsub(name, "[_%s%d]+$", "")
end

local function isMobSelected(rawName, baseName)
    if killAllActive then return true end
    if type(selectedMobs) == "table" then
        -- Checks both the filtered name (Quincy) and the raw name (Quincy1) just in case
        if selectedMobs[baseName] or selectedMobs[rawName] then return true end
        if table.find(selectedMobs, baseName) or table.find(selectedMobs, rawName) then return true end
    end
    return false
end

local function getTargetPart(npc)
    -- Fallbacks in case the game uses different rig types
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

-- [[ BULLETPROOF KILLAURA LOGIC ]]
local function startKillAura()
    if not killAuraActive then return end
    startDynamicMovement()

    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")

        -- FIX 1: The loop now runs infinitely while toggled, checking for the folder internally
        while killAuraActive do
            local npcFolder = workspace:FindFirstChild("NPCs")
            
            -- If the folder unloads or is missing, wait and try again instead of breaking the script
            if not npcFolder then 
                task.wait(0.5)
                continue 
            end

            equipWeapon(selectedWeapon)
            currentTarget = nil
            
            local bestTarget = nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero

            -- Scan for valid targets
            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                local targetPart = getTargetPart(npc) -- FIX 2: Dynamic part finding
                
                if hum and hum.Health > 0 and targetPart then
                    local baseName = getBaseName(npc.Name)
                    
                    if isMobSelected(npc.Name, baseName) then
                        local dist = (charPos - targetPart.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            bestTarget = npc
                        end
                    end
                end
            end

            currentTarget = bestTarget

            -- If we successfully locked onto a mob
            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                local targetPart = getTargetPart(currentTarget)
                
                if cameraTrackActive then workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable end

                -- Loop attack while target is alive and hasn't despawned
                while killAuraActive and currentTarget and currentTarget.Parent and hum and hum.Health > 0 and targetPart do
                    local tPos = targetPart.Position
                    
                    -- Using vector.create as requested
                    local args = {
                        vector.create(tPos)
                    }
                    
                    pcall(function() 
                        remote:FireServer(unpack(args)) 
                    end)
                    
                    task.wait(0.35)
                end
                
                currentTarget = nil 
            else
                -- Restore camera temporarily if no mobs are currently found
                if cameraTrackActive then workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end
                task.wait(0.5) 
            end
        end
    end)
end
-- [[ CAMERA TRACKING ]]
local function startCameraTracking()
    if cameraTask then cameraTask:Disconnect() end
    local camera = workspace.CurrentCamera
    cameraTask = RunService.RenderStepped:Connect(function()
        if cameraTrackActive and currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, currentTarget.HumanoidRootPart.Position)
        end
    end)
end

local function stopCameraTracking()
    if cameraTask then cameraTask:Disconnect(); cameraTask = nil end
    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
end

-- [[ KILLAURA & MOVEMENT LOGIC ]]
local function startDynamicMovement()
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    evasionTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero

        local targetPos = hrp.Position
        local targetY = hrp.Position.Y

        if currentTarget then
            local tPos = currentTarget:GetPivot().Position
            local dist2D = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(tPos.X, 0, tPos.Z)).Magnitude

            targetY = tPos.Y + 20

            if dist2D > 15 then
                local direction = (tPos - hrp.Position) * Vector3.new(1, 0, 1)
                if direction.Magnitude > 0 then
                    local moveSpeed = 65 
                    local step = direction.Unit * moveSpeed * deltaTime
                    if step.Magnitude > dist2D then step = direction end
                    targetPos = hrp.Position + step
                end
            else
                targetPos = Vector3.new(tPos.X, hrp.Position.Y, tPos.Z)
            end
        else
            local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
            local _, groundPos = workspace:FindPartOnRay(ray, char)
            if groundPos then targetY = groundPos.Y + 20 end
        end

        hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(targetPos.X, targetY, targetPos.Z), 0.15)
    end)
end

local function startKillAura()
    if not killAuraActive then return end
    startDynamicMovement()

    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        local npcFolder = workspace:FindFirstChild("NPCs")
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")

        while killAuraActive and npcFolder do
            equipWeapon(selectedWeapon)
            currentTarget = nil
            
            local bestTarget = nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero

            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                local targetHrp = npc:FindFirstChild("HumanoidRootPart")
                
                if hum and hum.Health > 0 and targetHrp then
                    local baseName = getBaseName(npc.Name)
                    if isMobSelected(baseName) then
                        local dist = (charPos - targetHrp.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            bestTarget = npc
                        end
                    end
                end
            end

            currentTarget = bestTarget

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                local targetHrp = currentTarget:FindFirstChild("HumanoidRootPart")
                
                if cameraTrackActive then workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable end

                while killAuraActive and currentTarget and hum and hum.Health > 0 and targetHrp do
                    local tPos = targetHrp.Position
                    
                    local args = {
                        vector.create(tPos)
                    }
                    
                    pcall(function() 
                        remote:FireServer(unpack(args)) 
                    end)
                    
                    task.wait(0.35)
                end
                
                currentTarget = nil 
            else
                if cameraTrackActive then workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end
                task.wait(0.5) 
            end
        end
    end)
end

local function stopKillAura()
    killAuraActive = false
    currentTarget = nil
    if auraTask then task.cancel(auraTask); auraTask = nil end
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
end

-- [[ STATS LOGIC ]]
local function startAutoStats()
    task.spawn(function()
        while autoStatActive do
            local statPointsFolder = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("StatPoints")
            if statPointsFolder and tonumber(statPointsFolder.Value) >= statAmount then
                local args = { statTarget, statAmount }
                pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("AllocateStat"):FireServer(unpack(args)) end)
            end
            task.wait(1)
        end
    end)
end

-- [[ RAIDS LOGIC ]]
local function startAutoDungeon()
    if dungeonLoopTask then task.cancel(dungeonLoopTask); dungeonLoopTask = nil end

    dungeonLoopTask = task.spawn(function()
        while autoDungeonActive do
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local dungeonUI = playerGui and playerGui:FindFirstChild("DungeonUI")
            
            if dungeonUI then
                local replayFrame = dungeonUI:FindFirstChild("ReplayDungeonFrameVisibleOnlyWhenClearingDungeon")
                local contentFrame = dungeonUI:FindFirstChild("ContentFrame")
                
                if replayFrame and replayFrame.Visible then
                    local args = {"sponsor"}
                    pcall(function()
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DungeonWaveReplayVote"):FireServer(unpack(args))
                    end)
                elseif contentFrame and contentFrame.Visible then
                    pcall(function()
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DungeonWaveVote"):FireServer(selectedDifficulty)
                    end)
                    
                    if not killAuraActive then
                        killAllActive = true 
                        killAuraActive = true
                        startKillAura()
                    end
                elseif autoRequestActive then
                    pcall(function()
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RequestDungeonPortal"):FireServer(selectedDungeon)
                    end)
                end
            end
            task.wait(2)
        end
    end)
end

