-- Wait for Game & Player to load completely
if not game:IsLoaded() then game.Loaded:Wait() end
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

repeat task.wait() until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- State Variables
local killAuraActive = false
local killAllActive = false
local selectedMob = ""
local selectedWeapon = ""
local auraTask = nil
local evasionTask = nil

local autoStatActive = false
local statTarget = "Melee"
local statAmount = 1

local autoDungeonActive = false
local selectedDungeon = "Double"
local selectedDifficulty = "Easy"
local dungeonLoopTask = nil

-- [[ HELPER FUNCTIONS ]]

local function getWeapons()
    local weapons = {}
    if LocalPlayer.Backpack then
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") then table.insert(weapons, tool.Name) end
        end
    end
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") then table.insert(weapons, tool.Name) end
        end
    end
    return weapons
end

local function getAvailableMobs()
    local mobs = {}
    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in ipairs(npcFolder:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                if not table.find(mobs, npc.Name) then table.insert(mobs, npc.Name) end
            end
        end
    end
    return mobs
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName)
    if tool and humanoid then humanoid:EquipTool(tool) end
end

-- [[ KILLAURA & EVASION LOGIC ]]

local function startDynamicEvasion()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Break Velocity
    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero
    
    local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
    local hitPart, groundPos = workspace:FindPartOnRay(ray, char)
    local baseGroundY = groundPos and groundPos.Y or hrp.Position.Y

    local bounceUp = false
    local bounceTimer = 0

    evasionTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        
        local npcFolder = workspace:FindFirstChild("NPCs")
        local closestDist = math.huge
        local closestNPCY = baseGroundY

        -- Find closest NPC
        if npcFolder then
            for _, npc in ipairs(npcFolder:GetChildren()) do
                local targetHrp = npc:FindFirstChild("HumanoidRootPart")
                local hum = npc:FindFirstChild("Humanoid")
                if targetHrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - targetHrp.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestNPCY = targetHrp.Position.Y
                    end
                end
            end
        end

        local targetY
        if closestDist <= 50 then
            -- Proximity Evasion
            targetY = closestNPCY + 70
        else
            -- Bounce Mechanics
            bounceTimer = bounceTimer + deltaTime
            if bounceTimer >= 2 then -- Swap every 2 seconds
                bounceUp = not bounceUp
                bounceTimer = 0
            end
            targetY = baseGroundY + (bounceUp and 20 or 10)
        end

        -- Lerp for smooth movement instead of snapping
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position.X, targetY, hrp.Position.Z), 0.1)
    end)
end

local function startKillAura()
    if not killAuraActive then return end
    
    startDynamicEvasion()

    auraTask = task.spawn(function()
        local npcFolder = workspace:FindFirstChild("NPCs")
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")

        while killAuraActive and npcFolder do
            equipWeapon(selectedWeapon)
            local targetToKill = nil

            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                local targetHrp = npc:FindFirstChild("HumanoidRootPart")
                if hum and targetHrp and hum.Health > 0 then
                    if killAllActive or npc.Name == selectedMob then
                        targetToKill = npc
                        break 
                    end
                end
            end

            if targetToKill then
                local hum = targetToKill:FindFirstChild("Humanoid")
                local targetHrp = targetToKill:FindFirstChild("HumanoidRootPart")
                
                while killAuraActive and hum and hum.Health > 0 and targetHrp do
                    pcall(function()
                        remote:FireServer(Vector3.new(targetHrp.Position.X, targetHrp.Position.Y, targetHrp.Position.Z))
                    end)
                    task.wait(0.35)
                end
            else
                task.wait(0.5) 
            end
        end
    end)
end

local function stopKillAura()
    killAuraActive = false
    if auraTask then task.cancel(auraTask); auraTask = nil end
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
end

-- [[ STATS LOGIC ]]
local function startAutoStats()
    task.spawn(function()
        while autoStatActive do
            local statPointsFolder = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("StatPoints")
            if statPointsFolder and tonumber(statPointsFolder.Value) >= statAmount then
                local args = { statTarget, statAmount }
                pcall(function()
                    ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("AllocateStat"):FireServer(unpack(args))
                end)
            end
            task.wait(1) -- Check every second
        end
    end)
end

-- [[ RAIDS LOGIC ]]
local function startAutoDungeon()
    dungeonLoopTask = task.spawn(function()
        while autoDungeonActive do
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local dungeonUI = playerGui and playerGui:FindFirstChild("DungeonUI")
            
            if dungeonUI and dungeonUI:FindFirstChild("ContentFrame") and dungeonUI.ContentFrame.Visible then
                pcall(function()
                    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DungeonWaveVote"):FireServer(selectedDifficulty)
                end)
                
                -- Ensure aura turns on when dungeon starts
                if not killAuraActive then
                    killAllActive = true 
                    killAuraActive = true
                    startKillAura()
                end
            end
            task.wait(2)
        end
    end)
end

