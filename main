-- Get the current game's Place ID
local currentPlaceId = game.PlaceId

-- Table mapping Place IDs to their specific raw script URLs
local scriptHub = {
    [99449877692519] = "https://raw.githubusercontent.com/username/repo/main/game1.lua",
    [77747658251236] = "https://raw.githubusercontent.com/opim80/test/refs/heads/main/sailorbest",
}

-- Check if the current Place ID exists in our table
local scriptUrl = scriptHub[currentPlaceId]

if scriptUrl then
    print("Detected supported game! Loading script for Place ID: " .. currentPlaceId)
    
    -- pcall (protected call) prevents the whole script from breaking if the loadstring fails
    local success, errorMessage = pcall(function()
        loadstring(game:HttpGet(scriptUrl))()
    end)

    if not success then
        warn("Failed to load the script: " .. tostring(errorMessage))
    end
else
    print("No specific script assigned for Place ID: " .. currentPlaceId)
    
    -- Optional: You can put a default/universal script here
    -- loadstring(game:HttpGet("https://raw.githubusercontent.com/username/repo/main/universal.lua"))()
end
