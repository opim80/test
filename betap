Tabs.Debug:AddSection("Animation Player")
local AnimInput = Tabs.Debug:AddInput("PlayAnimId", {Title = "Animation ID", Default = "rbxassetid://123456789"})
Tabs.Debug:AddButton({Title = "Play Animation on LocalPlayer", Callback = function()
    pcall(function()
        local lp = game:GetService("Players").LocalPlayer
        local char = lp.Character
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        local animator = hum:FindFirstChildOfClass("Animator") or hum
        
        local animId = Fluent.Options.PlayAnimId and Fluent.Options.PlayAnimId.Value or ""
        -- Auto-format if they just put numbers
        if tonumber(animId) then animId = "rbxassetid://" .. animId end
        
        local anim = Instance.new("Animation")
        anim.AnimationId = animId
        
        local track = animator:LoadAnimation(anim)
        track:Play()
        Fluent:Notify({Title = "Animation", Content = "Playing: " .. animId, Duration = 2})
    end)
end})

Tabs.Debug:AddButton({Title = "Stop Animation", Callback = function()
    pcall(function()
        local lp = game:GetService("Players").LocalPlayer
        local char = lp.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator") or hum
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop()
        end
        Fluent:Notify({Title = "Animation", Content = "Stopped all tracks.", Duration = 2})
    end)
end})

