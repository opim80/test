local function getIntoRaid()
    task.spawn(function()
        local lp = game:GetService("Players").LocalPlayer
        local char = lp.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart
        local VirtualInputManager = game:GetService("VirtualInputManager")
        
        updateRaidStatus("Pathing to Raid Entrance...")
        debugPrint("Pathing to Raid Entrance (Vector3 Sequence)...")
        
        -- Exact Pathing Sequence to avoid Anti-Cheat kicks
        local tpSeq = {
            Vector3.new(1232, 709.1, 473),
            Vector3.new(1218.646, 1777.767, -834.123),
            Vector3.new(1194.452, 1761.865, -828.518),
            Vector3.new(161.865, 154.31, -216.054),
            Vector3.new(139.943, 139.579, -169.602),
            Vector3.new(1005, 1680, -845),
            Vector3.new(1024, 1661.17, -825),
            Vector3.new(84, 78, -40),
            Vector3.new(84, 44, -9)
        }
        
        for _, pos in ipairs(tpSeq) do
            if not raidActive then break end
            hrp.CFrame = CFrame.new(pos)
            task.wait(0.1)
        end
        
        if not raidActive then return end
        updateRaidStatus("Firing Raid Prompts...")
        
        -- Function to force-fire a prompt
        local function forceTriggerPrompt(prompt)
            prompt.RequiresLineOfSight = false
            prompt.HoldDuration = 0
            prompt.MaxActivationDistance = 50
            
            hrp.CFrame = prompt.Parent.CFrame
            task.wait(0.2)
            
            debugPrint("Firing Prompt: " .. prompt.Parent.Name)
            pcall(function() fireproximityprompt(prompt) end)
            
            -- Fallback: Native 'E' keypress in case executor blocks fireproximityprompt
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
        
        local interactable = Workspace:FindFirstChild("Interactable")
        if interactable then
            local raids = interactable:FindFirstChild("raids")
            if raids then
                local target = Fluent.Options.TargetRaid and Fluent.Options.TargetRaid.Value or "Zombie Raid"
                local raidFolder = nil
                
                if target == "Mansion" then
                    raidFolder = raids:FindFirstChild("Mansion")
                elseif target == "Zombie Raid" then
                    raidFolder = raids:FindFirstChild("ZombieRaid")
                end
                
                if raidFolder and raidFolder:FindFirstChild("Trigger") then
                    local prompt = raidFolder.Trigger:FindFirstChild("ProximityPrompt")
                    if prompt then
                        debugPrint("Found target prompt for: " .. target)
                        forceTriggerPrompt(prompt)
                    else
                        debugPrint("No ProximityPrompt found in " .. target .. " trigger.")
                    end
                else
                    debugPrint(target .. " not found in Workspace.Interactable.raids")
                end
            end
        end
        
        if raidActive then
            updateRaidStatus("Entered Raid! (Waiting for map load)")
        end
    end)
end

local function toggleRaidLoop()
    if raidActive then
        -- Stop Raid
        raidActive = false
        if raidLoopConnection then
            raidLoopConnection:Disconnect()
            raidLoopConnection = nil
        end
        updateRaidStatus("Stopped.")
        
        -- Restore Collisions
        local map = Workspace:FindFirstChild("map")
        if map then
            local rokyo = map:FindFirstChild("Rokyo")
            if rokyo then
                local obj1145 = rokyo:FindFirstChild("1145")
                if obj1145 and obj1145:IsA("BasePart") then
                    obj1145.CanCollide = true
                end
            end
        end
        return
    end
    
    -- Start Raid
    raidActive = true
    updateRaidStatus("Starting Raid Routine...")
    
    if Fluent.Options.RaidAutoEnterToggle and Fluent.Options.RaidAutoEnterToggle.Value then
        getIntoRaid()
    else
        updateRaidStatus("Active (Clipping, Anti-Blur, Prompts)")
    end
    
    raidLoopConnection = RunService.RenderStepped:Connect(function()
        if not raidActive then return end
        
        -- 1. Wall Clipping Logic (Rokyo 1145)
        local map = Workspace:FindFirstChild("map")
        if map then
            local rokyo = map:FindFirstChild("Rokyo")
            if rokyo then
                local obj1145 = rokyo:FindFirstChild("1145")
                if obj1145 and obj1145:IsA("BasePart") then
                    if Fluent.Options.RaidNoClipToggle and Fluent.Options.RaidNoClipToggle.Value then
                        obj1145.CanCollide = false
                    end
                end
            end
        end
        
        -- 2. Anti-Blur (Lighting Effects)
        if Fluent.Options.RaidAntiBlurToggle and Fluent.Options.RaidAntiBlurToggle.Value then
            for i = 1, 3 do
                local blur = Lighting:FindFirstChild("RaidBlur" .. i)
                if blur and blur:IsA("BlurEffect") then
                    blur.Size = 0
                    blur.Enabled = false
                end
            end
        end
        
        -- 3. Instant Proximity Prompts (Mansion & ZombieRaid)
        if Fluent.Options.RaidInstantPromptToggle and Fluent.Options.RaidInstantPromptToggle.Value then
            local interactable = Workspace:FindFirstChild("Interactable")
            if interactable then
                local raids = interactable:FindFirstChild("raids")
                if raids then
                    local mansion = raids:FindFirstChild("Mansion")
                    if mansion then
                        local trigger = mansion:FindFirstChild("Trigger")
                        if trigger then
                            local prompt = trigger:FindFirstChild("ProximityPrompt")
                            if prompt and prompt:IsA("ProximityPrompt") then
                                prompt.HoldDuration = 0
                            end
                        end
                    end
                    
                    local zombieRaid = raids:FindFirstChild("ZombieRaid")
                    if zombieRaid then
                        local trigger2 = zombieRaid:FindFirstChild("Trigger")
                        if trigger2 then
                            local prompt2 = trigger2:FindFirstChild("ProximityPrompt")
                            if prompt2 and prompt2:IsA("ProximityPrompt") then
                                prompt2.HoldDuration = 0
                            end
                        end
                    end
                end
            end
        end
    end)
end

-- [[ TESTING FUNCTIONS ]]
local function initParry()
    local lp = game:GetService("Players").LocalPlayer
    local VirtualInputManager = game:GetService("VirtualInputManager")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local oldNamecall
    
    local function fireParryEvent(requiredKey)
        if not Fluent or not Fluent.Options then return end
        
        debugPrint("fireParryEvent triggered! Required key: " .. tostring(requiredKey))
        
        -- Respect Toggles based on mapped key
        if requiredKey == "Q" and not Fluent.Options.AutoDodgeToggle.Value then return end
        if requiredKey == "m1" and not Fluent.Options.AutoAttackToggle.Value then return end
        if (requiredKey ~= "Q" and requiredKey ~= "m1") and not Fluent.Options.AutoParryToggle.Value then return end

        pcall(function()
            if requiredKey == "m1" then
                if mouse1click then
                    mouse1click()
                else
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end
                return
            end

            local method = Fluent.Options.ParryMethod and Fluent.Options.ParryMethod.Value or "Keypress"
            
            -- Unblockables (Q) MUST be physically dashed. You cannot "parry" them via remote.
            if requiredKey == "Q" then
                method = "Keypress"
            end
            
            if method == "Remote Event" then
                local args = { "unfair" }
                local eventsFolder = ReplicatedStorage:WaitForChild("events", 3)
                if eventsFolder then
                    local remote = eventsFolder:WaitForChild("remote", 3)
                    if remote then
                        remote:FireServer(unpack(args))
                    end
                end
            else
                local rawKey = requiredKey or (Fluent.Options.ParryKeyBind and Fluent.Options.ParryKeyBind.Value) or "J"
                
                -- Support multi-letter keys like 'Gc' or 'axe' by fallbacking to default if they aren't standard KeyCodes
                local enumKey = Enum.KeyCode[rawKey]
                if not enumKey then
                    local firstLetter = string.upper(string.sub(rawKey, 1, 1))
                    enumKey = Enum.KeyCode[firstLetter]
                end

                if enumKey then
                    VirtualInputManager:SendKeyEvent(true, enumKey, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, enumKey, false, game)
                elseif keypress then
                    -- Executor fallback if VIM fails entirely
                    keypress(string.byte(string.upper(string.sub(rawKey, 1, 1))))
                    task.wait(0.05)
                    keyrelease(string.byte(string.upper(string.sub(rawKey, 1, 1))))
                end
            end
        end)
    end

    if not getgenv().OriginalNamecall then
        getgenv().OriginalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            if getgenv().CSMDH_Unloaded then return getgenv().OriginalNamecall(self, ...) end
            if getgenv().NamecallHandler then return getgenv().NamecallHandler(self, ...) end
            return getgenv().OriginalNamecall(self, ...)
        end)
    end

    -- Namecall Hook removed: Relying entirely on Animation Timings + Rayframe physics checks
    getgenv().NamecallHandler = function(self, ...)
        return getgenv().OriginalNamecall(self, ...)
    end
    
    if not getgenv().CloudTimings then
        pcall(function()
            local url = "https://raw.githubusercontent.com/opim80/test/refs/heads/main/timings"
            local content = game:HttpGet(url)
            if content and content ~= "" then
                getgenv().CloudTimings = game:GetService("HttpService"):JSONDecode(content)
            end
        end)
        
        -- Fallback to workspace file if HTTP get fails
        if not getgenv().CloudTimings then
            if isfile and isfile("CSMDH_CloudTimings.json") then
                local success, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile("CSMDH_CloudTimings.json")) end)
                getgenv().CloudTimings = success and decoded or {}
            else
                getgenv().CloudTimings = {}
                warn("Cloud Timings could not be loaded from Github or Workspace.")
            end
        end
    end
    
    local function setupAnimatorLogging(animator)
        if getgenv().CSMDH_HookedObjects and getgenv().CSMDH_HookedObjects[animator] then return end
        getgenv().CSMDH_HookedObjects = getgenv().CSMDH_HookedObjects or setmetatable({}, {__mode = "k"})
        getgenv().CSMDH_HookedObjects[animator] = true
        
        local character = animator
        while character and not character:IsA("Model") and character ~= workspace do
            character = character.Parent
        end
        if not character or character == workspace then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        getgenv().BlockedAnimations = getgenv().BlockedAnimations or {}
        local animateScript = character:FindFirstChild("aniamte(nolag)")
        if animateScript then
            for _, child in ipairs(animateScript:GetDescendants()) do
                if child:IsA("Animation") and child.AnimationId and child.AnimationId ~= "" then
                    getgenv().BlockedAnimations[child.AnimationId] = true
                end
            end
        end
        
        local function onAnimationPlayed(track)
            if getgenv().CSMDH_Unloaded then return end
            
            local rawId = track.Animation and track.Animation.AnimationId
            if not rawId or rawId == "" then return end
            
            local animId = string.match(rawId, "%d+")
            if not animId then return end
            
            debugPrint("Animation Played: " .. tostring(animId) .. " on " .. character.Name)
            
            local animData = getgenv().CloudTimings[tostring(animId)]
            -- The JSON now stores tables: { hitTime = 0.5, key = "Q" }
            -- If someone is using an older JSON where it's just a number, we wrap it
            if type(animData) == "number" then animData = { hitTime = animData, key = "F" } end
            
            if animData and type(animData) == "table" and Fluent and Fluent.Options then
                local requiredKey = animData.key or "F"
                
                -- Check early to avoid yielding logic if toggle is off
                if requiredKey == "Q" and not Fluent.Options.AutoDodgeToggle.Value then return end
                if requiredKey == "m1" and not Fluent.Options.AutoAttackToggle.Value then return end
                if (requiredKey ~= "Q" and requiredKey ~= "m1") and not Fluent.Options.AutoParryToggle.Value then return end

                local targetTime = animData.hitTime - 0.1
                
                local function executeRayframeParry()
                    if character and character:FindFirstChild("HumanoidRootPart") and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                        local enemyHrp = character.HumanoidRootPart
                        local myHrp = lp.Character.HumanoidRootPart
                        
                        -- Distance check + Raycast check
                        local dist = (myHrp.Position - enemyHrp.Position).Magnitude
                        if dist <= 25 and dist > 0.1 then
                            local rayOrigin = enemyHrp.Position
                            local rayDirection = (myHrp.Position - enemyHrp.Position).Unit * dist
                            
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterDescendantsInstances = {character}
                            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                            
                            local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
                            
                            -- If the ray hits our character, the enemy's hitbox connects physically
                            if raycastResult and raycastResult.Instance and raycastResult.Instance:IsDescendantOf(lp.Character) then
                                fireParryEvent(requiredKey)
                                if Fluent.Options.ShowConsoleToggle and Fluent.Options.ShowConsoleToggle.Value then
                                    warn("Rayframe: Countered incoming attack with " .. tostring(requiredKey))
                                end
                            end
                        end
                    end
                end

                if targetTime > 0 then
                    task.spawn(function()
                        task.wait(targetTime)
                        if getgenv().CSMDH_Unloaded then return end
                        executeRayframeParry()
                    end)
                else
                    executeRayframeParry()
                end
            end
            
            local folder = character:FindFirstChild("StoredAnimations")
            if not folder then
                folder = Instance.new("Folder")
                folder.Name = "StoredAnimations"
                folder.Parent = character
            end
            
            local exists = false
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("StringValue") and child.Value == tostring(animId) then
                    exists = true
                    break
                end
            end
            
            if not exists then
                local val = Instance.new("StringValue")
                val.Name = (track.Name ~= "" and track.Name) or "UnknownAnim"
                val.Value = tostring(animId)
                val.Parent = folder
            end
        end
        
        local conn = animator.AnimationPlayed:Connect(onAnimationPlayed)
        table.insert(getgenv().ActiveConnections, conn)
    end
    
    local function scanForAnimators(parent)
        local function checkObj(obj)
            if obj:IsA("Animator") or obj:IsA("Humanoid") or obj:IsA("AnimationController") then
                setupAnimatorLogging(obj)
            end
        end
        
        for _, obj in ipairs(parent:GetDescendants()) do
            checkObj(obj)
        end
        local conn = parent.DescendantAdded:Connect(function(obj)
            if getgenv().CSMDH_Unloaded then return end
            checkObj(obj)
        end)
        table.insert(getgenv().ActiveConnections, conn)
    end
    scanForAnimators(workspace)
    
    print("Parry & NPC Logger initialized (Anti-stacking active).")
end
initParry()

