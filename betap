-- [[ LOOPS ]]

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if SpeedLabel and root then
        SpeedLabel:SetTitle("SPS: " .. math.floor(root.Velocity.Magnitude))
    end
    
    if viewingHeart and not currentHeartRef then restoreCamera() end

    if HeightLabel and Fluent.Options.GroundFollow.Value and root then
        local res = workspace:Raycast(root.Position, Vector3.new(0, -500, 0), sharedRayParams)
        if res then
            local dist = math.floor((root.Position.Y - res.Position.Y) * 10) / 10
            HeightLabel:SetTitle("Ground Dist: " .. dist)
        end
    end
end)

