Tabs.Debug:AddButton({Title = "Test Parry Keypress (VIM/Executor)", Callback = function()
    pcall(function()
        local rawKey = Fluent.Options.ParryKeyBind and Fluent.Options.ParryKeyBind.Value or "J"
        local keyStr = string.upper(string.sub(rawKey, 1, 1))
        if keyStr == "" then keyStr = "J" end
        
        local vKeyCode = string.byte(keyStr)
        local enumKey = Enum.KeyCode[keyStr]
        
        if keypress then
            keypress(vKeyCode)
            task.wait(0.05)
            keyrelease(vKeyCode)
            Fluent:Notify({Title = "Test", Content = "Pressed " .. keyStr .. " (Executor keypress)", Duration = 2})
        elseif enumKey then
            local VirtualInputManager = game:GetService("VirtualInputManager")
            VirtualInputManager:SendKeyEvent(true, enumKey, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, enumKey, false, game)
            Fluent:Notify({Title = "Test", Content = "Pressed " .. keyStr .. " (VIM)", Duration = 2})
        end
    end)
end})

