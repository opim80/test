-- [[ CORE MOVEMENT ENGINE ]]
local function startDynamicMovement()
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    evasionTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero

        local nextX = hrp.Position.X
        local nextZ = hrp.Position.Z

        local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
        local _, groundPos = workspace:FindPartOnRay(ray, char)
        local baseHeight = groundPos and (groundPos.Y + 20) or hrp.Position.Y
        
        local targetY = baseHeight
        if bounceActive then
            bounceTimer = bounceTimer + deltaTime
            if bounceTimer >= 2 then
                bounceUp = not bounceUp
                bounceTimer = 0
            end
            targetY = baseHeight + (bounceUp and 10 or 0)
        end

        if isQuesting and currentQuestNPC then
            local tPos = currentQuestNPC:GetPivot().Position
            local target3D = Vector3.new(tPos.X, tPos.Y + 5, tPos.Z) 
            local direction = target3D - hrp.Position
            local dist3D = direction.Magnitude
            
            if dist3D > 5 then
                local stepDist = backupTweenSpeed * deltaTime
                if stepDist > dist3D then stepDist = dist3D end
                local moveVector = direction.Unit * stepDist
                nextX = hrp.Position.X + moveVector.X
                targetY = hrp.Position.Y + moveVector.Y 
                nextZ = hrp.Position.Z + moveVector.Z
            else
                targetY = hrp.Position.Y 
            end

        else
            if alwaysTakeCenterActive then
                if tick() - lastCenterUpdate >= centerUpdateInterval then
                    calculatedCenter = getCenterPosition()
                    lastCenterUpdate = tick()
                end
                
                if calculatedCenter then
                    local direction = Vector3.new(calculatedCenter.X - hrp.Position.X, 0, calculatedCenter.Z - hrp.Position.Z)
                    local dist2D = direction.Magnitude
                    if dist2D > 1 then
                        local stepDist = backupTweenSpeed * deltaTime
                        if stepDist > dist2D then stepDist = dist2D end
                        local moveVector = direction.Unit * stepDist
                        nextX = hrp.Position.X + moveVector.X
                        nextZ = hrp.Position.Z + moveVector.Z
                    end
                end
            else
                if currentTarget then
                    local targetPart = getTargetPart(currentTarget)
                    if not targetPart then
                        local tPos = currentTarget:GetPivot().Position
                        local direction = Vector3.new(tPos.X - hrp.Position.X, 0, tPos.Z - hrp.Position.Z)
                        local dist2D = direction.Magnitude
                        
                        if dist2D > 1 then
                            local stepDist = backupTweenSpeed * deltaTime
                            if stepDist > dist2D then stepDist = dist2D end 
                            local moveVector = direction.Unit * stepDist
                            nextX = hrp.Position.X + moveVector.X
                            nextZ = hrp.Position.Z + moveVector.Z
                        end
                    end
                end
            end
        end

        local nextYPos = hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15
        hrp.CFrame = CFrame.new(nextX, nextYPos, nextZ)
    end)
end

-- [[ KILLAURA ATTACK LOOP ]]
local function startKillAura()
    if not killAuraActive then return end
    updateStatus("Initializing KillAura & Movement...")
    lastRecalibrate = tick()
    startDynamicMovement()

    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")

        while killAuraActive do
            if recalibrateActive and tick() - lastRecalibrate >= (recalibrateInterval * 60) then
                isRecalibrating = true
                updateStatus("Recalibrating... Dropping to ground.")
                
                if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
                
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Velocity = Vector3.zero
                    hrp.RotVelocity = Vector3.zero
                end
                
                task.wait(recalibrateDuration)
                
                lastRecalibrate = tick()
                isRecalibrating = false
                
                if killAuraActive then
                    startDynamicMovement()
                    updateStatus("Recalibration complete. Resuming...")
                end
                continue
            end
            
            if untilTitleActive then
                local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                if pGui then
                    local titlesUI = pGui:FindFirstChild("TitlesUI")
                    local lockedFrame = titlesUI and titlesUI:FindFirstChild("MainFrame") and titlesUI.MainFrame:FindFirstChild("Frame") and titlesUI.MainFrame.Frame:FindFirstChild("Content") and titlesUI.MainFrame.Frame.Content:FindFirstChild("Holder") and titlesUI.MainFrame.Frame.Content.Holder:FindFirstChild("Title_TranscendentBeing") and titlesUI.MainFrame.Frame.Content.Holder.Title_TranscendentBeing:FindFirstChild("BuffButtonsHolder") and titlesUI.MainFrame.Frame.Content.Holder.Title_TranscendentBeing.BuffButtonsHolder:FindFirstChild("Locked")
                    
                    if lockedFrame and not lockedFrame.Visible then
                        updateStatus("Title Unlocked! Halting Script.")
                        if MasterAuraToggle then MasterAuraToggle:SetValue(false) end
                        break
                    end
                    
                    local bossUI = pGui:FindFirstChild("BossUI")
                    local bossMain = bossUI and bossUI:FindFirstChild("MainFrame")
                    
                    if bossMain and not bossMain.Visible then
                        updateStatus("Boss dead. Auto-Spawning Boss...")
                        pcall(function()
                            ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("RequestSpawnTrueAizen"):FireServer("Normal")
                        end)
                        
                        task.wait(2) 
                        continue
                    end
                end
            end

            local npcFolder = workspace:FindFirstChild("NPCs")
            if not npcFolder then 
                updateStatus("Waiting for workspace.NPCs folder to load...")
                task.wait(0.5)
                continue 
            end

            equipWeapon(selectedWeapon)
            currentTarget = nil
            
            local bestTarget = nil
            local bossTarget = nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero

            local validMobFound = false

            -- UPDATED PRIORITY TARGETING
            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                
                if hum and hum.Health > 0 then
                    if isMobSelected(npc.Name) then
                        validMobFound = true
                        
                        local isBoss = string.find(string.lower(npc.Name), "boss") ~= nil or string.find(string.lower(npc.Name), "aizen") ~= nil
                        local dist = (charPos - npc:GetPivot().Position).Magnitude
                        
                        if isBoss then
                            -- Boss found, absolute priority
                            if not bossTarget or dist < closestDist then
                                bossTarget = npc
                                closestDist = dist
                            end
                        elseif not bossTarget then
                            -- Only target normal mobs if no boss exists yet
                            if dist < closestDist then
                                bestTarget = npc
                                closestDist = dist
                            end
                        end
                    end
                end
            end

            currentTarget = bossTarget or bestTarget

            if not validMobFound and not isQuesting then
                if not killAllActive and next(selectedMobs) == nil then
                    updateStatus("No mobs selected in dropdown and KillAll is OFF.")
                else
                    updateStatus("No selected mobs are currently alive.")
                end
            end

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")

                while killAuraActive and not isRecalibrating and currentTarget and currentTarget.Parent and hum and hum.Health > 0 do
                    if untilTitleActive then
                        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                        local bossMain = pGui and pGui:FindFirstChild("BossUI") and pGui.BossUI:FindFirstChild("MainFrame")
                        if bossMain and not bossMain.Visible then break end 
                    end
                    
                    local targetPart = getTargetPart(currentTarget)
                    
                    if targetPart then
                        local tPos = targetPart.Position
                        
                        local success, err = pcall(function() 
                            local args = {}
                            if vectorMethod == "vector.create(X, Y, Z)" then
                                args = { vector.create(tPos.X, tPos.Y, tPos.Z) }
                            elseif vectorMethod == "Vector3.new" then
                                args = { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
                            elseif vectorMethod == "Raw Vector3" then
                                args = { tPos }
                            else
                                args = { vector.create(tPos) }
                            end
                            remote:FireServer(unpack(args)) 
                        end)
                        
                        if not success then
                            updateStatus("⚠️ REMOTE ERROR: " .. tostring(err))
                        else
                            local remotePath = remote:GetFullName()
                            updateStatus("Global Strike: " .. currentTarget.Name .. " | HP: " .. tostring(math.floor(hum.Health)) .. "\nMethod: " .. vectorMethod)
                        end
                    elseif not isQuesting then
                        updateStatus("Target unrendered. Tweening to pivot: " .. currentTarget.Name)
                    end
                    
                    task.wait(0.35)
                end
                
                if not isRecalibrating then
                    if currentTarget == nil or not currentTarget.Parent or (hum and hum.Health <= 0) then
                        updateStatus("Target defeated. Searching again...")
                        currentTarget = nil 
                    end
                end
            else
                task.wait(0.5) 
            end
        end
    end)
end

local function stopKillAura()
    killAuraActive = false
    currentTarget = nil
    isRecalibrating = false
    updateStatus("KillAura Stopped. Idle.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
end

