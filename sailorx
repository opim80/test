-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function getBaseName(name)
    return string.gsub(name, "[_%s%d]+$", "")
end

local function isMobSelected(rawName, baseName)
    if killAllActive then return true end
    if type(selectedMobs) == "table" then
        if selectedMobs[baseName] or selectedMobs[rawName] then return true end
        if table.find(selectedMobs, baseName) or table.find(selectedMobs, rawName) then return true end
    end
    return false
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function getWeapons()
    local weapons = {}
    if LocalPlayer.Backpack then
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then 
                table.insert(weapons, tool.Name) 
            end
        end
    end
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then 
                table.insert(weapons, tool.Name) 
            end
        end
    end
    
    if selectedWeapon ~= "" and not table.find(weapons, selectedWeapon) then
        table.insert(weapons, selectedWeapon)
    end
    
    return weapons
end

local function getAvailableMobs()
    local mobs = {}
    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in ipairs(npcFolder:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local baseName = getBaseName(npc.Name)
                if not table.find(mobs, baseName) then table.insert(mobs, baseName) end
            end
        end
    end
    return mobs
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    
    if tool and humanoid and tool.Parent ~= char then 
        humanoid:EquipTool(tool) 
    end
end

local function getCenterPosition()
    local npcFolder = workspace:FindFirstChild("NPCs")
    if not npcFolder then return nil end
    
    local sumPos = Vector3.zero
    local count = 0
    
    for _, npc in ipairs(npcFolder:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then
            local baseName = getBaseName(npc.Name)
            if isMobSelected(npc.Name, baseName) then
                local tPos = npc:GetPivot().Position
                sumPos = sumPos + tPos
                count = count + 1
            end
        end
    end
    
    if count > 0 then return sumPos / count end
    return nil
end

-- [[ QUEST LOGIC ]]
local function getBestQuestNPC()
    local serviceNPCs = workspace:FindFirstChild("ServiceNPCs")
    local dataFolder = LocalPlayer:FindFirstChild("Data")
    local levelVal = dataFolder and dataFolder:FindFirstChild("Level")
    
    if not serviceNPCs or not levelVal then return nil, nil end
    
    local pLevel = tonumber(levelVal.Value) or 0
    local bestNPCId = nil
    local bestNPC = nil
    local highestMinLvl = -1
    
    for i = 1, 17 do
        local npcName = "QuestNPC" .. i
        local npc = serviceNPCs:FindFirstChild(npcName)
        
        if npc then
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            local prompt = hrp and hrp:FindFirstChild("QuestPrompt")
            
            if prompt and prompt.ObjectText then
                local text = prompt.ObjectText
                local minLvl, maxLvl = string.match(text, "(%d+)%s*%-%s*(%d+)")
                
                if not minLvl then
                    minLvl = string.match(text, "(%d+)%+")
                    maxLvl = 9999999
                end
                
                if minLvl then
                    minLvl = tonumber(minLvl)
                    maxLvl = tonumber(maxLvl) or 9999999
                    
                    if pLevel >= minLvl and pLevel <= maxLvl then
                        if minLvl > highestMinLvl then
                            highestMinLvl = minLvl
                            bestNPCId = npcName
                            bestNPC = npc
                        end
                    end
                end
            end
        end
    end
    return bestNPCId, bestNPC
end

local function startAutoQuest()
    if questTask then task.cancel(questTask); questTask = nil end
    
    questTask = task.spawn(function()
        while autoQuestActive do
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local questUI = pGui and pGui:FindFirstChild("QuestUI")
            local questFrame = questUI and questUI:FindFirstChild("Quest")
            
            if questFrame and not questFrame.Visible then
                local npcId, npcInst = getBestQuestNPC()
                
                if npcId and npcInst then
                    isQuesting = true
                    currentQuestNPC = npcInst
                    
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - npcInst:GetPivot().Position).Magnitude
                        
                        if dist < 15 then
                            updateStatus("Accepting Quest from: " .. npcId)
                            pcall(function()
                                ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npcId)
                            end)
                            task.wait(1.5) 
                        else
                            updateStatus("Tweening to " .. npcId .. " for new quest...")
                        end
                    end
                else
                    isQuesting = false
                    currentQuestNPC = nil
                    updateStatus("AutoQuest: No suitable quest found for Level " .. tostring(LocalPlayer.Data.Level.Value))
                end
            else
                isQuesting = false
                currentQuestNPC = nil
            end
            
            task.wait(0.5)
        end
        isQuesting = false
        currentQuestNPC = nil
    end)
end

