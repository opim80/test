-- [[ CORE MOVEMENT ENGINE ]]
local function startDynamicMovement()
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    evasionTask = RunService.Heartbeat:Connect(function(deltaTime)
        if not hrp or not hrp.Parent then return end
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        local nextX, nextY, nextZ = hrp.Position.X, hrp.Position.Y, hrp.Position.Z
        local ray = Ray.new(hrp.Position, Vector3.new(0, -500, 0))
        local _, groundPos = workspace:FindPartOnRay(ray, char)
        local baseHeight = groundPos and (groundPos.Y + 20) or hrp.Position.Y
        local targetY = baseHeight
        if bounceActive then
            bounceTimer = bounceTimer + deltaTime
            if bounceTimer >= 2 then bounceUp = not bounceUp bounceTimer = 0 end
            targetY = baseHeight + (bounceUp and 10 or 0)
        end

        if isQuesting and currentQuestNPC then
            local tPos = currentQuestNPC:GetPivot().Position
            local direction = (Vector3.new(tPos.X, tPos.Y + 5, tPos.Z) - hrp.Position)
            if direction.Magnitude > 5 then
                local step = direction.Unit * backupTweenSpeed * deltaTime
                nextX, nextY, nextZ = hrp.Position.X + step.X, hrp.Position.Y + step.Y, hrp.Position.Z + step.Z
            end
        else
            -- Follow target or center
            local moveTarget = currentTarget and currentTarget:GetPivot().Position
            if alwaysTakeCenterActive then
                if tick() - lastCenterUpdate >= centerUpdateInterval then
                    calculatedCenter = getCenterPosition()
                    lastCenterUpdate = tick()
                end
                moveTarget = calculatedCenter or moveTarget
            end
            
            if not getTargetPart(currentTarget) and moveTarget then
                local direction = (Vector3.new(moveTarget.X, moveTarget.Y + 20, moveTarget.Z) - hrp.Position)
                if direction.Magnitude > 1 then
                    local stepDist = backupTweenSpeed * deltaTime
                    if stepDist > direction.Magnitude then stepDist = direction.Magnitude end
                    local step = direction.Unit * stepDist
                    nextX, nextZ = hrp.Position.X + step.X, hrp.Position.Z + step.Z
                end
            end
        end
        local smoothY = hrp.Position.Y + (targetY - hrp.Position.Y) * 0.15
        hrp.CFrame = CFrame.new(nextX, smoothY, nextZ)
    end)
end

-- [[ KILLAURA ATTACK LOOP ]]
local function startKillAura()
    if not killAuraActive then return end
    startDynamicMovement()
    if auraTask then task.cancel(auraTask) end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
        while killAuraActive do
            -- Recalibration Logic
            if recalibrateActive and tick() - lastRecalibrate >= (recalibrateInterval * 60) then
                isRecalibrating = true
                updateStatus("Recalibrating... Dropping to ground.")
                if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Velocity = Vector3.zero
                    hrp.RotVelocity = Vector3.zero
                end
                task.wait(recalibrateDuration)
                lastRecalibrate = tick()
                isRecalibrating = false
                if killAuraActive then
                    startDynamicMovement()
                    updateStatus("Recalibration complete. Resuming...")
                end
                continue
            end

            -- Title & Boss Spawn Logic
            if untilTitleActive then
                local titlesUI = LocalPlayer.PlayerGui:FindFirstChild("TitlesUI")
                local locked = titlesUI and titlesUI.MainFrame.Frame.Content.Holder.Title_TranscendentBeing.BuffButtonsHolder.Locked
                if locked and not locked.Visible then
                    MasterAuraToggle:SetValue(false) 
                    updateStatus("Title Unlocked! Halting Script.")
                    break
                end
                if not LocalPlayer.PlayerGui.BossUI.MainFrame.Visible then
                    updateStatus("Boss dead. Auto-Spawning...")
                    pcall(function()
                        ReplicatedStorage.RemoteEvents.RequestSpawnTrueAizen:FireServer("Normal")
                    end)
                    task.wait(2) 
                    continue
                end
            end

            local npcFolder = workspace:FindFirstChild("NPCs")
            if not npcFolder then task.wait(0.5) continue end
            equipWeapon(selectedWeapon)

            local bestTarget = nil
            local bossTarget = nil
            local closestDist = math.huge
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero

            for _, npc in ipairs(npcFolder:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 and isMobSelected(npc.Name, getBaseName(npc.Name)) then
                    local dist = (charPos - npc:GetPivot().Position).Magnitude
                    -- ABSOLUTE BOSS PRIORITY
                    if string.find(string.lower(npc.Name), "boss") or string.find(string.lower(npc.Name), "aizen") then
                        if not bossTarget or dist < closestDist then
                            bossTarget = npc
                            closestDist = dist
                        end
                    elseif not bossTarget and dist < closestDist then
                        bestTarget = npc
                        closestDist = dist
                    end
                end
            end

            currentTarget = bossTarget or bestTarget

            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                while killAuraActive and not isRecalibrating and currentTarget and currentTarget.Parent and hum and hum.Health > 0 do
                    if untilTitleActive then
                        local bossMain = LocalPlayer.PlayerGui:FindFirstChild("BossUI") and LocalPlayer.PlayerGui.BossUI:FindFirstChild("MainFrame")
                        if bossMain and not bossMain.Visible then break end 
                    end
                    
                    local tPart = getTargetPart(currentTarget)
                    if tPart then
                        updateStatus("Global Strike: " .. currentTarget.Name .. " | HP: " .. tostring(math.floor(hum.Health)))
                        pcall(function()
                            local args = {}
                            if vectorMethod == "Vector3.new" then
                                args = {Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)}
                            elseif vectorMethod == "Raw Vector3" then
                                args = {tPart.Position}
                            elseif vectorMethod == "vector.create(Vector3) [Broken]" then
                                args = {vector.create(tPart.Position)}
                            else
                                args = {vector.create(tPart.Position.X, tPart.Position.Y, tPart.Position.Z)}
                            end
                            remote:FireServer(unpack(args))
                        end)
                    elseif not isQuesting then
                        updateStatus("Target unrendered. Tweening to pivot: " .. currentTarget.Name)
                    end
                    task.wait(0.35)
                end
                
                if not isRecalibrating then
                    if currentTarget == nil or not currentTarget.Parent or (hum and hum.Health <= 0) then
                        updateStatus("Target defeated. Searching again...")
                        currentTarget = nil 
                    end
                end
            else
                if not isQuesting then
                    updateStatus("No valid targets found. Scanning...")
                end
                task.wait(0.5)
            end
        end
    end)
end

local function stopKillAura()
    killAuraActive = false
    currentTarget = nil
    isRecalibrating = false
    updateStatus("KillAura Stopped. Idle.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
    if evasionTask then evasionTask:Disconnect(); evasionTask = nil end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
end

