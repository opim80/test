-- [[ RAIDS LOGIC ]]
local function startAutoDungeon()
    if dungeonLoopTask then task.cancel(dungeonLoopTask); dungeonLoopTask = nil end

    dungeonLoopTask = task.spawn(function()
        while autoDungeonActive do
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local dungeonUI = playerGui and playerGui:FindFirstChild("DungeonUI")
            
            if dungeonUI then
                local replayFrame = dungeonUI:FindFirstChild("ReplayDungeonFrameVisibleOnlyWhenClearingDungeon")
                local contentFrame = dungeonUI:FindFirstChild("ContentFrame")
                
                if replayFrame and replayFrame.Visible then
                    local args = {"sponsor"}
                    pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DungeonWaveReplayVote"):FireServer(unpack(args)) end)
                elseif contentFrame and contentFrame.Visible then
                    pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DungeonWaveVote"):FireServer(selectedDifficulty) end)
                    if not killAuraActive then
                        killAllActive = true 
                        killAuraActive = true
                        startKillAura()
                    end
                elseif autoRequestActive then
                    pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RequestDungeonPortal"):FireServer(selectedDungeon) end)
                end
            end
            task.wait(2)
        end
    end)
end

