local espOn = false
local function getDraw(i)
    if draws[i] then return draws[i] end
    local ok, d = pcall(function() return Drawing.new("Text") end)
    if not ok or not d then return nil end
    d.Size, d.Center, d.Outline, d.Visible = 13, true, true, false
    draws[i] = d
    return d
end

local function updateESP()
    local cam, r = WS.CurrentCamera, root()
    if not cam or not r then
        for _, d in ipairs(draws) do d.Visible = false end
        return
    end
    local idx = 0
    local function drawAt(pos, text, color)
        local sp, on = cam:WorldToViewportPoint(pos)
        if not on then return end
        idx = idx + 1
        local d = getDraw(idx)
        if d then d.Text, d.Position, d.Color, d.Visible = text, Vector2.new(sp.X, sp.Y), color, true end
    end

    if S.espChest and WS:FindFirstChild("Chests") then
        for _, c in ipairs(WS.Chests:GetChildren()) do
            local p = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
            if p and (p.Position - r.Position).Magnitude <= S.espRange then
                drawAt(p.Position, ("CHEST [%d]"):format((p.Position - r.Position).Magnitude), Color3.fromRGB(255, 200, 80))
            end
        end
    end
    if S.espHerb and WS:FindFirstChild("SpawnedHerbs") then
        for _, h in ipairs(WS.SpawnedHerbs:GetChildren()) do
            local p = h:IsA("BasePart") and h or h:FindFirstChildWhichIsA("BasePart", true)
            if p and (p.Position - r.Position).Magnitude <= S.espRange then
                drawAt(p.Position, ("HERB [%d]"):format((p.Position - r.Position).Magnitude), Color3.fromRGB(120, 255, 140))
            end
        end
    end
    if S.espPlayers then
        for _, o in ipairs(Players:GetPlayers()) do
            if o ~= LP and o.Character and o.Character:FindFirstChild("Head") then
                local hd = o.Character.Head
                local d = (hd.Position - r.Position).Magnitude
                if d <= S.espRange then
                    drawAt(hd.Position + Vector3.new(0, 2, 0), ("%s [%d]"):format(o.Name, d), Color3.fromRGB(140, 190, 255))
                end
            end
        end
    end
    for i = idx + 1, #draws do draws[i].Visible = false end
end

local function ensureESP()
    local want = S.espChest or S.espHerb or S.espHorse or S.espPlayers
    if want and not espOn then
        espOn = true
        task.spawn(function()
            while S.running and (S.espChest or S.espHerb or S.espHorse or S.espPlayers) do
                pcall(updateESP)
                RunService.RenderStepped:Wait()
            end
            espOn = false
            for _, d in ipairs(draws) do d.Visible = false end
        end)
    end
end

