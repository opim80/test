    if not req then return end

    local inv = getInventorySummary()
    local dogbaneCount = getDogbaneCount()

    local list = {}
    for name, cnt in pairs(inv) do
        if not name:lower():find("dogbane") then
            list[#list + 1] = { name = name, count = cnt }
        end
    end
    table.sort(list, function(a, b) return a.name < b.name end)

