-- ── AUTOMATED TELEPORT & STAND ROUTINE (NO AUTO-DROP) ───────────────────────
local function runDeliveryRoutine(isManual)
    if isDelivering then return end
    isDelivering = true

    local targetUsername = (S.deliveryUsername or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local targetServer = (S.deliveryServerName or ""):gsub("^%s+", ""):gsub("%s+$", "")

    -- If no recipient configured, hold farm and display clear action on HUD
    if targetUsername == "" then
        FARM.status = "⚠️ Enter Recipient Username in Delivery Tab (Have 20+ Dogbanes)"
        while S.running and S.deliveryEnabled and ((S.deliveryUsername or ""):gsub("%s+", "") == "") do
            FARM.status = "⚠️ Enter Recipient Username in Delivery Tab (Have 20+ Dogbanes)"
            task.wait(1)
        end
        if not S.running or not S.deliveryEnabled then
            isDelivering = false
            return
        end
        targetUsername = (S.deliveryUsername or ""):gsub("^%s+", ""):gsub("%s+$", "")
    end

    FARM.status = ("20 Dogbanes reached! Preparing travel to '%s'..."):format(targetUsername)
    task.wait(0.5)

    local recipient = findTargetPlayer(targetUsername)

    -- If recipient is not in this server and explicit server routing is configured, hop
    if not recipient and targetServer ~= "" then
        FARM.status = ("Hopping to target server: '%s'..."):format(targetServer)
        S.deliveryPending = true
        saveConfig()
        task.wait(0.6)
        serverHop(true)
        task.wait(10)
        isDelivering = false
        return
    end

    -- If no server configured, wait up to 60 seconds for recipient to appear
    if not recipient then
        FARM.status = ("Waiting for '%s' to appear in server..."):format(targetUsername)
        local waitT0 = os.clock()
        while S.running and isDelivering and os.clock() - waitT0 < 60 do
            recipient = findTargetPlayer(targetUsername)
            if recipient then break end
            task.wait(1.5)
        end

        if not recipient then
            FARM.status = ("'%s' not found. Resuming farming..."):format(targetUsername)
            task.wait(2)
            isDelivering = false
            if S.autoChests and not FARM.isChestFarmRunning then startChestFarm() end
            return
        end
    end

    FARM.status = ("Recipient '%s' located. Waiting for character..."):format(recipient.Name)
    local t0 = os.clock()
    while S.running and isDelivering and os.clock() - t0 < 25 do
        if recipient.Character and recipient.Character:FindFirstChild("HumanoidRootPart") then
            break
        end
        task.wait(0.5)
    end

    local tChar = recipient.Character
    local targetRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        FARM.status = "Recipient character missing. Resuming farm..."
        task.wait(2)
        isDelivering = false
        if S.autoChests and not FARM.isChestFarmRunning then startChestFarm() end
        return
    end

    local targetPos = targetRoot.Position

    -- Step 1: Pre-render map around recipient (only enough studs)
    FARM.status = ("Pre-rendering map around '%s'..."):format(recipient.Name)
    pcall(function() LP:RequestStreamAroundAsync(targetPos, 15) end)
    task.wait(0.8)

    -- Step 2: Safe approach via horse if far away
    local myR = root()
    if myR and (myR.Position - targetPos).Magnitude > 35 then
        FARM.status = "Riding near recipient..."
        local horsePark = findCleanGround(targetPos, 4.5, 6.5, tChar)
        fastHorseTeleport(horsePark)
        task.wait(0.2)
    end

    -- Step 3: Clean dismount before final positioning
    instantDismount()
    task.wait(0.25)

    -- Step 4: Position character at the exact analyzed relative offset
    local dropPos = targetRoot.CFrame:PointToWorldSpace(RELATIVE_STAND_OFFSET)
    local curR = root()
    if curR then
        curR.CFrame = CFrame.lookAt(dropPos, Vector3.new(targetRoot.Position.X, dropPos.Y, targetRoot.Position.Z))
        curR.AssemblyLinearVelocity = Vector3.zero
        curR.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.3)

    -- Step 5: Stand & Wait for manual drop (Auto-drop removed)
    FARM.status = ("In position at %s! Ready for manual drop (🌿 %d Dogbanes)"):format(recipient.Name, getDogbaneCount())

    -- Keep aligned until you drop items below 20 Dogbanes or manually click 'Resume'
    while S.running and isDelivering and getDogbaneCount() >= 20 do
        local liveTargetRoot = recipient.Character and recipient.Character:FindFirstChild("HumanoidRootPart")
        local myRoot = root()
        if liveTargetRoot and myRoot then
            local desiredPos = liveTargetRoot.CFrame:PointToWorldSpace(RELATIVE_STAND_OFFSET)
            if (myRoot.Position - desiredPos).Magnitude > 2.5 then
                myRoot.CFrame = CFrame.lookAt(desiredPos, Vector3.new(liveTargetRoot.Position.X, desiredPos.Y, liveTargetRoot.Position.Z))
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end
        end
        FARM.status = ("In position! Ready for manual drop (🌿 %d remaining)..."):format(getDogbaneCount())
        task.wait(1)
    end

    if isDelivering then
        FARM.status = "Dogbanes dropped (<20 remaining)! Resuming normal farm..."
        task.wait(2)
        S.deliveryPending = false
        saveConfig()
        isDelivering = false

        -- Seamlessly resume chest farming
        if S.autoChests and not FARM.isChestFarmRunning then
            startChestFarm()
        end
    end
end

