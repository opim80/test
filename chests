local function getInventorySummary()
    local counts = {}
    local sources = { LP:FindFirstChild("Backpack"), char() }

    for _, src in ipairs(sources) do
        if src then
            for _, obj in ipairs(src:GetChildren()) do
                if obj:IsA("Tool") then
                    local name = obj.Name
                    local amount = 1

                    local base, parenAmt = name:match("^(.-)%s*%(%s*(%d+)%s*%)$")
                    if base and parenAmt then
                        name = base
                        amount = tonumber(parenAmt) or 1
                    else
                        local attr = obj:GetAttribute("Amount") or obj:GetAttribute("Quantity") or obj:GetAttribute("Count")
                        if typeof(attr) == "number" then
                            amount = attr
                        else
                            local val = obj:FindFirstChild("Amount") or obj:FindFirstChild("Quantity")
                            if val and val:IsA("ValueBase") and typeof(val.Value) == "number" then
                                amount = val.Value
                            end
                        end
                    end
                    counts[name] = (counts[name] or 0) + amount
                end
            end
        end
    end
    return counts
end

