-- ── CONFIRMATION-CHECKED HARVEST ENGINE ─────────────────────────────────────
local SPAWNED_AT, DONE_UNTIL = {}, {}
for _, fn in ipairs({ "Chests", "SpawnedHerbs" }) do
    local f = WS:FindFirstChild(fn)
    if f then
        for _, it in ipairs(f:GetChildren()) do SPAWNED_AT[it] = 0 end
        conns[#conns + 1] = f.ChildAdded:Connect(function(it) SPAWNED_AT[it] = os.clock() end)
        conns[#conns + 1] = f.ChildRemoved:Connect(function(it) SPAWNED_AT[it], DONE_UNTIL[it] = nil, nil end)
    end
end

local function isChestConsumed(item, prompt)
    if not item or not item.Parent or not item:IsDescendantOf(WS) then return true end
    if not prompt or not prompt.Parent or not prompt.Enabled then return true end
    if item:GetAttribute("Opened") == true or item:GetAttribute("Looted") == true or item:GetAttribute("Open") == true then
        return true
    end
    return false
end

local function nearestPrompted(folderName)
    local r, f = root(), WS:FindFirstChild(folderName)
    if not r or not f then return nil end
    local bestPart, bestDist, bestPrompt, bestItem
    local now = os.clock()

    for _, item in ipairs(f:GetChildren()) do
        if not (DONE_UNTIL[item] and now < DONE_UNTIL[item]) then
            local prompt
            for _, d in ipairs(item:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled then prompt = d break end
            end
            if prompt then
                local promptAnchor = (prompt.Parent and prompt.Parent:IsA("BasePart") and prompt.Parent)
                local part = promptAnchor or (item:IsA("BasePart") and item) or item:FindFirstChildWhichIsA("BasePart", true)

                if part and not (folderName == "Chests" and isPlayerNear(part.Position, S.playerAvoidRadius)) then
                    local dist = (part.Position - r.Position).Magnitude
                    if not bestDist or dist < bestDist then
                        bestPart, bestDist, bestPrompt, bestItem = part, dist, prompt, item
                    end
                end
            end
        end
    end
    return bestPart, bestDist, bestPrompt, bestItem
end

local function collectPromptVerified(item, part, prompt)
    if isDelivering or isChestConsumed(item, prompt) or isPlayerNear(part.Position, S.playerAvoidRadius) then
        return false
    end

    local promptPart = (prompt.Parent and prompt.Parent:IsA("BasePart") and prompt.Parent) or part
    local targetPos = promptPart.Position

    local standPos = findCleanGround(targetPos, 2.5, 3.5, item)
    local horseParkPos = findCleanGround(standPos, 3.5, 4.8, item)

    local r = root()
    if r and (r.Position - horseParkPos).Magnitude > S.promptRange then
        if not fastHorseTeleport(horseParkPos) then return false end
    end

    instantDismount()

    local arrR = root()
    if not arrR or isPlayerNear(arrR.Position, S.playerAvoidRadius) then
        DONE_UNTIL[item] = os.clock() + 8
        mountHorse()
        return false
    end

    if isChestConsumed(item, prompt) then
        DONE_UNTIL[item] = os.clock() + 45
        mountHorse()
        return true
    end

    arrR.CFrame = CFrame.lookAt(standPos, Vector3.new(targetPos.X, standPos.Y, targetPos.Z))
    arrR.AssemblyLinearVelocity = Vector3.zero
    arrR.AssemblyAngularVelocity = Vector3.zero

    local confirmed = false
    local maxRetries = 7

    for attempt = 1, maxRetries do
        if isDelivering or isChestConsumed(item, prompt) then
            confirmed = true
            break
        end

        if isPlayerNear(arrR.Position, S.playerAvoidRadius) then
            DONE_UNTIL[item] = os.clock() + 8
            break
        end

        if (arrR.Position - targetPos).Magnitude > 4.5 then
            arrR.CFrame = CFrame.lookAt(standPos, Vector3.new(targetPos.X, standPos.Y, targetPos.Z))
            arrR.AssemblyLinearVelocity = Vector3.zero
        end

        if fpp and prompt and prompt.Parent and prompt.Enabled then
            pcall(fpp, prompt, prompt.HoldDuration or 0)
            if (prompt.HoldDuration or 0) > 0 then
                task.wait(0.04)
                pcall(fpp, prompt, 0)
            end
        end

        local t0 = os.clock()
        while os.clock() - t0 < 0.36 do
            if isChestConsumed(item, prompt) then
                confirmed = true
                break
            end
            RunService.Heartbeat:Wait()
        end

        if confirmed then break end
    end

    if confirmed then
        DONE_UNTIL[item] = os.clock() + 50
        FARM.opened = FARM.opened + 1
        FARM.runChests = FARM.runChests + 1
        S.totalChestsLooted = (S.totalChestsLooted or 0) + 1
        saveConfig()
        FARM.status = ("looted chest (%d total)"):format(FARM.opened)
        pcall(checkAndDispatchWebhook)

        -- Check 20 Dogbane threshold immediately
        if playerSpawnedIn and S.deliveryEnabled and getDogbaneCount() >= 20 then
            task.spawn(runDeliveryRoutine, false)
        end
    else
        DONE_UNTIL[item] = os.clock() + 3.5
        FARM.status = "confirmation pending - retrying soon"
    end

    mountHorse()
    return confirmed
end

startChestFarm = function()
    if FARM.isChestFarmRunning then return end
    FARM.isChestFarmRunning = true

    task.spawn(function()
        FARM.runChests = 0
        if S.chestPreRender and not mapPreRendered then run4CornerRender() end
        local emptyChecks = 0

        while S.running and S.autoChests do
            if isDelivering then
                task.wait(1)
            else
                local part, dist, prompt, item = nearestPrompted("Chests")
                if not part then
                    emptyChecks = emptyChecks + 1
                    if S.serverHopOnEmpty and emptyChecks >= 3 and not isDelivering then
                        FARM.status = "depleted! hopping server..."
                        task.wait(0.4)
                        serverHop(false)
                        task.wait(3)
                        emptyChecks = 0
                    else
                        FARM.status = ("waiting for chests (%d/3)"):format(emptyChecks)
                        task.wait(1.2)
                    end
                else
                    emptyChecks = 0
                    FARM.status = ("harvesting (%d studs)"):format(math.floor(dist))
                    collectPromptVerified(item, part, prompt)
                end
            end
            RunService.Heartbeat:Wait()
        end
        FARM.isChestFarmRunning = false
        if not isDelivering then
            FARM.status = "idle"
        end
    end)
end

