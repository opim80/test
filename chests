    HORSE.status = "5 failed mounts — re-summoning horse..."
    local hm = hum()
    if hm then
        pcall(function()
            hm.Sit = false
            hm:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end

    if myHorse() then
        triggerHorseCall()
        local t0 = os.clock()
        while myHorse() and os.clock() - t0 < 3 do task.wait(0.2) end
        task.wait(1.5)
    end

    lastWhistleTime = os.clock()
    triggerHorseCall()
    local t0, fresh = os.clock(), nil
    while os.clock() - t0 < 8 do
        fresh = myHorse()
        if fresh then break end
        task.wait(0.25)
    end
    task.wait(0.6)
    return fresh
end

-- ── LEVEL-GROUND RAYCASTING ENGINE (SECTION 10 COMPLIANT) ───────────────────
local function findCleanGround(origin, minRadius, maxRadius, ignoreInst)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    rp.FilterDescendantsInstances = { char(), myHorse(), ignoreInst }

    local bestPos = nil
    local bestDiff = math.huge

    for radius = (minRadius or 2), (maxRadius or 4), 0.8 do
        for angle = 0, 315, 45 do
            local rad = math.rad(angle)
            local testPos = origin + Vector3.new(math.cos(rad) * radius, 0, math.sin(rad) * radius)
            local hit = WS:Raycast(testPos + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), rp)

            if hit and hit.Material ~= Enum.Material.Water and hit.Normal.Y > 0.85 then
                local diff = math.abs(hit.Position.Y - origin.Y)
                if diff < bestDiff and diff < 6 then
                    bestDiff = diff
                    bestPos = Vector3.new(hit.Position.X, hit.Position.Y + 3.2, hit.Position.Z)
                    break
                end
            end
        end
        if bestPos then break end
    end

    return bestPos or (origin + Vector3.new(2.2, 3.2, 0))
end

local function instantDismount()
    tap("HorseDismountInput")
    tap("ActionInput2")
    local h = hum()
    if h then
        if h.SeatPart then
            local weld = h.SeatPart:FindFirstChildOfClass("Weld") or h.SeatPart:FindFirstChildOfClass("SeatWeld")
            if weld then pcall(game.Destroy, weld) end
        end
        h.Sit = false
        h:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    local r = root()
    if r then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.15)
end

local function mountHorse()
    if isMounted() then
        mountFailCount = 0
        return true
    end

    local h = myHorse() or summonHorse(6)
    if not h then
        mountFailCount = mountFailCount + 1
        if mountFailCount >= 5 then
            mountFailCount = 0
            h = reSummonHorseFresh()
        end
        if not h then return false end
    end

    local hp = h:FindFirstChild("HumanoidRootPart")
    if not hp then return false end

    local r = root()
    if not r then return false end

    local prompt = h:FindFirstChildWhichIsA("ProximityPrompt", true)
    local targetPart = (prompt and prompt.Parent and prompt.Parent:IsA("BasePart") and prompt.Parent) or hp
    local promptPos = targetPart.Position

    local approach = findCleanGround(promptPos, 2.5, 3.5, h)
    for _ = 1, 8 do
        r = root()
        if not r or not targetPart.Parent then break end
        local d = (promptPos - r.Position).Magnitude
        if d < 4.5 then break end
        r.CFrame = CFrame.lookAt(approach, Vector3.new(promptPos.X, approach.Y, promptPos.Z))
        r.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.08)
    end

    if not prompt or not prompt.Parent or not prompt.Enabled then
        prompt = h:FindFirstChildWhichIsA("ProximityPrompt", true)
    end

    if prompt and fpp then
        pcall(fpp, prompt, prompt.HoldDuration or 0)
    end

    local t0 = os.clock()
    while os.clock() - t0 < 0.9 do
        if isMounted() then
            mountFailCount = 0
            return true
        end
        task.wait(0.04)
    end

    if not isMounted() and prompt and fpp then
        r = root()
        if r and targetPart.Parent then
            r.CFrame = CFrame.lookAt(promptPos + (r.Position - promptPos).Unit * 2.2, promptPos)
            r.AssemblyLinearVelocity = Vector3.zero
            pcall(fpp, prompt, 0)
            task.wait(0.25)
        end
    end

    if isMounted() then
        mountFailCount = 0
        return true
    else
        mountFailCount = mountFailCount + 1
        HORSE.status = ("mount failed (%d/5 tries)"):format(mountFailCount)

        if mountFailCount >= 5 then
            mountFailCount = 0
            local fresh = reSummonHorseFresh()
            if fresh then return mountHorse() end
        end
        return false
    end
end

local function fastHorseTeleport(destGroundPos)
    local r = root()
    if not r then return false end
    if (r.Position - destGroundPos).Magnitude < 10 then return true end

    if not isMounted() and not mountHorse() then return false end
    local hp = horseRoot()
    if not hp then return false end

    local t0 = os.clock()
    while os.clock() - t0 < 0.45 do
        local rr = root()
        if rr then
            rr.CFrame = CFrame.new(destGroundPos + Vector3.new(0, 1.5, 0))
            rr.AssemblyLinearVelocity = Vector3.zero
            rr.AssemblyAngularVelocity = Vector3.zero
        end
        if hp and hp.Parent then
            hp.CFrame = CFrame.new(destGroundPos)
            hp.AssemblyLinearVelocity = Vector3.zero
            hp.AssemblyAngularVelocity = Vector3.zero
        end
        RunService.Heartbeat:Wait()

        if rr and (rr.Position - destGroundPos).Magnitude < 9 then
            break
        end
    end

    local finalR = root()
    return finalR and (finalR.Position - destGroundPos).Magnitude < 15
end

