local function addInput(tab, name, key, placeholder)
    local row = Instance.new("Frame", tab.page)
    row.Size, row.BackgroundColor3 = UDim2.new(1, 0, 0, 54), TH.pnl
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
    local rStr = Instance.new("UIStroke", row)
    rStr.Color = Color3.fromRGB(48, 50, 58)

    local lbl = Instance.new("TextLabel", row)
    lbl.Position, lbl.Size, lbl.BackgroundTransparency = UDim2.fromOffset(10, 4), UDim2.new(1, -20, 0, 16), 1
    lbl.Font, lbl.Text, lbl.TextColor3, lbl.TextSize = Enum.Font.GothamBold, name, TH.acc, 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local tb = Instance.new("TextBox", row)
    tb.Position, tb.Size = UDim2.fromOffset(10, 24), UDim2.new(1, -20, 0, 22)
    tb.BackgroundColor3 = Color3.fromRGB(18, 19, 24)
    tb.Font, tb.Text, tb.TextColor3, tb.TextSize = Enum.Font.Gotham, S[key] or "", TH.txt, 11
    tb.PlaceholderText, tb.PlaceholderColor3 = placeholder or "", TH.dim
    tb.ClearTextOnFocus = false
    Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 4)

    registeredInputs[key] = registeredInputs[key] or {}
    table.insert(registeredInputs[key], tb)

    local function sync(val)
        S[key] = val
        saveConfig()
        for _, box in ipairs(registeredInputs[key] or {}) do
            if box ~= tb and box.Text ~= val then box.Text = val end
        end
    end

    tb.FocusLost:Connect(function() sync(tb.Text) end)
    tb:GetPropertyChangedSignal("Text"):Connect(function() sync(tb.Text) end)
end

