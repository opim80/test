    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    local pad = Instance.new("UIPadding", page)
    pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 12), UDim.new(0, 12), UDim.new(0, 6), UDim.new(0, 10)
    local lay = Instance.new("UIListLayout", page)
    lay.Padding = UDim.new(0, 6)

    -- Dynamic Canvas Height Calculation: guarantees smooth scrolling on all executors
    lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, lay.AbsoluteContentSize.Y + 28)
    end)

    local t = { btn = btn, page = page }
    btn.MouseButton1Click:Connect(function()
        for _, o in ipairs(tabs) do
            o.page.Visible = false
            o.btn.TextColor3, o.btn.BackgroundColor3 = TH.dim, TH.pnl
        end
        page.Visible = true
        btn.TextColor3, btn.BackgroundColor3 = TH.bg, TH.acc
    end)
    tabs[#tabs + 1] = t
    if #tabs == 1 then
        page.Visible, btn.TextColor3, btn.BackgroundColor3 = true, TH.bg, TH.acc
    end
    return t
end

