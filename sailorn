-- [[ UTILITY: EXACT PATHING & PARSING ]]
local function getExactPathString(playerName)
    return game:GetService("Players")[playerName]
end

local function parseShortenedNumber(str)
    if not str then return 0 end
    str = string.lower(str)
    local num = tonumber(string.match(str, "[%d%.]+")) or 0
    if string.find(str, "k") then num = num * 1000
    elseif string.find(str, "m") then num = num * 1000000
    elseif string.find(str, "b") then num = num * 1000000000 end
    return num
end

-- [[ MOVEMENT & TRAVERSAL SYSTEM ]]
local function tweenToPosition(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local dist = (hrp.Position - targetPos).Magnitude
    local tweenInfo = TweenInfo.new(dist / backupTweenSpeed, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
end

local function smartTraverseTo(targetPos, targetIsland)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local currentPortalPos = CachedPortals["Current"] or CachedPortals["Starter"]
    
    if currentPortalPos and (targetPos - currentPortalPos).Magnitude > 300 then
        updateStatus("Distance > 300 studs. Utilizing Portal Network...")
        tweenToPosition(currentPortalPos)
        task.wait(0.5)
        
        local args = { targetIsland or "Starter" }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        
        updateStatus("Waiting for portal stun to clear...")
        task.wait(3) 
    end
    
    updateStatus("Tweening to final destination...")
    tweenToPosition(targetPos)
end

-- [[ INITIALIZATION & CACHING (THE WEIRD TASK) ]]
local function initializeWorldCache()
    updateStatus("STARTING INITIALIZATION: Bypassing StreamingEnabled")
    
    -- Force Reset for fresh state
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.Health = 0
    end
    LocalPlayer.CharacterAdded:Wait()
    task.wait(2) -- Wait for UI to load
    
    char = LocalPlayer.Character
    local hrp = char:WaitForChild("HumanoidRootPart")

    -- Find nearest initial portal
    local firstPortal = nil
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:sub(1, 7) == "portal_" and obj:IsA("BasePart") then
            firstPortal = obj
            break
        end
    end

    if firstPortal then
        tweenToPosition(firstPortal.Position)
        CachedPortals["Current"] = firstPortal.Position
    end

    for _, island in ipairs(Islands) do
        updateStatus("Caching Island: " .. island)
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(island)
        task.wait(3) 

        -- Cache Portals dynamically (avoiding hardcoded "portal_")
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name:sub(1, 7) == "portal_" and obj:IsA("BasePart") then
                CachedPortals[island] = obj.Position
                CachedPortals["Current"] = obj.Position
            end
        end

        -- Cache QuestNPCs & Accept Quests for UI Data
        local serviceNPCs = workspace:FindFirstChild("ServiceNPCs")
        if serviceNPCs then
            for _, npc in ipairs(serviceNPCs:GetChildren()) do
                if string.find(npc.Name, "QuestNPC") then
                    CachedNPCs[npc.Name] = { Position = npc:GetPivot().Position, Island = island }
                    
                    tweenToPosition(npc:GetPivot().Position)
                    task.wait(0.5)
                    
                    -- Accept Quest to trigger UI
                    pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npc.Name) end)
                    task.wait(1)
                    
                    -- EXACT PATHS REQUESTED BY USER
                    local playerName = LocalPlayer.Name
                    local expUI = game:GetService("Players")[playerName].PlayerGui.QuestUI.Quest.Reward.RewardExp.CurrencyIndicator
                    local reqUI = game:GetService("Players")[playerName].PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement
                    
                    if expUI and reqUI then
                        CachedQuests[npc.Name] = {
                            ExpReward = parseShortenedNumber(expUI.Text),
                            RequirementText = reqUI.Text
                        }
                    end
                    
                    -- Abandon Quest to clear state
                    pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer("repeatable") end)
                    task.wait(0.5)
                end
            end
        end
    end
    updateStatus("Initialization & Caching Complete!")
end

-- [[ KAITUN LOGIC ]]
local function calculateEfficiencyAndGetBestQuest()
    local bestQuest = nil
    local highestExpPerSec = 0
    local playerName = LocalPlayer.Name
    
    for npcName, data in pairs(CachedQuests) do
        -- Extract target mob from req UI (e.g. "0/5 Quincy1")
        local reqText = data.RequirementText
        local targetMob = string.match(reqText, "%d+/%d+%s+(.+)") 
        local mobsNeeded = tonumber(string.match(reqText, "%d+/(%d+)")) or 1
        
        if targetMob then
            -- Note: In a full version, we'd TP to the mob and M1 it here to read DamageLabel.
            -- Using CurrentDamagePerM1 which updates dynamically in the main combat loop.
            local estimatedMobHP = 5000 -- Fallback, dynamically updated in real combat
            local timeToKill = estimatedMobHP / (CurrentDamagePerM1 / 0.4)
            local totalTime = timeToKill * mobsNeeded
            local expPerSec = data.ExpReward / totalTime
            
            if expPerSec > highestExpPerSec then
                highestExpPerSec = expPerSec
                bestQuest = { NPC = npcName, TargetMob = targetMob, Island = CachedNPCs[npcName].Island, Pos = CachedNPCs[npcName].Position }
            end
        end
    end
    
    return bestQuest
end

local function startKaitun()
    if mainLoopTask then task.cancel(mainLoopTask) end
    
    mainLoopTask = task.spawn(function()
        initializeWorldCache()
        
        while kaitunActive do
            -- 1. If Boss Override is active, ignore quests
            if killAllBossesActive then
                updateStatus("Boss Override Active. Hunting timed bosses...")
                for _, obj in ipairs(workspace.NPCs:GetChildren()) do
                    if string.find(string.lower(obj.Name), "boss_") then
                        local hum = obj:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            tweenToPosition(obj:GetPivot().Position)
                            -- Kill Aura Logic Here
                            task.wait(0.5)
                        end
                    end
                end
                task.wait(1)
                continue
            end

            -- 2. Find optimal Kaitun Quest
            local bestQuest = calculateEfficiencyAndGetBestQuest()
            if bestQuest then
                updateStatus("Optimal Quest Found: " .. bestQuest.NPC .. " | Target: " .. bestQuest.TargetMob)
                
                -- Smart Traverse to NPC
                smartTraverseTo(bestQuest.Pos, bestQuest.Island)
                pcall(function() ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(bestQuest.NPC) end)
                task.wait(1)
                
                -- 3. Combat Loop for Quest Mobs
                local questActive = true
                while questActive and kaitunActive and not killAllBossesActive do
                    local reqUI = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement
                    if reqUI and string.match(reqUI.Text, "(%d+)/(%d+)") then
                        local current, max = string.match(reqUI.Text, "(%d+)/(%d+)")
                        if tonumber(current) >= tonumber(max) then
                            questActive = false
                            break
                        end
                    end
                    
                    -- Dynamic Damage Check Updates
                    local dmgLabel = game:GetService("Players")[LocalPlayer.Name].PlayerGui.DamageCounterUI.DamageFrame.Holder.StatFrame.DamageLabel
                    if dmgLabel and dmgLabel.Text ~= "" then
                        CurrentDamagePerM1 = parseShortenedNumber(dmgLabel.Text)
                    end

                    -- Find Target Mob and Attack
                    local targetFound = false
                    for _, mob in ipairs(workspace.NPCs:GetChildren()) do
                        if string.find(string.lower(mob.Name), string.lower(bestQuest.TargetMob)) then
                            local hum = mob:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 then
                                targetFound = true
                                tweenToPosition(mob:GetPivot().Position + Vector3.new(0, 5, 0))
                                
                                -- Attack Remote
                                local tPos = mob:GetPivot().Position
                                pcall(function()
                                    local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")
                                    local args = vectorMethod == "vector.create(X, Y, Z)" and { vector.create(tPos.X, tPos.Y, tPos.Z) } or { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
                                    remote:FireServer(unpack(args))
                                end)
                            end
                        end
                    end
                    
                    if not targetFound then task.wait(1) end
                    task.wait(0.4) -- M1 timing constraint
                end
            else
                updateStatus("No suitable quests found. Retrying...")
                task.wait(2)
            end
        end
    end)
end

