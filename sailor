-- [[ STATE VARIABLES ]]
local killAuraActive = false
local killAllActive = false
local selectedMobs = {} 
local selectedWeapon = ""
local auraTask = nil
local evasionTask = nil
local currentTarget = nil 
local cameraTrackActive = false
local cameraTask = nil

local autoStatActive = false
local statTarget = "Melee"
local statAmount = 1

local autoDungeonActive = false
local autoRequestActive = false
