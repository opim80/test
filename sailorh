-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function updateCacheUI(msg)
    if CacheDisplay then
        local pCount = 0
        local qCount = 0
        for _ in pairs(GlobalCache.Portals) do pCount = pCount + 1 end
        for _ in pairs(GlobalCache.Quests) do qCount = qCount + 1 end
        
        CacheDisplay:SetDesc(
            "📍 Portals Mapped: " .. pCount .. " / " .. #IslandsList .. "\n" ..
            "📜 Quests Mapped: " .. qCount .. "\n\n" ..
            "🔄 Current Action: " .. msg
        )
    end
end

local function TweenTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local dist = (hrp.Position - targetPos).Magnitude
    local tweenTime = dist / backupTweenSpeed
    
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    tween:Play()
    tween.Completed:Wait()
end

local function getTargetPart(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc.PrimaryPart
end

local function equipWeapon(weaponName)
    if not weaponName or weaponName == "" then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local tool = backpack:FindFirstChild(weaponName) or char:FindFirstChild(weaponName)
    
    if tool and humanoid and tool.Parent ~= char then 
        humanoid:EquipTool(tool) 
    end
end

local function ParseShortenedNumber(str)
    str = string.lower(tostring(str))
    local num = tonumber(string.match(str, "[%d%.]+")) or 0
    if string.find(str, "k") then num = num * 1000
    elseif string.find(str, "m") then num = num * 1000000
    elseif string.find(str, "b") then num = num * 1000000000 end
    return num
end

-- [[ CORE KAITUN & CACHE LOGIC ]]
local function InitializeWorldCache()
    if GlobalCache.Initialized then return end
    updateStatus("Starting World Cache Initialization...")

    -- INITIAL RESET
    updateCacheUI("Resetting for initial portal_tower...")
    LocalPlayer.Character:BreakJoints()
    LocalPlayer.CharacterAdded:Wait()
    task.wait(1.5)
    
    local initialPortal = workspace:FindFirstChild("portal_tower", true)
    if initialPortal then TweenTo(initialPortal.Position) end

    -- COMBINED PHASE: Islands, Portals, and Quests together
    for _, island in ipairs(IslandsList) do
        updateCacheUI("Teleporting to Island: " .. island)
        
        -- Use the local portal if it exists to TP to the next island
        local localPortal = workspace:FindFirstChild("portal_", true)
        if localPortal then TweenTo(localPortal.Position) end

        local args = { island }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        task.wait(3.5) -- Wait for movement lock and workspace load

        -- 1. Cache the Island's Portal
        local newPortal = workspace:FindFirstChild("portal_", true)
        if newPortal then
            GlobalCache.Portals[island] = newPortal.Position
            updateCacheUI("Cached Portal for: " .. island)
        end

        -- 2. Scan and sort all rendered Quest NPCs on this specific island
        local serviceNPCs = workspace:FindFirstChild("ServiceNPCs")
        if serviceNPCs then
            local islandQuests = {}
            
            for _, npc in ipairs(serviceNPCs:GetChildren()) do
                -- Check if it matches "Quest1", "Quest2", etc.
                if string.match(npc.Name, "^Quest%d+$") then
                    table.insert(islandQuests, npc)
                end
            end
            
            -- Sort them numerically so the script doesn't backtrack erratically
            table.sort(islandQuests, function(a, b)
                local numA = tonumber(string.match(a.Name, "%d+")) or 0
                local numB = tonumber(string.match(b.Name, "%d+")) or 0
                return numA < numB
            end)

            -- 3. Tween to each NPC in numerical order and cache data
            for _, npc in ipairs(islandQuests) do
                updateCacheUI("Scraping Data: " .. npc.Name .. " on " .. island)
                
                local questPos = npc:GetPivot().Position
                TweenTo(questPos)
                task.wait(0.5)
                
                -- Accept Quest
                ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npc.Name)
                task.wait(1.5) -- Wait for UI to fully populate

                -- Extract Exact Data using EXACT provided paths
                local expText = "0"
                local reqText = ""
                
                pcall(function()
                    expText = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Reward.RewardExp.CurrencyIndicator.Text
                    reqText = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text
                end)

                local targetName = string.match(reqText, "Defeat%s+(.*)s?%!") or reqText
                local requiredAmount = tonumber(string.match(reqText, "(%d+)")) or 1

                GlobalCache.Quests[npc.Name] = {
                    Island = island,
                    Target = targetName,
                    Amount = requiredAmount,
                    Exp = ParseShortenedNumber(expText),
                    Position = questPos
                }

                -- Abandon Quest
                local abandonArgs = { "repeatable" }
                game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(abandonArgs))
                task.wait(0.5)
            end
        end
    end

    -- FINAL CACHE PHASE: DPS Test
    updateCacheUI("Calculating M1 Damage Baseline...")
    pcall(function()
        local dpsText = game:GetService("Players")[LocalPlayer.Name].PlayerGui.DamageCounterUI.DamageFrame.Holder.StatFrame.DamageLabel.Text
        GlobalCache.M1Damage = tonumber(dpsText) or 1
    end)
    
    if GlobalCache.M1Damage <= 1 then GlobalCache.M1Damage = 500 end 

    GlobalCache.Initialized = true
    updateCacheUI("Cache Complete! All Islands and Quests Mapped.")
    updateStatus("Initialization Finished. Kaitun is ready.")
end

local function GetMostEfficientQuest()
    local bestQuest = nil
    local highestExpPerSec = 0

    for npcName, data in pairs(GlobalCache.Quests) do
        local mobHP = 5000 -- Fallback calculation, scales roughly
        local timeToKillOne = (mobHP / GlobalCache.M1Damage) * 0.4
        local totalTTK = timeToKillOne * data.Amount
        
        local expPerSec = data.Exp / (totalTTK + 1)

        if expPerSec > highestExpPerSec then
            highestExpPerSec = expPerSec
            bestQuest = npcName
        end
    end
    return bestQuest
end

-- [[ KILLAURA / KAITUN LOOP ]]
local function startMasterLoop()
    if auraTask then task.cancel(auraTask); auraTask = nil end

    auraTask = task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("CombatSystem"):WaitForChild("Remotes"):WaitForChild("RequestHit")

        while killAuraActive or kaitunActive do
            if kaitunActive and not GlobalCache.Initialized then
                InitializeWorldCache()
            end

            equipWeapon(selectedWeapon)
            local currentTarget = nil
            local charPos = LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero
            local npcFolder = workspace:FindFirstChild("NPCs")

            -- 1. Priority: Boss Check
            if killAllTimedBosses and npcFolder then
                local closestBoss = nil
                local closestDist = math.huge
                for _, npc in ipairs(npcFolder:GetChildren()) do
                    if string.find(string.lower(npc.Name), "boss_") then
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            local dist = (charPos - npc:GetPivot().Position).Magnitude
                            if dist < closestDist then
                                closestBoss = npc
                                closestDist = dist
                            end
                        end
                    end
                end
                currentTarget = closestBoss
            end

            -- 2. Kaitun / Normal Targeting
            if not currentTarget and npcFolder then
                if kaitunActive then
                    local bestQuestId = GetMostEfficientQuest()
                    if bestQuestId then
                        local questData = GlobalCache.Quests[bestQuestId]
                        
                        local hasQuest = false
                        pcall(function()
                            hasQuest = game:GetService("Players")[LocalPlayer.Name].PlayerGui.QuestUI.Quest.Visible
                        end)

                        if not hasQuest then
                            updateStatus("Kaitun: Traveling to " .. bestQuestId .. " on " .. questData.Island)
                            
                            -- Use cached portal routing
                            local localPortal = workspace:FindFirstChild("portal_", true)
                            if localPortal then TweenTo(localPortal.Position) end
                            
                            local tpArgs = { questData.Island }
                            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(tpArgs))
                            task.wait(3.5)
                            
                            -- Tween to cached quest location
                            TweenTo(questData.Position)
                            ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(bestQuestId)
                            task.wait(1.5)
                        end

                        -- Target the required mob
                        local closestMobDist = math.huge
                        for _, npc in ipairs(npcFolder:GetChildren()) do
                            local hum = npc:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 and string.find(string.lower(npc.Name), string.lower(questData.Target)) then
                                local dist = (charPos - npc:GetPivot().Position).Magnitude
                                if dist < closestMobDist then
                                    closestMobDist = dist
                                    currentTarget = npc
                                end
                            end
                        end
                    end
                else
                    -- Standard KillAura
                    for _, npc in ipairs(npcFolder:GetChildren()) do
                        local hum = npc:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            currentTarget = npc
                            break
                        end
                    end
                end
            end

            -- Combat Execution
            if currentTarget then
                local hum = currentTarget:FindFirstChild("Humanoid")
                local targetPart = getTargetPart(currentTarget)

                if targetPart and hum and hum.Health > 0 then
                    updateStatus("Engaging: " .. currentTarget.Name)
                    TweenTo(targetPart.Position + Vector3.new(0, 0, 3)) 

                    while currentTarget and currentTarget.Parent and hum.Health > 0 and (killAuraActive or kaitunActive) do
                        if killAllTimedBosses and not string.find(string.lower(currentTarget.Name), "boss_") then
                            local newBossFound = false
                            for _, n in ipairs(npcFolder:GetChildren()) do
                                if string.find(string.lower(n.Name), "boss_") and n:FindFirstChild("Humanoid") and n.Humanoid.Health > 0 then
                                    newBossFound = true
                                    break
                                end
                            end
                            if newBossFound then break end 
                        end

                        local tPos = targetPart.Position
                        local success, err = pcall(function() 
                            local args = {}
                            if vectorMethod == "vector.create(X, Y, Z)" then
                                args = { vector.create(tPos.X, tPos.Y, tPos.Z) }
                            elseif vectorMethod == "Vector3.new" then
                                args = { Vector3.new(tPos.X, tPos.Y, tPos.Z) }
                            else
                                args = { tPos }
                            end
                            remote:FireServer(unpack(args)) 
                        end)

                        task.wait(0.35)
                    end
                end
            else
                task.wait(0.5) 
            end
        end
    end)
end

local function stopMasterLoop()
    killAuraActive = false
    kaitunActive = false
    updateStatus("Farming Stopped.")
    if auraTask then task.cancel(auraTask); auraTask = nil end
end

