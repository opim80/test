-- [[ HELPER FUNCTIONS ]]
local function updateStatus(msg)
    if StatusDisplay then StatusDisplay:SetDesc(msg) end
end

local function getNearestPortal()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closestPortal = nil
    local shortestDistance = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.match(string.lower(obj.Name), "^portal_") then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                closestPortal = obj
            end
        end
    end
    return closestPortal
end

local function tweenTo(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local dist = (hrp.Position - targetPos).Magnitude
    updateStatus("Tweening... Distance: " .. math.floor(dist) .. " studs")
    
    local timeToTravel = dist / tweenSpeed
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function teleportViaPortal(islandName)
    local portal = getNearestPortal()
    if portal then
        tweenTo(portal.Position)
        task.wait(0.5)
        local args = { islandName }
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(unpack(args))
        task.wait(3) -- Wait for portal stun
    end
end

-- [[ KAITUN LOGIC ]]
local function abandonQuest()
    local args = { "repeatable" }
    ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer(unpack(args))
end

local function calibrateDamage()
    updateStatus("Calibrating Damage... Striking Mob.")
    -- Pseudo-logic for hitting a mob to trigger the UI update
    task.wait(1)
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local dmgLabel = pGui:FindFirstChild("DamageCounterUI") 
            and pGui.DamageCounterUI:FindFirstChild("DamageFrame")
            and pGui.DamageCounterUI.DamageFrame:FindFirstChild("Holder")
            and pGui.DamageCounterUI.DamageFrame.Holder:FindFirstChild("StatFrame")
            and pGui.DamageCounterUI.DamageFrame.Holder.StatFrame:FindFirstChild("DamageLabel")
        
        if dmgLabel and dmgLabel.Text ~= "" then
            PlayerDPS = tonumber(string.match(dmgLabel.Text, "%d+")) or 100
        else
            PlayerDPS = 100 -- Fallback
        end
    end
    updateStatus("Damage Calibrated: " .. tostring(PlayerDPS) .. " per M1")
end

local function initializeKaitun()
    if IsInitialized then return end
    updateStatus("Initializing... Resetting Character to reach Starter Portal.")
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.Health = 0
        LocalPlayer.CharacterAdded:Wait()
        task.wait(2)
    end

    for _, island in ipairs(Islands) do
        updateStatus("Hopping to Island: " .. island .. " for Caching...")
        teleportViaPortal(island)
        
        local serviceNPCs = workspace:FindFirstChild("ServiceNPCs")
        if not serviceNPCs then continue end

        local npcCount = 1
        while true do
            local npcName = "QuestNPC" .. npcCount
            local npc = serviceNPCs:FindFirstChild(npcName)
            if not npc then break end -- Move to next island if numerical order breaks
            
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                if dist > 300 then
                    updateStatus(npcName .. " is >300 studs away. Teleporting to next island.")
                    break -- Use portal logic to find them on another island
                end

                tweenTo(hrp.Position)
                updateStatus("Caching Quest from: " .. npcName)
                
                ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer(npcName)
                task.wait(1.5)

                local pName = LocalPlayer.Name
                local questUI = game:GetService("Players")[pName].PlayerGui:FindFirstChild("QuestUI")
                if questUI then
                    local expInd = questUI.Quest.Reward.RewardExp:FindFirstChild("CurrencyIndicator")
                    local reqLabel = questUI.Quest.Quest.Holder.Content.QuestInfo:FindFirstChild("QuestRequirement")
                    
                    if expInd and reqLabel then
                        CachedQuests[npcName] = {
                            Exp = expInd.Text,
                            Requirement = reqLabel.Text
                        }
                    end
                end
                abandonQuest()
                task.wait(0.5)
            end
            npcCount = npcCount + 1
        end
    end

    calibrateDamage()
    IsInitialized = true
    updateStatus("Initialization Complete. Ready to Farm.")
end

