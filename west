-- Module Loader with Leak Detection
local function loadModule(name, ctx)
    activeLoadingContext = name
    print(string.format("📦 [BW Loader] Fetching and loading module: %s...", name))

    local url = "https://raw.githubusercontent.com/opim80/test/main/west_" .. name
    local content
    local ok, err = pcall(function() content = game:HttpGet(url) end)
    
    if not ok or not content or #content < 20 then 
        error(string.format("[BW Loader] Failed to download 'west_%s' from GitHub. URL: %s", name, url)) 
    end

    local fn, compileErr = loadstring(content, "=west_" .. name)
    if not fn then 
        error(string.format("[BW Loader] Compile error in 'west_%s': %s", name, tostring(compileErr))) 
    end

    -- Snapshot getgenv() keys before execution to detect global leaks
    local beforeGenv = {}
    for k in pairs(getgenv()) do beforeGenv[k] = true end

    setfenv(fn, setmetatable({}, { __index = SHARED, __newindex = SHARED }))
    local okRun, res = pcall(fn, ctx)
    if not okRun then 
        error(string.format("[BW Loader] Runtime error in 'west_%s': %s", name, tostring(res))) 
    end

    -- Check if module polluted getgenv() directly
    for k in pairs(getgenv()) do
        if not beforeGenv[k] and k ~= "BW3" and k ~= "BW3_Gen" and k ~= "BW3_Unload" and k ~= "BWCache" then
            warn(string.format("⚠️ [GLOBAL LEAK DETECTED] Module '%s' wrote directly to getgenv: '%s'", name, tostring(k)))
        end
    end

    if type(res) == "table" then
        for k, v in pairs(res) do SHARED[k] = v end
    end

    print(string.format("✅ [BW Loader] Loaded: %s", name))
    return res
end

