            if not loops["autoFish"] and SHARED.startFishing then SHARED.startFishing() end
        else
            if loops["autoFish"] and SHARED.stopFishing then SHARED.stopFishing() end
        end
        if S.silentAim and COMBAT.start then COMBAT.start() end
        if S.iHateYou and COMBAT.startIHateYou then COMBAT.startIHateYou() end
        if S.autoHopNearPlayer and not loops["autoHopNearPlayer"] then
            loop("autoHopNearPlayer", 0.5, SHARED.playerProximityTick)
        end
        if S.autoChests and not loops["autoChests"] then
            loop("autoChests", 0.8, function() SHARED.farmTick("Chests", "chest", false) end)
        end
        if S.autoHerbs and not loops["autoHerbs"] then
            loop("autoHerbs", 0.8, function() SHARED.farmTick("SpawnedHerbs", "herb", false) end)
        end
        if S.autoBuy and not loops["autoBuy"] then
