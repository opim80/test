        end
        if S.saintWatch and not loops["saintWatch"] then
            loop("saintWatch", 2, SHARED.saintTick)
        end
        if SHARED.ensureESP then pcall(SHARED.ensureESP) end
        if UI.setBlackscreen and S.blackscreen ~= nil then
            pcall(function() UI.setBlackscreen(S.blackscreen) end)
        end
    end

    getgenv().BW3 = {
        S = S,
        UI = UI,
        Status = Status,
        COMBAT = COMBAT,
        startFakeHorseFly = SHARED.startFakeHorseFly,
        stopFakeHorseFly = SHARED.stopFakeHorseFly,
        mountHorse = SHARED.mountHorse,
        summonHorse = SHARED.summonHorse,
        dismount = SHARED.dismount,
        isMounted = SHARED.isMounted,
        setBlackscreen = UI.setBlackscreen,
        serverHop = SHARED.serverHop,
        playerProximityTick = SHARED.playerProximityTick,
        syncActiveFeatures = syncActiveFeatures,
        loadConfig = SHARED.loadConfig,
        applyGenvConfig = SHARED.applyGenvConfig,
