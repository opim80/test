local function loadModule(name, ctx)
    local url = "https://raw.githubusercontent.com/opim80/test/main/west_" .. name
    local content
    local ok, err = pcall(function() content = game:HttpGet(url) end)
    if not ok or not content then error(string.format("[BW Loader] Failed to fetch module %s\nURL: %s", name, url)) end

    local fn, compileErr = loadstring(content, "=" .. name)
    if not fn then error(string.format("[BW Loader] Compile error in %s: %s", name, tostring(compileErr))) end

    setfenv(fn, setmetatable({}, { __index = SHARED, __newindex = SHARED }))
    local okRun, res = pcall(fn, ctx)
    if not okRun then error(string.format("[BW Loader] Runtime error in %s: %s", name, tostring(res))) end

    if type(res) == "table" then
        for k, v in pairs(res) do SHARED[k] = v end
    end
    return res
end

