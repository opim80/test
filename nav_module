local ctx = (typeof(...) == "table" and ...) or {}

local Workspace, Players = game:GetService("Workspace"), game:GetService("Players")
local LP = Players.LocalPlayer or Players.PlayerAdded:Wait()

local Vec3, CF = Vector3.new, CFrame.new
local min, max, abs, clamp, floor, round, ceil = math.min, math.max, math.abs, math.clamp, math.floor, math.round, math.ceil
local clock, task_wait, insert, remove = os.clock, task.wait, table.insert, table.remove

local function char()
    return (ctx.Utils and ctx.Utils.char and ctx.Utils.char())
        or (ctx.char and ctx.char())
        or LP.Character
end

local function root()
    return (ctx.Utils and ctx.Utils.root and ctx.Utils.root())
        or (ctx.root and ctx.root())
        or (char() and char():FindFirstChild("HumanoidRootPart"))
end

local function hum()
    return (ctx.Utils and ctx.Utils.hum and ctx.Utils.hum())
        or (ctx.hum and ctx.hum())
        or (char() and char():FindFirstChildOfClass("Humanoid"))
end

local function getHorse()
    return (ctx.Movement and ctx.Movement.myHorse and ctx.Movement.myHorse())
        or (ctx.myHorse and ctx.myHorse())
end

local function log(msg, color, tag)
    local fn = (ctx.Logging and ctx.Logging.logAction) or ctx.logAction
    if fn then fn("NAV", msg, color or Color3.fromRGB(80, 200, 255), tag or "TRAVEL") end
end

-- ==========================================
-- HARDWARE DRIVER & MOTION
-- ==========================================
local keypressFn = keypress or (syn and syn.keypress) or (fluxus and fluxus.keypress)
local keyreleaseFn = keyrelease or (syn and syn.keyrelease) or (fluxus and fluxus.keyrelease)
local keyclickFn = keyclick

local function tapSpace()
    local h = hum()
    if h then pcall(function() h.Jump = true end) end
    if keyclickFn then pcall(keyclickFn, 0x20)
    elseif keypressFn and keyreleaseFn then
        pcall(keypressFn, 0x20); task_wait(0.03); pcall(keyreleaseFn, 0x20)
    end
    if keyreleaseFn then pcall(keyreleaseFn, 0x20) end
end

local function stopMotion(h)
    if h then pcall(function() h:Move(Vec3(0,0,0), false); h.WalkSpeed = 16; h.Jump = false end) end
    if keyreleaseFn then pcall(keyreleaseFn, 0x10); pcall(keyreleaseFn, 0x20) end
end

-- ==========================================
-- CONSTANTS & RAYCASTING
-- ==========================================
-- GRID_SIZE = 2.0 allows pathing through standard 3-stud doorways
-- MAX_STEP_UP = 1.1 ensures curbs and porch steps trigger jumps immediately
local GRID_SIZE, MAX_STEP_UP, MAX_VAULT_HURDLE, MAX_SINGLE_JUMP, MAX_DOUBLE_JUMP, MAX_DROP_DOWN = 2.0, 1.1, 3.2, 5.0, 8.0, 16.0
local rpGround, rpBody = RaycastParams.new(), RaycastParams.new()
rpGround.FilterType, rpGround.IgnoreWater = Enum.RaycastFilterType.Exclude, false
rpBody.FilterType = Enum.RaycastFilterType.Exclude

local function updateFilters()
    local ex, c = {}, char()
    if c then insert(ex, c) end
    local h = getHorse()
    if h then insert(ex, h) end
    rpGround.FilterDescendantsInstances, rpBody.FilterDescendantsInstances = ex, ex
end

local function classifyJump(h)
    return (h > MAX_SINGLE_JUMP and h <= MAX_DOUBLE_JUMP and "double")
        or (h > MAX_STEP_UP and h <= MAX_SINGLE_JUMP and "single")
        or "none"
end

-- ==========================================
-- GEOMETRY & OBSTACLES
-- ==========================================
local function findWalkableFloor(origin: Vector3, searchDepth: number)
    local curOrigin, depthLeft = origin, searchDepth
    for _ = 1, 5 do
        local hit = Workspace:Raycast(curOrigin, Vec3(0, -depthLeft, 0), rpGround)
        if not hit then return nil end
        if hit.Material == Enum.Material.Water then return nil end
        local name = hit.Instance and hit.Instance.Name:lower() or ""
        if name:find("water") or name:find("ocean") or name:find("river") then return nil end
        if hit.Instance and (hit.Instance.CanCollide or hit.Instance:IsA("Terrain")) then return hit end
        local dropped = (curOrigin.Y - hit.Position.Y) + 0.1
        depthLeft = depthLeft - dropped
        if depthLeft <= 0 then break end
        curOrigin = hit.Position - Vec3(0, 0.1, 0)
    end
    return nil
end

local function isSolidWall(hit: RaycastResult?): boolean
    if not hit or not hit.Instance then return false end
    if not hit.Instance.CanCollide and not hit.Instance:IsA("Terrain") then return false end
    return hit.Instance:IsA("Terrain") and (hit.Normal.Y < 0.55) or true
end

local function getObstacleTop(hitPos: Vector3, baseFloorY: number, travelDir: Vector3?): (number, boolean, number)
    local lowCeiling = Workspace:Raycast(Vec3(hitPos.X, baseFloorY + 1.5, hitPos.Z), Vec3(0, 8.5, 0), rpBody)
    if isSolidWall(lowCeiling) then return math.huge, false, baseFloorY end

    local topHit = findWalkableFloor(Vec3(hitPos.X, baseFloorY + MAX_VAULT_HURDLE + 1.5, hitPos.Z), MAX_VAULT_HURDLE + 3.0)
    if topHit then
        local topY = topHit.Position.Y
        local obsHeight = topY - baseFloorY

        if obsHeight > MAX_VAULT_HURDLE or obsHeight <= 0.2 then return math.huge, false, baseFloorY end

        local ceiling = Workspace:Raycast(Vec3(hitPos.X, topY + 0.5, hitPos.Z), Vec3(0, 5.0, 0), rpBody)
        if isSolidWall(ceiling) then return math.huge, false, baseFloorY end

        if travelDir and travelDir.Magnitude > 0.1 then
            local fwd = Vec3(travelDir.X, 0, travelDir.Z).Unit
            local landingProbePos = Vec3(hitPos.X, topY + 0.8, hitPos.Z) + (fwd * 2.0)

            local wallBehind = Workspace:Raycast(Vec3(hitPos.X, topY + 0.8, hitPos.Z), fwd * 2.0, rpBody)
            if isSolidWall(wallBehind) then return math.huge, false, baseFloorY end

            local landingFloor = findWalkableFloor(landingProbePos, obsHeight + 4.0)
            if not landingFloor then return math.huge, false, baseFloorY end

            local landingCeiling = Workspace:Raycast(Vec3(landingProbePos.X, landingFloor.Position.Y + 0.5, landingProbePos.Z), Vec3(0, 5.0, 0), rpBody)
            if isSolidWall(landingCeiling) then return math.huge, false, baseFloorY end
        end

        return obsHeight, true, topY
    end
    return math.huge, false, baseFloorY
end

local function evaluateCell(worldX: number, worldZ: number, refFloorY: number)
    local probeOrigin = Vec3(worldX, refFloorY + MAX_DOUBLE_JUMP + 1.5, worldZ)
    local totalDepth, floorHit = MAX_DROP_DOWN + MAX_DOUBLE_JUMP + 2.5, nil
    for _ = 1, 4 do
        floorHit = findWalkableFloor(probeOrigin, totalDepth)
        if not floorHit then return nil end
        local floorY = floorHit.Position.Y
        if floorY > (refFloorY + MAX_DOUBLE_JUMP + 0.5) then
            totalDepth = totalDepth - ((probeOrigin.Y - floorY) + 0.2)
            if totalDepth <= 0 then return nil end
            probeOrigin = Vec3(worldX, floorY - 0.2, worldZ)
        else break end
    end
    if not floorHit then return nil end
    local floorY = floorHit.Position.Y

    -- Require 5 studs of clear standing headroom
    if isSolidWall(Workspace:Raycast(Vec3(worldX, floorY + 0.4, worldZ), Vec3(0, 5.0, 0), rpBody)) then return nil end

    local nearEdge = false
    for _, off in ipairs({ Vec3(1.5, 0, 0), Vec3(-1.5, 0, 0), Vec3(0, 0, 1.5), Vec3(0, 0, -1.5) }) do
        local edgeHit = findWalkableFloor(Vec3(worldX + off.X, floorY + 2.0, worldZ + off.Z), 8.0)
        if not edgeHit or (floorY - edgeHit.Position.Y) > 5.0 then nearEdge = true; break end
    end
    return { pos = Vec3(worldX, floorY + 1.5, worldZ), floorY = floorY, nearEdge = nearEdge }
end

local function isTraversableBetween(posA: Vector3, posB: Vector3, floorYA: number, floorYB: number): (boolean, string)
    local heightDiff = floorYB - floorYA
    if heightDiff > MAX_DOUBLE_JUMP or heightDiff < -MAX_DROP_DOWN then return false, "none" end

    local jumpType = classifyJump(heightDiff)
    local baseFloor = min(floorYA, floorYB)
    local dir = posB - posA
    local horizDir = Vec3(dir.X, 0, dir.Z)

    -- Sweep rays at knees, torso, and head
    for _, yOff in ipairs({ 0.5, 1.8, 3.2 }) do
        local rayOrigin = Vec3(posA.X, floorYA + yOff, posA.Z)
        local rayDir = (Vec3(posB.X, floorYB + yOff, posB.Z) - rayOrigin)
        local hit = Workspace:Raycast(rayOrigin, rayDir, rpBody)
        if hit and isSolidWall(hit) then
            -- Obstacles must be low vaultable fences/crates, NEVER building walls
            local obsHeight, hasHeadroom = getObstacleTop(hit.Position, baseFloor, horizDir)
            if not hasHeadroom or obsHeight > MAX_VAULT_HURDLE then return false, "none" end

            local startHeadroom = Workspace:Raycast(Vec3(posA.X, floorYA + 0.5, posA.Z), Vec3(0, obsHeight + 4.5, 0), rpBody)
            if isSolidWall(startHeadroom) then return false, "none" end

            local needed = classifyJump(obsHeight)
            if (needed == "double") or (needed == "single" and jumpType == "none") then jumpType = needed end
        end
    end
    return true, jumpType
end

local function canTraverseDirect(posA: Vector3, posB: Vector3, floorYA: number, floorYB: number): boolean
    local fullDir = posB - posA
    local horiz = Vec3(fullDir.X, 0, fullDir.Z)
    local dist = horiz.Magnitude

    -- Single center-line check when within 1.5 studs
    if dist <= 1.5 then
        local quickHit = Workspace:Raycast(posA + Vec3(0, 1.0, 0), fullDir, rpBody)
        return not (quickHit and isSolidWall(quickHit))
    end
    if dist > 20.0 then return false end

    local fwd = horiz.Unit
    local side = Vec3(-fwd.Z, 0, fwd.X)

    -- Bidirectional check
    for _, yOff in ipairs({ 0.5, 1.8, 3.2 }) do
        for _, sideMult in ipairs({ 0, 1.1, -1.1 }) do
            local oA = Vec3(posA.X, floorYA + yOff, posA.Z) + (side * sideMult)
            local oB = Vec3(posB.X, floorYB + yOff, posB.Z) + (side * sideMult)

            local hitFwd = Workspace:Raycast(oA, oB - oA, rpBody)
            if hitFwd and isSolidWall(hitFwd) then return false end

            local hitRev = Workspace:Raycast(oB, oA - oB, rpBody)
            if hitRev and isSolidWall(hitRev) then return false end
        end
    end

    local steps = clamp(ceil(dist / 1.6), 2, 20)
    for i = 1, steps do
        local alpha = i / (steps + 1)
        local samplePos = posA:Lerp(posB, alpha)
        local expectedY = floorYA + (floorYB - floorYA) * alpha

        local floorHit = findWalkableFloor(Vec3(samplePos.X, expectedY + 2.5, samplePos.Z), 6.0)
        if not floorHit or abs(floorHit.Position.Y - expectedY) > (MAX_STEP_UP + 0.8) then
            return false
        end

        local bodyClear = Workspace:Raycast(Vec3(samplePos.X, expectedY + 0.4, samplePos.Z), Vec3(0, 4.5, 0), rpBody)
        if isSolidWall(bodyClear) then return false end
    end

    return true
end

-- ==========================================
-- BINARY HEAP WEIGHTED A*
-- ==========================================
local function heapPush(heap, item)
    insert(heap, item)
    local idx = #heap
    while idx > 1 do
        local p = floor(idx / 2)
        if heap[idx].f < heap[p].f then heap[idx], heap[p] = heap[p], heap[idx]; idx = p else break end
    end
end

local function heapPop(heap)
    if #heap == 0 then return nil end
    local top, last = heap[1], remove(heap)
    if #heap > 0 then
        heap[1] = last
        local idx, n = 1, #heap
        while true do
            local left, right, sm = idx * 2, (idx * 2) + 1, idx
            if left <= n and heap[left].f < heap[sm].f then sm = left end
            if right <= n and heap[right].f < heap[sm].f then sm = right end
            if sm ~= idx then heap[idx], heap[sm] = heap[sm], heap[idx]; idx = sm else break end
        end
    end
    return top
end

local DIRS = {
    Vec3(GRID_SIZE, 0, 0), Vec3(-GRID_SIZE, 0, 0), Vec3(0, 0, GRID_SIZE), Vec3(0, 0, -GRID_SIZE),
    Vec3(GRID_SIZE, 0, GRID_SIZE), Vec3(-GRID_SIZE, 0, GRID_SIZE), Vec3(GRID_SIZE, 0, -GRID_SIZE), Vec3(-GRID_SIZE, 0, -GRID_SIZE)
}

local function solvePath(startPos: Vector3, goalPos: Vector3)
    updateFilters()

    local startHit = findWalkableFloor(startPos + Vec3(0, 3.0, 0), 8.0)
    local startFloorY = startHit and startHit.Position.Y or (startPos.Y - 2.5)
    local goalHit = findWalkableFloor(goalPos + Vec3(0, 3.0, 0), 14.0)
    local goalFloorY = goalHit and goalHit.Position.Y or goalPos.Y

    local startFloor, goalFloor = Vec3(startPos.X, startFloorY, startPos.Z), Vec3(goalPos.X, goalFloorY, goalPos.Z)
    local resolvedGoal = goalFloor + Vec3(0, 1.5, 0)
    local initialDist = (startFloor - goalFloor).Magnitude

    if initialDist <= 16.0 and canTraverseDirect(startFloor, goalFloor, startFloorY, goalFloorY) then
        return { { pos = resolvedGoal, floorY = goalFloorY, jumpType = classifyJump(goalFloorY - startFloorY) } }, true
    end

    local openHeap, cameFrom, gScore, closedSet, jumpReq = {}, {}, {}, {}, {}
    gScore["0:0"] = 0

    local H_WEIGHT = 1.3
    heapPush(openHeap, { gx = 0, gz = 0, pos = startFloor + Vec3(0, 1.5, 0), floorY = startFloorY, f = initialDist * H_WEIGHT })

    local bestNode, reachedGoal, iterations = nil, false, 0
    while #openHeap > 0 and iterations < 7000 do
        iterations = iterations + 1
        local current = heapPop(openHeap)
        if not current then break end

        local curFloor = Vec3(current.pos.X, current.floorY, current.pos.Z)
        local distToGoal = (curFloor - goalFloor).Magnitude

        -- Only accept goal if line-of-sight is unobstructed
        if distToGoal <= 2.2 and canTraverseDirect(curFloor, goalFloor, current.floorY, goalFloorY) then
            bestNode, reachedGoal = current, true
            break
        elseif distToGoal <= 8.0 and canTraverseDirect(curFloor, goalFloor, current.floorY, goalFloorY) then
            bestNode, reachedGoal = current, true
            break
        end

        local curKey = current.gx .. ":" .. current.gz
        closedSet[curKey] = true
        local curG = gScore[curKey] or 0

        for _, offset in ipairs(DIRS) do
            local nGX, nGZ = current.gx + round(offset.X / GRID_SIZE), current.gz + round(offset.Z / GRID_SIZE)
            local nKey = nGX .. ":" .. nGZ

            if not closedSet[nKey] then
                local wx, wz = startFloor.X + (nGX * GRID_SIZE), startFloor.Z + (nGZ * GRID_SIZE)
                local neighbor = evaluateCell(wx, wz, current.floorY)
                if neighbor then
                    local canTraverse, jType = isTraversableBetween(current.pos, neighbor.pos, current.floorY, neighbor.floorY)
                    if canTraverse then
                        local penalty = (jType == "double" and 4.0) or (jType == "single" and 1.5) or (neighbor.nearEdge and 8.0 or 0)
                        local tentativeG = curG + (current.pos - neighbor.pos).Magnitude + penalty
                        if tentativeG < (gScore[nKey] or math.huge) then
                            cameFrom[nKey], jumpReq[nKey], gScore[nKey] = current, jType, tentativeG
                            local hDist = (Vec3(wx, neighbor.floorY, wz) - goalFloor).Magnitude
                            heapPush(openHeap, { gx = nGX, gz = nGZ, pos = neighbor.pos, floorY = neighbor.floorY, f = tentativeG + (hDist * H_WEIGHT) })
                        end
                    end
                end
            end
        end
    end

    -- If no valid path to goal exists, reject instead of leading straight into a wall
    if not reachedGoal or not bestNode then
        return nil, false
    end

    local rawPath, curr = {}, bestNode
    while curr do
        local k = curr.gx .. ":" .. curr.gz
        insert(rawPath, 1, { pos = curr.pos, floorY = curr.floorY, jumpType = jumpReq[k] or "none" })
        curr = cameFrom[k]
    end
    if #rawPath <= 1 then return nil, false end

    if (rawPath[#rawPath].pos - resolvedGoal).Magnitude > 1.2 then
        insert(rawPath, { pos = resolvedGoal, floorY = goalFloorY, jumpType = classifyJump(goalFloorY - rawPath[#rawPath].floorY) })
    end

    -- Smooth path while guaranteeing no wall-clipping
    local smoothed, cIdx = { rawPath[1] }, 1
    while cIdx < #rawPath do
        local nextIdx = #rawPath
        while nextIdx > cIdx + 1 do
            if canTraverseDirect(rawPath[cIdx].pos, rawPath[nextIdx].pos, rawPath[cIdx].floorY, rawPath[nextIdx].floorY) then break end
            nextIdx = nextIdx - 1
        end
        insert(smoothed, rawPath[nextIdx])
        cIdx = nextIdx
    end
    return smoothed, true
end

-- ==========================================
-- RESPONSIVE JUMP MOTOR
-- ==========================================
local function executeJumpClimb(targetWpPos: Vector3, isDouble: boolean, myToken: number, NAV: any)
    local r, h = root(), hum()
    if not r or not h or h.Health <= 0 then return false end

    -- Maintain continuous forward momentum towards target
    h:MoveTo(targetWpPos)
    tapSpace()

    if isDouble then
        task_wait(0.18)
        if NAV.walkToken == myToken then
            tapSpace()
        end
    end
    task_wait(0.15)
    return true
end

-- ==========================================
-- MODULE DEFINITION & EVENT HOOKS
-- ==========================================
local NAV = {}
NAV.__index = NAV

NAV.walkToken = 0
NAV.isWalking = false
NAV.activeTarget = nil
NAV.activeRoute = nil
NAV.tapSpace = tapSpace

NAV.visuals = {
    onTarget = nil,
    onRoute = nil,
    onStep = nil,
    onClear = nil,
}

local function emitVisual(hookName, ...)
    local fn = NAV.visuals[hookName]
    if fn then pcall(fn, ...) end
end

function NAV.setContext(newCtx)
    if typeof(newCtx) == "table" then
        ctx = newCtx
    end
end
NAV.init = NAV.setContext

function NAV.cancel()
    NAV.walkToken = NAV.walkToken + 1
    NAV.isWalking = false
    NAV.activeTarget = nil
    NAV.activeRoute = nil
    emitVisual("onClear")
    stopMotion(hum())
end

function NAV.walkTo(targetPos: Vector3, options: any?): boolean
    if not targetPos then return false end
    local opt = options or {}
    local maxTimeout, stopDist = opt.timeout or 120, opt.stopDist or 3.5
    local allowSprint = opt.sprint ~= false

    local r, h = root(), hum()
    if not r or not h or h.Health <= 0 then return false end

    NAV.walkToken = NAV.walkToken + 1
    local myToken = NAV.walkToken
    NAV.isWalking, NAV.activeTarget = true, targetPos

    emitVisual("onTarget", targetPos)

    local totalTimeout, success = clock(), false

    while NAV.walkToken == myToken and (clock() - totalTimeout < maxTimeout) do
        r, h = root(), hum()
        if not r or not h or h.Health <= 0 then break end

        local distToTarget = (targetPos - r.Position).Magnitude

        -- Instant arrival check without side-ray false positives
        if distToTarget <= 1.8 then
            local directRay = Workspace:Raycast(r.Position + Vec3(0, 1.0, 0), targetPos - r.Position, rpBody)
            if not (directRay and isSolidWall(directRay)) then
                success = true
                break
            end
        end
        if distToTarget <= stopDist then
            local directRay = Workspace:Raycast(r.Position + Vec3(0, 1.0, 0), targetPos - r.Position, rpBody)
            if not (directRay and isSolidWall(directRay)) then
                success = true
                break
            end
        end

        local waypoints, isComplete = solvePath(r.Position, targetPos)
        if not waypoints or #waypoints == 0 then
            -- Fallback escape sampling
            local l, rt = r.CFrame.LookVector * 3.5, r.CFrame.RightVector * 3.5
            for _, esc in ipairs({ -l, rt, -rt, -l + rt, -l - rt }) do
                local testPos = r.Position + esc
                waypoints, isComplete = solvePath(testPos, targetPos)
                if waypoints and #waypoints > 1 then
                    insert(waypoints, 1, { pos = testPos, floorY = testPos.Y - 1.5, jumpType = "none" })
                    break
                end
            end
        end

        if not waypoints or #waypoints == 0 then
            log("No open trajectory found to destination", Color3.fromRGB(245, 140, 60), "NAV")
            break
        end

        NAV.activeRoute = waypoints
        emitVisual("onRoute", waypoints)

        local wpIndex, lastRecalc, wasFalling = 1, clock(), false
        local stuckAnchor, stuckTime, stuckAttempts = r.Position, clock(), 0

        while wpIndex <= #waypoints and NAV.walkToken == myToken do
            r, h = root(), hum()
            if not r or not h or h.Health <= 0 then break end

            local st = h:GetState()
            if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Physics then
                pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp); h.PlatformStand = false end)
                task_wait(0.2)
            end
            if h.Sit then h.Sit = false; tapSpace() end
            if h.PlatformStand then h.PlatformStand = false end

            if st == Enum.HumanoidStateType.Freefall then wasFalling = true
            elseif wasFalling and (h.FloorMaterial ~= Enum.Material.Air) then wasFalling = false; break end

            if st == Enum.HumanoidStateType.Swimming then tapSpace(); task_wait(0.2); break end

            local currentWp = waypoints[wpIndex]
            if (currentWp.pos.Y - r.Position.Y) > (MAX_DOUBLE_JUMP + 1.0) then break end

            emitVisual("onStep", wpIndex, currentWp)

            local toWp = currentWp.pos - r.Position
            local flatDist = Vec3(toWp.X, 0, toWp.Z).Magnitude
            distToTarget = (targetPos - r.Position).Magnitude

            -- Real-time arrival check
            if distToTarget <= 1.8 then
                local directRay = Workspace:Raycast(r.Position + Vec3(0, 1.0, 0), targetPos - r.Position, rpBody)
                if not (directRay and isSolidWall(directRay)) then
                    success = true
                    break
                end
            end
            if distToTarget <= stopDist then
                local directRay = Workspace:Raycast(r.Position + Vec3(0, 1.0, 0), targetPos - r.Position, rpBody)
                if not (directRay and isSolidWall(directRay)) then
                    success = true
                    break
                end
            end

            local fwd = flatDist > 0.2 and toWp.Unit or r.CFrame.LookVector
            local fwdHit = Workspace:Raycast(r.Position + Vec3(0, 0.8, 0), fwd * 2.8, rpBody)
            local obsHeight, hasHeadroom = 0, false
            if fwdHit and isSolidWall(fwdHit) then
                obsHeight, hasHeadroom = getObstacleTop(fwdHit.Position, r.Position.Y - 2.2, fwd)
            end

            -- Instant jump triggers on approach (flatDist <= 3.8 ensures clean clearance)
            local reqJump = (currentWp.jumpType ~= "none" and flatDist <= 3.8)
            local reqClimb = (hasHeadroom and obsHeight > MAX_STEP_UP and obsHeight <= MAX_VAULT_HURDLE and flatDist <= 3.2)
            local reqStep = ((currentWp.pos.Y - r.Position.Y) > MAX_STEP_UP and flatDist <= 3.4)

            if reqJump or reqClimb or reqStep then
                local isDbl = (currentWp.jumpType == "double") or (obsHeight > MAX_SINGLE_JUMP)
                executeJumpClimb(currentWp.pos, isDbl, myToken, NAV)
            end

            if flatDist <= 2.2 then
                wpIndex = wpIndex + 1
                if wpIndex <= #waypoints then currentWp = waypoints[wpIndex] end
            end

            local sprinting = allowSprint and (targetPos - r.Position).Magnitude > 18
            h.WalkSpeed = sprinting and 22 or 16
            if keypressFn and keyreleaseFn then
                pcall(sprinting and keypressFn or keyreleaseFn, 0x10)
            end

            h:MoveTo(currentWp.pos)

            if clock() - lastRecalc > 0.50 then
                lastRecalc = clock()
                local distGoal = (targetPos - r.Position).Magnitude
                if distGoal <= 18.0 then
                    local rF, gF = r.Position.Y - 1.5, targetPos.Y - 1.5
                    if canTraverseDirect(r.Position, targetPos, rF, gF) then
                        waypoints = { { pos = targetPos + Vec3(0, 1.5, 0), floorY = targetPos.Y, jumpType = classifyJump(gF - rF) } }
                        NAV.activeRoute = waypoints
                        emitVisual("onRoute", waypoints)
                        wpIndex = 1
                        break
                    end
                end
            end

            -- Fast un-snagger for doorframes and corners
            if clock() - stuckTime >= 0.55 then
                local distMoved = (r.Position - stuckAnchor).Magnitude
                if distMoved < 0.65 and flatDist > 1.0 then
                    stuckAttempts = stuckAttempts + 1

                    local snagProbe = Workspace:Raycast(r.Position + Vec3(0, 0.8, 0), fwd * 2.2, rpBody)
                        or Workspace:Raycast(r.Position + Vec3(0, 0.8, 0), r.CFrame.LookVector * 2.0, rpBody)

                    if snagProbe and isSolidWall(snagProbe) then
                        local wallNormal = snagProbe.Normal
                        local flatNormal = Vec3(wallNormal.X, 0, wallNormal.Z)
                        if flatNormal.Magnitude > 0.1 then
                            local unwedgeDir = (flatNormal.Unit * 1.8 + toWp.Unit * 0.6).Unit
                            h:MoveTo(r.Position + unwedgeDir * 2.0)
                            task_wait(0.14)
                        end
                    else
                        tapSpace()
                        h:MoveTo(currentWp.pos)
                    end

                    if stuckAttempts >= 3 then
                        stuckAttempts = 0
                        break
                    end
                else
                    stuckAttempts = 0
                end
                stuckAnchor, stuckTime = r.Position, clock()
            end
            task_wait(0.04)
        end
        if success then break end
        task_wait(0.04)
    end

    stopMotion(hum())
    if NAV.walkToken == myToken then
        NAV.isWalking = false
        NAV.activeTarget = nil
        NAV.activeRoute = nil
        emitVisual("onClear")
    end
    return success
end

return NAV
