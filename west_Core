pcall(function()
    local hook_fn = hookfunction or replaceclosure
    local getgc_fn = getgc or get_gc_objects

    -- 1. Memory Hook
    if getgc_fn and hook_fn then
        for _, v in pairs(getgc_fn(true)) do
            if type(v) == "table" then
                if rawget(v, "Detected") and type(rawget(v, "Detected")) == "function" then
                    hook_fn(rawget(v, "Detected"), function() return end)
                end
                if rawget(v, "Kill") and type(rawget(v, "Kill")) == "function" then
                    hook_fn(rawget(v, "Kill"), function() return end)
                end
            elseif type(v) == "function" then
                local info = debug.getinfo(v)
                if info and (info.name == "Detected" or info.name == "Kill" or info.name == "Kick") then
                    hook_fn(v, function() return end)
                end
            end
        end
    end

    -- 2. Network Silencer (Blocks Adonis from sending the kick command)
    local OldNamecall
    OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if not checkcaller() then
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local args = {...}
                if type(args[1]) == "string" then
                    local str = string.lower(args[1])
                    if string.find(str, "detected") or string.find(str, "kick") or string.find(str, "crash") or string.find(str, "log") or string.find(str, "exploit") then
                        return -- Drop the report
                    end
                end
                local name = string.lower(tostring(self.Name))
                if string.find(name, "adonis") or name == "client" then
                    return -- Drop Adonis remote
                end
            end
        end
        return OldNamecall(self, ...)
    end)
end)

