-- Inventory Check
local function getHeartCount()
    local count = 0
    local function countTools(container)
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local name = string.lower(tool.Name)
                if string.find(name, "heart") or string.find(name, "devil") then
                    count = count + 1
                end
            end
        end
    end
    
    if LocalPlayer:FindFirstChild("Backpack") then countTools(LocalPlayer.Backpack) end
    if LocalPlayer.Character then countTools(LocalPlayer.Character) end
    
    return count
end

local function unstuckCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {char}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude

    local parts = Workspace:GetPartsInPart(root, overlapParams)
    
    if #parts > 0 then
        local attempts = 0
        -- Reduced max attempts to prevent locking frame for too long
        while #parts > 0 and attempts < 5 do
            root.CFrame = root.CFrame + Vector3.new(0, 1, 0)
            parts = Workspace:GetPartsInPart(root, overlapParams)
            attempts = attempts + 1
            task.wait()
        end
    end
end

local function getGroundPosition(targetX, targetZ)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rayOrigin = Vector3.new(targetX, char.HumanoidRootPart.Position.Y + 100, targetZ)
    local rayDirection = Vector3.new(0, -5000, 0)
    
    -- Update Filter only, keep params instance
    groundRayParams.FilterDescendantsInstances = {char}

    local raycastResult = Workspace:Raycast(rayOrigin, rayDirection, groundRayParams)
    
    if raycastResult then
        return Vector3.new(targetX, raycastResult.Position.Y, targetZ)
    else
        return nil
    end
end

-- Collision Group Check (Invisible Walls)
local function checkPathCollision(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    
    local map = workspace:FindFirstChild("map")
    local rokyo = map and map:FindFirstChild("Rokyo")
    local colGroup = rokyo and rokyo:FindFirstChild("Collision Group")
    
    if colGroup then
        local origin = char.HumanoidRootPart.Position
        local direction = targetPos - origin
        
        collisionParams.FilterDescendantsInstances = {colGroup}
        
        local result = workspace:Raycast(origin, direction, collisionParams)
        if result then return true end
    end
    return false
end

-- Detailed Heart Analysis (Grounding & Burial)
local function analyzeHeartPhysics(heartPart)
    local pos = heartPart.Position
    local probability = 0
    local flags = {}

    -- 1. Check if Buried
    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local partsInHeart = workspace:GetPartsInPart(heartPart, overlapParams)
    local isBuried = false
    for _, p in ipairs(partsInHeart) do
        if p.CanCollide and p.Transparency < 1 then
            isBuried = true
            probability = probability + 60
            table.insert(flags, "Buried")
            break
        end
    end

    -- 2. Check if Grounded (Floating)
    local rayOrigin = heartPart.Position
    local rayDir = Vector3.new(0, -4, 0) 
    
    analysisParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}

    local result = workspace:Raycast(rayOrigin, rayDir, analysisParams)
    local isFloating = false

    if not result then
        -- Only flag as floating if we are reasonably close to ensure ground should be loaded
        local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) 
            and (LocalPlayer.Character.HumanoidRootPart.Position - pos).Magnitude or 9999
        
        if dist < 400 then
            isFloating = true
            probability = probability + 40
            table.insert(flags, "Floating")
        end
    end

    -- 3. Y-Level Check
    if pos.Y < AC_BAIT_Y_LIMIT then
        probability = probability + 100
        table.insert(flags, "LowY")
    end

    return isBuried, isFloating, probability
end

local function findDevilHeart()
    updateStatus("Scanning for heart...")
    local map = workspace:FindFirstChild("map")
    local rokyos = map and map:FindFirstChild("Rokyo")
    if rokyos then
        for _, object in ipairs(rokyos:GetChildren()) do
            if object:IsA("MeshPart") and object.MeshId == MESH_ID_TARGET then
                if object:FindFirstChildOfClass("PointLight") then 
                    local pos = object.Position
                    
                    if pos.Y < AC_BAIT_Y_LIMIT then return "ACBait", pos, object end
                    
                    local isBuried, isFloating, _ = analyzeHeartPhysics(object)
                    
                    if isBuried then return "Buried", pos, object end
                    if isFloating then return "Floating", pos, object end

                    return "valid", pos, object
                end
            end
        end
    end
    return nil, nil, nil
end

local function sendWebhook(title, message, color)
    if webhookEnabled and webhookURL ~= "" and webhookURL:find("discord.com/api/webhooks") then
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = message,
                ["color"] = color or 0x00ff00,
                ["timestamp"] = DateTime.now():ToIsoDate()
            }}
        }
        task.spawn(function()
            pcall(function()
                request({
                    Url = webhookURL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(data)
                })
            end)
        end)
    end
end

local function serverHop()
    updateStatus("Preparing to hop...")
    local history = isfile(SERVER_LOG_FILE) and HttpService:JSONDecode(readfile(SERVER_LOG_FILE)) or {}
    history[game.JobId] = os.time()
    
    local expireMinutes = Fluent.Options.ServerLogExpiry and Fluent.Options.ServerLogExpiry.Value or 30
    local expireTime = expireMinutes * 60
    local currentTime = os.time()
    
    for id, timestamp in pairs(history) do
        if (currentTime - timestamp) > expireTime then history[id] = nil end
    end
    
    writefile(SERVER_LOG_FILE, HttpService:JSONEncode(history))

    updateStatus("Fetching server list...")
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)

    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and not history[server.id] and server.id ~= game.JobId then
                updateStatus("Teleporting...")
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
                return
            end
        end
    end
    updateStatus("No servers found.")
end

