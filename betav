-- Inventory Check to prevent picking up hearts when full
local function getHeartCount()
    local count = 0
    -- Check Backpack
    if LocalPlayer:FindFirstChild("Backpack") then
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (string.find(string.lower(tool.Name), "heart") or string.find(string.lower(tool.Name), "devil")) then
                count = count + 1
            end
        end
    end
    -- Check Character (Equipped)
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and (string.find(string.lower(tool.Name), "heart") or string.find(string.lower(tool.Name), "devil")) then
                count = count + 1
            end
        end
    end
    return count
end

local function unstuckCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {char}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude

    local parts = Workspace:GetPartsInPart(root, overlapParams)
    
    if #parts > 0 then
        local attempts = 0
        while #parts > 0 and attempts < 10 do
            if not root or not root.Parent then break end
            root.CFrame = root.CFrame + Vector3.new(0, 1, 0)
            parts = Workspace:GetPartsInPart(root, overlapParams)
            attempts = attempts + 1
            task.wait()
        end
    end
end

local function getGroundPosition(targetX, targetZ)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rayOrigin = Vector3.new(targetX, char.HumanoidRootPart.Position.Y + 100, targetZ)
    local rayDirection = Vector3.new(0, -5000, 0)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = false

    local raycastResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    
    if raycastResult then
        return Vector3.new(targetX, raycastResult.Position.Y, targetZ)
    else
        return nil
    end
end

-- Collision Group Check (Invisible Walls/Barriers)
local function checkPathCollision(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    
    local map = workspace:FindFirstChild("map")
    local rokyo = map and map:FindFirstChild("Rokyo")
    local colGroup = rokyo and rokyo:FindFirstChild("Collision Group")
    
    if colGroup then
        local origin = char.HumanoidRootPart.Position
        local direction = targetPos - origin
        
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = {colGroup}
        
        local result = workspace:Raycast(origin, direction, params)
        if result then return true end
    end
    return false
end

-- Detailed Heart Analysis (Grounding & Burial) to detect Anti-Cheat Bait
local function analyzeHeartPhysics(heartPart)
    local pos = heartPart.Position

    -- 1. Check if Buried (70% inside logic)
    -- If the center of the heart is inside a CanCollide part, it is deeply buried.
    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local partsInHeart = workspace:GetPartsInPart(heartPart, overlapParams)
    for _, p in ipairs(partsInHeart) do
        if p.CanCollide and p.Transparency < 1 then
             -- If we are colliding with a solid visible part, consider it buried/bait
            return "Buried", "Heart is inside " .. p.Name
        end
    end

    -- 2. Check if Grounded (Downward Raycast)
    -- Raycast 3.5 studs down.
    local rayOrigin = heartPart.Position
    local rayDir = Vector3.new(0, -3.5, 0) 
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    rayParams.IgnoreWater = false

    local result = workspace:Raycast(rayOrigin, rayDir, rayParams)

    if not result then
        -- Ray hit nothing. Potential Floating Heart.
        -- SAFETY: Check distance to account for StreamingEnabled or unloaded chunks.
        local char = LocalPlayer.Character
        local distFromPlayer = (char and char:FindFirstChild("HumanoidRootPart")) 
            and (char.HumanoidRootPart.Position - pos).Magnitude or 9999
        
        -- If we are relatively close (within 400 studs), the ground should have loaded.
        if distFromPlayer < 400 then
            return "Floating", "Floating Heart (No ground detected)"
        end
    end

    return "Valid", nil
end

local function findDevilHeart()
    updateStatus("Scanning for heart...")
    local map = workspace:FindFirstChild("map")
    local rokyos = map and map:FindFirstChild("Rokyo")
    if rokyos then
        for _, object in ipairs(rokyos:GetChildren()) do
            if object:IsA("MeshPart") and object.MeshId == MESH_ID_TARGET then
                if object:FindFirstChildOfClass("PointLight") then 
                    local pos = object.Position
                    
                    -- Hard Height Check (Anti-Cheat Bait is usually very low)
                    if pos.Y < AC_BAIT_Y_LIMIT then return "ACBait", pos, object end
                    
                    -- Physics Analysis (Floating/Buried)
                    local status, reason = analyzeHeartPhysics(object)
                    if status ~= "Valid" then
                        return status, pos, object -- Returns "Floating" or "Buried"
                    end

                    return "valid", pos, object
                end
            end
        end
    end
    return nil, nil, nil
end

local function sendWebhook(title, message, color)
    if webhookEnabled and webhookURL ~= "" and webhookURL:find("discord") then
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = message,
                ["color"] = color or 0x00ff00,
                ["timestamp"] = DateTime.now():ToIsoDate()
            }}
        }
        pcall(function()
            request({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end)
    end
end

local function serverHop()
    updateStatus("Preparing to hop...")
    local history = isfile(SERVER_LOG_FILE) and HttpService:JSONDecode(readfile(SERVER_LOG_FILE)) or {}
    
    history[game.JobId] = os.time()
    
    local expireMinutes = Fluent.Options.ServerLogExpiry and Fluent.Options.ServerLogExpiry.Value or 30
    local expireTime = expireMinutes * 60
    local currentTime = os.time()
    
    for id, timestamp in pairs(history) do
        if (currentTime - timestamp) > expireTime then
            history[id] = nil
        end
    end
    
    writefile(SERVER_LOG_FILE, HttpService:JSONEncode(history))

    updateStatus("Fetching server list...")
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)

    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and not history[server.id] and server.id ~= game.JobId then
                updateStatus("Teleporting to: " .. server.id)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
                return
            end
        end
    end
    updateStatus("No suitable servers found. Retrying...")
    task.wait(2)
    serverHop()
end

-- [[ MOVEMENT ENGINE ]]

local function collectHeart(targetPart)
    if not targetPart then return end
    updateStatus("Collecting Heart...")
    
    -- Ensure user is exactly on the prompt to pass max distance checks
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = targetPart.CFrame
        task.wait(0.1)
    end

    -- Try to find prompt
    local prompt = targetPart:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then
        prompt = targetPart.Parent:FindFirstChildOfClass("ProximityPrompt")
    end

    if prompt and prompt.Enabled then
        local holdTime = prompt.HoldDuration or 0
        
        -- Logic: If we can instafire, try it. If not, manual hold.
        -- Note: Some anti-cheats flag instant fire on hold prompts.
        -- We perform the manual hold first for safety/legitimacy.
        
        if holdTime > 0 then
            prompt:InputHoldBegin()
            task.wait(holdTime + 0.1) -- Hold slightly longer to ensure register
            prompt:InputHoldEnd()
        else
            prompt:InputHoldBegin()
            prompt:InputHoldEnd()
        end
        
        -- Fallback: standard fireproximityprompt if supported by executor and manual failed
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
        
        updateStatus("Heart collected.")
        Fluent:Notify({Title = "Success", Content = "Heart Collected!", Duration = 3})
    else
        updateStatus("No Prompt Found.")
    end
end

local function stopTween(finalPart)
    updateStatus("Stopping movement...")
    stopRequested = true
    for _, t in ipairs(activeTweens) do
        if t.PlaybackState == Enum.PlaybackState.Playing then t:Cancel() end
    end
    activeTweens = {}
    if velocityConnection then velocityConnection:Disconnect() velocityConnection = nil end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if rootPart then 
        rootPart.Anchored = false 
        rootPart.Velocity = Vector3.zero 
    end
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Landed) end
    
    -- If we arrived at a heart, collect it
    if finalPart then
        collectHeart(finalPart)
    end
    
    updateStatus("Movement stopped.")
end

local function performTweenSegment(targetPos)
    if stopRequested then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local distance = (rootPart.Position - targetPos).Magnitude
    local duration
    
    if Fluent.Options.UseSTPS.Value then
        local stps = tonumber(Fluent.Options.STPSValue.Value) or 30
        duration = distance / stps
    else
        local speed = tonumber(Fluent.Options.TweenSpeed.Value) or 0.5
        duration = (speed * distance) / 100
    end
    
    if duration <= 0 then duration = 0.1 end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle[Fluent.Options.TweenEasing.Value], Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    table.insert(activeTweens, tween)
    tween:Play()
    tween.Completed:Wait()
end

local function startStagedTween(targetPos, targetObject)
    updateStatus("Initiating Tween...")
    stopRequested = false
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not rootPart then return end

    local startPos = rootPart.Position
    Fluent:Notify({
        Title = "Tween Started",
        Content = string.format("Origin: %.0f, %.0f, %.0f\nTarget: %.0f, %.0f, %.0f", startPos.X, startPos.Y, startPos.Z, targetPos.X, targetPos.Y, targetPos.Z),
        Duration = 5
    })

    -- Anti-Fall logic
    velocityConnection = RunService.Stepped:Connect(function()
        if rootPart and rootPart.Parent and not rootPart.Anchored then
            rootPart.Velocity = Vector3.new(0, -0.01, 0)
            rootPart.RotVelocity = Vector3.zero
        end
    end)
    
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Physics) end

    local function moveToGoal(goalPos, label)
        while (rootPart.Position - goalPos).Magnitude > 1 and not stopRequested do
            updateStatus("Moving " .. label .. "...")
            local currentPos = rootPart.Position
            local dist = (currentPos - goalPos).Magnitude
            local stepDist = tonumber(Fluent.Options.TweenDist.Value)
            
            local nextStep
            if Fluent.Options.SegmentToggle.Value and dist > stepDist then
                nextStep = currentPos + (goalPos - currentPos).Unit * stepDist
            else
                nextStep = goalPos
            end
            
            if Fluent.Options.GroundFollow.Value then
                local groundPos = getGroundPosition(nextStep.X, nextStep.Z)
                if groundPos then
                    nextStep = Vector3.new(nextStep.X, groundPos.Y + ALIGNMENT_OFFSET, nextStep.Z)
                else
                    if nextStep.Y < MIN_Y_LIMIT then nextStep = Vector3.new(nextStep.X, MIN_Y_LIMIT, nextStep.Z) end
                end
            else
                if Fluent.Options.SplitToggle.Value then
                    if nextStep.Y < MIN_Y_LIMIT then nextStep = Vector3.new(nextStep.X, MIN_Y_LIMIT, nextStep.Z) end
                end
            end

            performTweenSegment(nextStep)
            unstuckCharacter()

            if not stopRequested and Fluent.Options.SegmentToggle.Value and (rootPart.Position - goalPos).Magnitude > 1 then 
                updateStatus("Segment Wait (" .. Fluent.Options.TweenInterval.Value .. "s)...")
                if not Fluent.Options.SegmentDrop.Value then
                    rootPart.Anchored = true
                    rootPart.Velocity = Vector3.zero
                end
                task.wait(Fluent.Options.TweenInterval.Value) 
                if not stopRequested and not Fluent.Options.SegmentDrop.Value then
                    rootPart.Anchored = false
                end
            end
        end
    end

    if Fluent.Options.SplitToggle.Value then
        local initialTargetY = math.max(rootPart.Position.Y, MIN_Y_LIMIT)
        if Fluent.Options.GroundFollow.Value then
            moveToGoal(Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z), "Horizontally (Ground)")
        else
            moveToGoal(Vector3.new(targetPos.X, initialTargetY, targetPos.Z), "Horizontally")
        end
        if not stopRequested then moveToGoal(targetPos, "Vertically/Final") end
    else
        moveToGoal(targetPos, "to Target")
    end
    
    updateStatus("Reached destination.")
    stopTween(targetObject) -- Pass object for collection
end

-- [[ CORE HOPPER LOOP ]]

local function runHopperLogic()
    if isHopperRunning then return end
    isHopperRunning = true
    updateStatus("Hopper Started.")
    
    task.spawn(function()
        while Fluent.Options.HopperToggle.Value do
            local status, heartPos, heartObj = findDevilHeart()
            
            -- INVENTORY CHECK
            local currentHearts = getHeartCount()
            local maxHeartsAllowed = Fluent.Options.MaxHeartLimit.Value
            local isMaxed = currentHearts >= maxHeartsAllowed

            if status == "valid" then
                if checkPathCollision(heartPos) then
                    updateStatus("Barrier Detected! Marking as Bait.")
                    sendWebhook("⚠️ Collision Bait Detected", "Tween blocked by invisible wall. Hopping.", 0xff9900)
                    serverHop()
                elseif isMaxed and not Fluent.Options.TweenOnMax.Value then
                    updateStatus("Max hearts reached. Hopping...")
                    sendWebhook("ℹ️ Heart Found (Skipped)", "Server " .. game.JobId .. " has a heart, but " .. LocalPlayer.Name .. " is already max on hearts.", 0x00aaff)
                    serverHop()
                else
                    updateStatus("Heart found! Stopping hopper.")
                    sendWebhook("✅ Valid Heart Found!", "Target in server: " .. game.JobId .. "\nStatus: Valid", 0x00ff00)
                    if Fluent.Options.AutoTweenOnFind.Value then
                        startStagedTween(heartPos, heartObj)
                    end
                    Fluent.Options.HopperToggle:SetValue(false)
                    break
                end

            elseif status == "Floating" then
                -- BAIT: Floating Heart
                updateStatus("Floating Heart (AC Bait) Detected!")
                sendWebhook("⚠️ AC Bait Detected", "Reason: Floating Heart (No Ground). Server: " .. game.JobId, 0xff0000)
                serverHop()

            elseif status == "Buried" then
                -- BAIT: Buried Heart
                updateStatus("Buried Heart (AC Bait) Detected!")
                sendWebhook("⚠️ AC Bait Detected", "Reason: Heart Buried inside Object. Server: " .. game.JobId, 0xff0000)
                serverHop()

            elseif status == "ACBait" then
                -- BAIT: Y-Level
                updateStatus("ACBait (Height) detected! Skipping...")
                sendWebhook("⚠️ AC Bait Detected", "Reason: Height (Y < 911). Server: " .. game.JobId, 0xff0000)
                serverHop()
                
            else
                updateStatus("No heart found.")
                serverHop()
            end
            
            updateStatus("Wait interval...")
            task.wait(10)
        end
        isHopperRunning = false
        updateStatus("Hopper Disabled.")
    end)
end

