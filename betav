-- Improved Stat Calculator (Updates Separate Labels)
local function updateHeartStats(heartPart)
    if not heartPart then 
        if DataFoundLabel then DataFoundLabel:SetTitle("Found: FALSE") end
        if DataFloatLabel then DataFloatLabel:SetTitle("Floating: N/A") end
        if DataCollideLabel then DataCollideLabel:SetTitle("Colliding: N/A") end
        if DataConfLabel then DataConfLabel:SetTitle("Confidence: 0%") end
        return 
    end
    
    -- Setup Params
    sharedOverlapParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    sharedRayParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    
    -- 1. Scan Collision
    local pList = workspace:GetPartsInPart(heartPart, sharedOverlapParams)
    local isColliding = false
    for _, p in ipairs(pList) do
        if p.CanCollide and p.Transparency < 1 then isColliding = true break end
    end

    -- 2. Scan Floating
    local rayOrigin = heartPart.Position
    local rayDir = Vector3.new(0, -15, 0) -- Check 15 studs down
    local groundHit = workspace:Raycast(rayOrigin, rayDir, sharedRayParams)
    local isFloating = (groundHit == nil)

    -- 3. Probability
    local chance = 100
    if isColliding then chance = chance - 40 end
    if isFloating then chance = chance - 50 end
    if heartPart.Position.Y < AC_BAIT_Y_LIMIT then chance = 0 end

    -- Update Labels
    if DataFoundLabel then DataFoundLabel:SetTitle("Found: TRUE") end
    if DataFloatLabel then DataFloatLabel:SetTitle("Floating: " .. tostring(isFloating)) end
    if DataCollideLabel then DataCollideLabel:SetTitle("Colliding: " .. tostring(isColliding)) end
    if DataConfLabel then DataConfLabel:SetTitle("Confidence: " .. chance .. "%") end
end

-- Physics Analysis
local function analyzeHeartPhysics(heartPart)
    local pos = heartPart.Position

    -- Optimization: Reuse shared params
    sharedOverlapParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    sharedRayParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}

    local success, status, reasoning = pcall(function()
        -- 1. Check Burial
        local partsInHeart = workspace:GetPartsInPart(heartPart, sharedOverlapParams)
        for _, p in ipairs(partsInHeart) do
            if p.CanCollide and p.Transparency < 1 then
                return "Buried", "Inside " .. p.Name
            end
        end

        -- 2. Check Floating
        -- Raycast down. If no hit within 20 studs, it's floating or weird geometry.
        local rayHit = workspace:Raycast(pos, Vector3.new(0, -20, 0), sharedRayParams)
        
        if not rayHit then
            return "Floating", "No ground detected (Void/Air)"
        else
            -- Check Distance specifically
            local distToGround = (pos - rayHit.Position).Magnitude
            if distToGround > 8 then -- If heart is floating 8+ studs in the air
                return "Floating", "Height > 8 studs"
            end
        end
        return "Valid", nil
    end)

    if not success then return "Valid", nil end 
    return status, reasoning
end

local function findDevilHeart()
    updateStatus("Scanning Map...")
    local map = workspace:FindFirstChild("map")
    local rokyos = map and map:FindFirstChild("Rokyo")
    
    if not map or not rokyos then return nil end

    local children = rokyos:GetChildren() 
    local batchSize = 100 
    
    for i, object in ipairs(children) do
        if i % batchSize == 0 then RunService.Heartbeat:Wait() end

        if object:IsA("MeshPart") and object.MeshId == MESH_ID_TARGET then
            if object:FindFirstChildOfClass("PointLight") then 
                local pos = object.Position
                currentHeartRef = object 
                
                if pos.Y < AC_BAIT_Y_LIMIT then 
                    return "ACBait", pos, object 
                end
                
                local status, reason = analyzeHeartPhysics(object)
                -- We do NOT update "Target Set" here anymore to prevent freezing logic
                return status, pos, object
            end
        end
    end
    
    currentHeartRef = nil
    return nil, nil, nil
end

local function getHeartCount()
    local count = 0
    local function scan(parent)
        for _, t in ipairs(parent:GetChildren()) do
            if t:IsA("Tool") and (t.Name:lower():find("heart") or t.Name:lower():find("devil")) then
                count = count + 1
            end
        end
    end
    
    if LocalPlayer:FindFirstChild("Backpack") then scan(LocalPlayer.Backpack) end
    if LocalPlayer.Character then scan(LocalPlayer.Character) end
    return count
end

local function getGroundPosition(targetX, targetZ)
    local char = LocalPlayer.Character
    if not char then return nil end
    
    sharedRayParams.FilterDescendantsInstances = {char}
    local rayOrigin = Vector3.new(targetX, char.HumanoidRootPart.Position.Y + 50, targetZ)
    local rayResult = Workspace:Raycast(rayOrigin, Vector3.new(0, -1000, 0), sharedRayParams)
    
    if rayResult then 
        return Vector3.new(targetX, rayResult.Position.Y, targetZ) 
    else 
        return nil 
    end
end

local function checkPathCollision(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    
    local map = workspace:FindFirstChild("map")
    local rokyo = map and map:FindFirstChild("Rokyo")
    local colGroup = rokyo and rokyo:FindFirstChild("Collision Group")
    
    if colGroup then
        local origin = char.HumanoidRootPart.Position
        local direction = targetPos - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = {colGroup}
        local result = workspace:Raycast(origin, direction, params)
        if result then return true end
    end
    return false
end

local function serverHop()
    cleanupMovement()
    restoreCamera()
    
    updateStatus("Hopping Server...")
    local JobId = game.JobId
    local PlaceId = game.PlaceId
    
    local history = isfile(SERVER_LOG_FILE) and HttpService:JSONDecode(readfile(SERVER_LOG_FILE)) or {}
    history[JobId] = os.time()
    
    local interval = Fluent.Options.ServerLogExpiry and Fluent.Options.ServerLogExpiry.Value or 30
    for id, time in pairs(history) do
        if (os.time() - time) > (interval * 60) then history[id] = nil end
    end
    writefile(SERVER_LOG_FILE, HttpService:JSONEncode(history))

    local function tryTeleport()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")).data
        for _, s in ipairs(servers) do
            if s.playing < s.maxPlayers and s.id ~= JobId and not history[s.id] then
                TeleportService:TeleportToPlaceInstance(PlaceId, s.id)
                return true
            end
        end
        return false
    end
    
    if not pcall(tryTeleport) then
        updateStatus("Hop Failed. Retrying...")
        task.wait(2)
        serverHop()
    end
end

