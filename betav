-- Stat Calculator for Debug
local function calculateHeartStats(heartPart)
    if not heartPart then return "Heart:❌ | No Data" end
    
    local data = {
        heart = "✅",
        floating = "❓",
        colliding = "❓",
        grounded = "❓",
        prob = 100
    }
    
    -- 1. Scan Collision (Buried)
    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    local parts = workspace:GetPartsInPart(heartPart, overlapParams)
    local isBuried = false
    for _, p in ipairs(parts) do
        if p.CanCollide and p.Transparency < 1 then isBuried = true break end
    end
    data.colliding = isBuried and "❌(Yes)" or "✅(No)"
    if isBuried then data.prob = data.prob - 40 end

    -- 2. Scan Ground (Floating)
    local rayOrigin = heartPart.Position
    local rayDir = Vector3.new(0, -5, 0)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
    local result = workspace:Raycast(rayOrigin, rayDir, rayParams)
    
    data.floating = (not result) and "❌(Yes)" or "✅(No)"
    data.grounded = result and "✅" or "❌"
    
    if not result then data.prob = data.prob - 50 end
    if heartPart.Position.Y < AC_BAIT_Y_LIMIT then data.prob = 0 end

    return string.format("Heart:%s\nFloat:%s | Collide:%s | Ground:%s\nBaited Probability: %d%%", 
        data.heart, data.floating, data.colliding, data.grounded, (100 - data.prob))
end

-- Detailed Heart Analysis (Grounding & Burial)
local function analyzeHeartPhysics(heartPart)
    local pos = heartPart.Position

    -- Optimization: Use pcall to prevent crashes on physics errors
    local success, result, failureReason = pcall(function()
        -- 1. Check if Buried
        local overlapParams = OverlapParams.new()
        overlapParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local partsInHeart = workspace:GetPartsInPart(heartPart, overlapParams)
        for _, p in ipairs(partsInHeart) do
            if p.CanCollide and p.Transparency < 1 then
                return "Buried", "Heart is inside " .. p.Name
            end
        end

        -- 2. Check if Grounded
        local rayOrigin = heartPart.Position
        local rayDir = Vector3.new(0, -3.5, 0)
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {heartPart, heartPart.Parent, LocalPlayer.Character}
        rayParams.IgnoreWater = false

        local rayHit = workspace:Raycast(rayOrigin, rayDir, rayParams)

        if not rayHit then
            local distFromPlayer = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) 
                and (LocalPlayer.Character.HumanoidRootPart.Position - pos).Magnitude or 9999
            
            if distFromPlayer < 400 then
                 return "Floating", "Floating Heart (No ground detected)"
            end
        end
        return "Valid", nil
    end)

    if not success then return "Valid", nil end -- Assume valid if physics check fails (fail-open)
    if result then return result, failureReason end

    return "Valid", nil
end

local function findDevilHeart()
    updateStatus("Scanning for heart...")
    local map = workspace:FindFirstChild("map")
    local rokyos = map and map:FindFirstChild("Rokyo")
    
    if rokyos then
        local children = rokyos:GetChildren() -- Snapshot children
        for i, object in ipairs(children) do
            -- Optimization: Only yield if processing many items to prevent hang
            if i % 100 == 0 then task.wait() end 

            if object:IsA("MeshPart") and object.MeshId == MESH_ID_TARGET then
                if object:FindFirstChildOfClass("PointLight") then 
                    local pos = object.Position
                    currentHeartRef = object -- Cache for Debug
                    
                    -- Hard Height Check
                    if pos.Y < AC_BAIT_Y_LIMIT then return "ACBait", pos, object end
                    
                    -- Physics Analysis
                    local status, reason = analyzeHeartPhysics(object)
                    if status ~= "Valid" then
                        return status, pos, object
                    end

                    return "valid", pos, object
                end
            end
        end
    end
    currentHeartRef = nil
    return nil, nil, nil
end

