        local rayOrigin = root.Position
        local rayDirection = Vector3.new(0, -100, 0)
        
        groundRayParams.FilterDescendantsInstances = {char}
        
        local res = workspace:Raycast(rayOrigin, rayDirection, groundRayParams)
        if res then
            local dist = math.floor((root.Position.Y - res.Position.Y) * 10) / 10
            HeightLabel:SetTitle("Height Offset: " .. tostring(dist) .. " studs")
        else
            HeightLabel:SetTitle("Height Offset: Void")
        end
    elseif HeightLabel then
         HeightLabel:SetTitle("Ground Offset: N/A")
    end
end)

