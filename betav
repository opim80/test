RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if SpeedLabel and root then
        local velocity = root.Velocity
        local sps = math.floor(velocity.Magnitude + 0.5)
        SpeedLabel:SetTitle("Studs Per Second: " .. tostring(sps))
    end
    
    -- Safety Camera Reset if heart despawns
    if viewingHeart and not currentHeartRef then
        restoreCamera() 
    end

    if HeightLabel and Fluent.Options.GroundFollow.Value and root then
        local rayOrigin = root.Position
        local rayDirection = Vector3.new(0, -100, 0)
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {char}
        params.FilterType = Enum.RaycastFilterType.Exclude
        
        local res = workspace:Raycast(rayOrigin, rayDirection, params)
        if res then
            local dist = math.floor((root.Position.Y - res.Position.Y) * 10) / 10
            HeightLabel:SetTitle("Height Offset: " .. tostring(dist) .. " studs")
        else
            HeightLabel:SetTitle("Height Offset: Void")
        end
    elseif HeightLabel then
         HeightLabel:SetTitle("Ground Offset: N/A")
    end
end)

