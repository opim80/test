local function unstuckCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {char}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude

    local parts = Workspace:GetPartsInPart(root, overlapParams)
    
    if #parts > 0 then
        root.CFrame = root.CFrame + Vector3.new(0, 1, 0)
    end
end

local function getGroundPosition(targetX, targetZ)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local rayOrigin = Vector3.new(targetX, char.HumanoidRootPart.Position.Y + 100, targetZ)
    local rayDirection = Vector3.new(0, -5000, 0)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    local raycastResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    if raycastResult then return Vector3.new(targetX, raycastResult.Position.Y, targetZ) else return nil end
end

local function checkPathCollision(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local map = workspace:FindFirstChild("map")
    local rokyo = map and map:FindFirstChild("Rokyo")
    local colGroup = rokyo and rokyo:FindFirstChild("Collision Group")
    if colGroup then
        local origin = char.HumanoidRootPart.Position
        local direction = targetPos - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = {colGroup}
        local result = workspace:Raycast(origin, direction, params)
        if result then return true end
    end
    return false
end

local function sendWebhook(title, message, color)
    if webhookEnabled and webhookURL ~= "" and webhookURL:find("discord.com/api/webhooks") then
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = message,
                ["color"] = color or 0x00ff00,
                ["timestamp"] = DateTime.now():ToIsoDate()
            }}
        }
        pcall(function()
            request({
                Url = webhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)
            })
        end)
    end
end

local function serverHop()
    cleanupMovement() -- Ensure we aren't moving while hopping
    restoreCamera()   -- Reset camera
    updateStatus("Preparing to hop...")
    
    local history = isfile(SERVER_LOG_FILE) and HttpService:JSONDecode(readfile(SERVER_LOG_FILE)) or {}
    history[game.JobId] = os.time()
    
    local expireMinutes = Fluent.Options.ServerLogExpiry and Fluent.Options.ServerLogExpiry.Value or 30
    local expireTime = expireMinutes * 60
    local currentTime = os.time()
    
    for id, timestamp in pairs(history) do
        if (currentTime - timestamp) > expireTime then history[id] = nil end
    end
    writefile(SERVER_LOG_FILE, HttpService:JSONEncode(history))

    updateStatus("Fetching server list...")
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)

    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and not history[server.id] and server.id ~= game.JobId then
                updateStatus("Teleporting to: " .. server.id)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
                return
            end
        end
    end
    updateStatus("No suitable servers found.")
end

