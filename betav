-- Check if character is inside an object and unstuck them
local function unstuckCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterDescendantsInstances = {char}
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude

    -- Check if we are inside something
    local parts = Workspace:GetPartsInPart(root, overlapParams)
    
    if #parts > 0 then
        updateStatus("Detected collision, adjusting...")
        local safe = false
        local attempts = 0
        while #parts > 0 and attempts < 20 do
            -- Nudge up
            root.CFrame = root.CFrame + Vector3.new(0, 2, 0)
            parts = Workspace:GetPartsInPart(root, overlapParams)
            attempts = attempts + 1
            task.wait()
        end
    end
end

-- Raycast to find ground level
local function getGroundPosition(targetX, targetZ)
    local rayOrigin = Vector3.new(targetX, LocalPlayer.Character.HumanoidRootPart.Position.Y + 100, targetZ)
    local rayDirection = Vector3.new(0, -1000, 0)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = false

    local raycastResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    
    if raycastResult then
        -- Return position 3 studs above found ground
        return Vector3.new(targetX, raycastResult.Position.Y + 3, targetZ)
    else
        return nil
    end
end

local function findDevilHeart()
    updateStatus("Scanning for heart...")
    local map = workspace:FindFirstChild("map")
    local rokyos = map and map:FindFirstChild("Rokyo")
    if rokyos then
        for _, object in ipairs(rokyos:GetChildren()) do
            if object:IsA("MeshPart") and object.MeshId == MESH_ID_TARGET then
                if object:FindFirstChildOfClass("PointLight") then 
                    local pos = object.Position
                    if pos.Y < AC_BAIT_Y_LIMIT then return "ACBait", pos end
                    return "valid", pos
                end
            end
        end
    end
    return nil, nil
end

local function sendWebhook(title, message, color)
    if webhookEnabled and webhookURL ~= "" and webhookURL:find("discord.com/api/webhooks") then
        updateStatus("Sending Webhook...")
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = message,
                ["color"] = color or 0x00ff00,
                ["timestamp"] = DateTime.now():ToIsoDate()
            }}
        }
        pcall(function()
            request({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end)
    end
end

local function serverHop()
    updateStatus("Preparing to hop...")
    local history = isfile(SERVER_LOG_FILE) and HttpService:JSONDecode(readfile(SERVER_LOG_FILE)) or {}
    history[game.JobId] = os.time()
    writefile(SERVER_LOG_FILE, HttpService:JSONEncode(history))

    updateStatus("Fetching server list...")
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)

    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and not history[server.id] and server.id ~= game.JobId then
                updateStatus("Teleporting to: " .. server.id)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id)
                return
            end
        end
    end
    updateStatus("No suitable servers found.")
end

-- [[ MOVEMENT ENGINE ]]

local function stopTween()
    updateStatus("Stopping movement...")
    stopRequested = true
    for _, t in ipairs(activeTweens) do
        if t.PlaybackState == Enum.PlaybackState.Playing then t:Cancel() end
    end
    activeTweens = {}
    if velocityConnection then velocityConnection:Disconnect() velocityConnection = nil end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if rootPart then 
        rootPart.Anchored = false 
        rootPart.Velocity = Vector3.zero 
    end
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Landed) end
    updateStatus("Movement stopped.")
end

local function performTweenSegment(targetPos)
    if stopRequested then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local distance = (rootPart.Position - targetPos).Magnitude
    local duration
    
    -- STPS Calculation Logic
    if Fluent.Options.UseSTPS.Value then
        local stps = tonumber(Fluent.Options.STPSValue.Value) or 30
        duration = distance / stps
    else
        local speed = tonumber(Fluent.Options.TweenSpeed.Value) or 0.5
        duration = (speed * distance) / 100
    end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle[Fluent.Options.TweenEasing.Value], Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    table.insert(activeTweens, tween)
    tween:Play()
    tween.Completed:Wait()
end

local function startStagedTween(targetPos)
    updateStatus("Initiating Tween...")
    stopRequested = false
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not rootPart then return end

    -- Keep player afloat unless we are pausing/anchoring
    velocityConnection = RunService.Stepped:Connect(function()
        if rootPart and rootPart.Parent and not rootPart.Anchored then
            rootPart.Velocity = Vector3.new(0, -0.01, 0)
            rootPart.RotVelocity = Vector3.zero
        end
    end)
    
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Physics) end

    local function moveToGoal(goalPos, label)
        while (rootPart.Position - goalPos).Magnitude > 1 and not stopRequested do
            updateStatus("Moving " .. label .. "...")
            local currentPos = rootPart.Position
            
            -- Calculate Next Segment Point
            local dist = (currentPos - goalPos).Magnitude
            local stepDist = tonumber(Fluent.Options.TweenDist.Value)
            
            local nextStep
            if Fluent.Options.SegmentToggle.Value and dist > stepDist then
                nextStep = currentPos + (goalPos - currentPos).Unit * stepDist
            else
                nextStep = goalPos
            end
            
            -- Ground Follow Logic
            if Fluent.Options.GroundFollow.Value then
                local groundPos = getGroundPosition(nextStep.X, nextStep.Z)
                if groundPos then
                    nextStep = groundPos
                else
                    -- Fallback: Enforce Min Y if no ground found (void)
                    if nextStep.Y < MIN_Y_LIMIT then nextStep = Vector3.new(nextStep.X, MIN_Y_LIMIT, nextStep.Z) end
                end
            else
                 -- Standard Y Limit Enforcement
                if nextStep.Y < MIN_Y_LIMIT then nextStep = Vector3.new(nextStep.X, MIN_Y_LIMIT, nextStep.Z) end
            end

            performTweenSegment(nextStep)
            
            -- Anti-Clip Check after movement
            unstuckCharacter()

            if not stopRequested and Fluent.Options.SegmentToggle.Value and (rootPart.Position - goalPos).Magnitude > 1 then 
                updateStatus("Segment Wait (" .. Fluent.Options.TweenInterval.Value .. "s)...")
                
                -- ANCHOR TO PREVENT FLOATING/DRIFTING
                rootPart.Anchored = true
                rootPart.Velocity = Vector3.zero
                task.wait(Fluent.Options.TweenInterval.Value) 
                if not stopRequested then
                    rootPart.Anchored = false
                end
            end
        end
    end

    if Fluent.Options.SplitToggle.Value then
        -- For split toggle, we usually keep height, but Ground Follow overrides this
        local initialTargetY = math.max(rootPart.Position.Y, MIN_Y_LIMIT)
        if Fluent.Options.GroundFollow.Value then
            -- If ground follow is on, XZ movement should still adhere to ground
            moveToGoal(Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z), "Horizontally (Ground)")
        else
            moveToGoal(Vector3.new(targetPos.X, initialTargetY, targetPos.Z), "Horizontally")
        end
        
        if not stopRequested then moveToGoal(targetPos, "Vertically/Final") end
    else
        moveToGoal(targetPos, "to Target")
    end
    
    updateStatus("Reached destination.")
    stopTween()
end

-- [[ CORE HOPPER LOOP ]]

local function runHopperLogic()
    if isHopperRunning then return end
    isHopperRunning = true
    updateStatus("Hopper Started.")
    
    task.spawn(function()
        while Fluent.Options.HopperToggle.Value do
            local status, heartPos = findDevilHeart()
            
            if status == "ACBait" then
                updateStatus("ACBait detected! Skipping...")
                sendWebhook("⚠️ ACBait Detected", "Ignoring heart at Y: " .. heartPos.Y, 0xff0000)
                serverHop()
            elseif status == "valid" then
                updateStatus("Heart found! Stopping hopper.")
                sendWebhook("✅ Valid Heart Found!", "Target in server: " .. game.JobId)
                if Fluent.Options.AutoTweenOnFind.Value then
                    startStagedTween(heartPos)
                end
                Fluent.Options.HopperToggle:SetValue(false)
                break
            else
                updateStatus("No heart found.")
                serverHop()
            end
            
            updateStatus("Wait interval...")
            task.wait(10)
        end
        isHopperRunning = false
        updateStatus("Hopper Disabled.")
    end)
end

