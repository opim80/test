local function toggleViewHeart()
    local _, _, heartObj = findDevilHeart()
    local cam = workspace.CurrentCamera
    
    if isViewingHeart then
        -- Turn off
        isViewingHeart = false
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            cam.CameraSubject = LocalPlayer.Character.Humanoid
        end
        Fluent:Notify({Title = "Debug", Content = "Camera reset.", Duration = 2})
    else
        -- Turn on
        if heartObj then
            isViewingHeart = true
            cam.CameraSubject = heartObj
            Fluent:Notify({Title = "Debug", Content = "Viewing Heart.", Duration = 2})
        else
            Fluent:Notify({Title = "Error", Content = "No Heart found to view.", Duration = 2})
        end
    end
end

local function toggleHighlightHeart()
    -- Clean up existing
    if currentHighlight then 
        currentHighlight:Destroy() 
        currentHighlight = nil 
    end

    local _, _, heartObj = findDevilHeart()
    if heartObj then
        local hl = Instance.new("Highlight")
        hl.FillTransparency = 1
        hl.OutlineTransparency = 0
        hl.OutlineColor = Color3.fromRGB(255, 50, 50)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = heartObj
        currentHighlight = hl
        Fluent:Notify({Title = "Debug", Content = "Heart Highlighted.", Duration = 2})
    else
        Fluent:Notify({Title = "Error", Content = "No Heart found to highlight.", Duration = 2})
    end
end

local function runDeepAnalysis()
    local _, pos, heartObj = findDevilHeart()
    
    if not heartObj then
        DebugStatsLabel:SetTitle("No Heart Found in Server.")
        return
    end
    
    local isBuried, isFloating, probability = analyzeHeartPhysics(heartObj)
    local isColliding = checkPathCollision(pos)
    
    if isColliding then probability = probability + 30 end

    local text = string.format(
        "Heart: ✅\nFloating: %s\nColliding: %s\nBuried: %s\n\nAC Bait Probability: %d%%",
        isFloating and "❌ (True)" or "✅ (False)",
        isColliding and "❌ (True)" or "✅ (False)",
        isBuried and "❌ (True)" or "✅ (False)",
        math.clamp(probability, 0, 100)
    )
    
    DebugStatsLabel:SetTitle(text)
end

