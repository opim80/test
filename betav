-- Cleanup Function (Prevents Memory Leaks)
local function cleanupMovement()
    -- Disconnect Step Event
    if velocityConnection then
        velocityConnection:Disconnect()
        velocityConnection = nil
    end
    
    -- Cancel and Clear Tweens (Iterate backwards for safe removal)
    for i = #activeTweens, 1, -1 do
        local t = activeTweens[i]
        if t then
            pcall(function() 
                if t.PlaybackState == Enum.PlaybackState.Playing then t:Cancel() end 
                t:Destroy() 
            end)
        end
        table.remove(activeTweens, i)
    end
    
    -- Reset Character Physics
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then 
            root.Anchored = false 
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end
        if hum then 
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Landed)
        end
    end
end

