-- [[ SINGLE INSTANCE & CLEANUP LOGIC ]]
-- This ensures that if you execute the script again, the old UI and loops are destroyed.
if getgenv().replacenamehere_Cleanup then
    pcall(function() getgenv().replacenamehere_Cleanup() end)
end

-- Wait for Game & Player to load completely
if not game:IsLoaded() then game.Loaded:Wait() end
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

repeat task.wait() until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

-- [[ STATE VARIABLES ]]
-- Define your script's toggles and variables here
local corpseFarmActive = false
local corpseFarmTask = nil

-- Store the cleanup function globally
getgenv().replacenamehere_Cleanup = function()
    -- 1. Stop all loops and tasks
    corpseFarmActive = false
    if corpseFarmTask then task.cancel(corpseFarmTask) end
    
    -- 2. Disconnect connections (RunService, etc.)
    -- if myConnection then myConnection:Disconnect() end
    
    -- 3. Destroy the UI
    if getgenv().replacenamehere_Window then 
        pcall(function() getgenv().replacenamehere_Window:Destroy() end) 
    end
end

-- [[ UI & CONFIG LIBRARIES ]]
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

-- [[ UI INITIALIZATION ]]
local Window = Fluent:CreateWindow({ 
    Title = "replacenamehere", 
    SubTitle = "Corpse Part Farm", 
    TabWidth = 140, 
    Size = UDim2.fromOffset(580, 460), 
    Acrylic = true, 
    Theme = "Dark" 
})
getgenv().replacenamehere_Window = Window

-- Mobile Dropdown Fix
task.spawn(function()
    local CoreGui = game:GetService("CoreGui")
    local function limitDropdownSize(obj)
        if obj:IsA("ScrollingFrame") and (obj.Name:lower():find("option") or (obj.Parent and obj.Parent.Name:lower():find("dropdown"))) then
            if not obj:FindFirstChild("MobileListFix") then
                local constraint = Instance.new("UISizeConstraint")
                constraint.Name = "MobileListFix"
                constraint.MaxSize = Vector2.new(math.huge, 110) 
                constraint.Parent = obj
            end
        end
    end
    for _, desc in ipairs(CoreGui:GetDescendants()) do limitDropdownSize(desc) end
    CoreGui.DescendantAdded:Connect(limitDropdownSize)
end)

-- [[ TABS ]]
local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "home" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- [[ MAIN TAB ELEMENTS ]]
Tabs.Main:AddSection("Farming")

local CorpseToggle = Tabs.Main:AddToggle("CorpseFarmToggle", {Title = "Corpse Part Farm", Default = false})
CorpseToggle:OnChanged(function(Value)
    corpseFarmActive = Value
    
    if corpseFarmActive then
        corpseFarmTask = task.spawn(function()
            while corpseFarmActive do
                -- Check for the folder (Handling both 'CorpseSpawns' and your typo 'CorpseSpans' just in case)
                local spawnsFolder = workspace:FindFirstChild("CorpseSpawns") or workspace:FindFirstChild("CorpseSpans")
                
                if spawnsFolder then
                    for _, spawnPart in ipairs(spawnsFolder:GetChildren()) do
                        if spawnPart:IsA("BasePart") and spawnPart.Name == "CorpseSpawn" then
                            
                            -- Get all parts physically overlapping/touching the CorpseSpawn part
                            local overlappingParts = workspace:GetPartsInPart(spawnPart)
                            
                            for _, part in ipairs(overlappingParts) do
                                -- Ensure we aren't detecting the spawn pad itself or our own character
                                if part ~= spawnPart and LocalPlayer.Character and not part:IsDescendantOf(LocalPlayer.Character) then
                                    
                                    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if rootPart then
                                        -- Teleport to the overlapping part to "farm" it
                                        rootPart.CFrame = part.CFrame
                                        
                                        -- Wait a brief moment to allow the game to register the touch/pickup
                                        task.wait(0.5) 
                                    end
                                end
                            end
                            
                        end
                    end
                end
                
                -- Wait before checking again to prevent crashing/lagging the game
                task.wait(0.5)
            end
        end)
    else
        if corpseFarmTask then 
            task.cancel(corpseFarmTask) 
            corpseFarmTask = nil 
        end
    end
end)

-- [[ CONFIG & SETTINGS LOGIC ]]
SaveManager:SetLibrary(Fluent) 
InterfaceManager:SetLibrary(Fluent) 
SaveManager:IgnoreThemeSettings() 
SaveManager:SetIgnoreIndexes({})

-- Folder name set to replacenamehere
SaveManager:SetFolder("replacenamehere") 

InterfaceManager:BuildInterfaceSection(Tabs.Settings) 
SaveManager:BuildConfigSection(Tabs.Settings)

-- Select the first tab and load configs
Window:SelectTab(1)
task.wait(1.5)
pcall(function() SaveManager:LoadAutoloadConfig() end)
